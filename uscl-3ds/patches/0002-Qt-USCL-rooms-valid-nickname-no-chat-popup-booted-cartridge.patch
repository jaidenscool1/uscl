From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 21:45:00 -0700
Subject: [PATCH] Qt: USCL rooms: valid nickname, no chat popup, booted card is
 inserted

Three fixes found running two copies in one room (Mario Kart 7 local race):
- the room only takes nicknames of 4-20 [ a-zA-Z0-9._-]; USCL_ROOM's name
  (a Steam name) is mapped onto that instead of being refused;
- a room joined through USCL_ROOM doesn't open the room/chat window over the
  game (the status bar still opens it);
- a .cci booted directly counts as the inserted cartridge when none is set, so
  Download Play finds the child partition (MK7's local rooms host through
  dlp:SRVR; without it the server advertises no child and clients filter it out).
---
--- a/src/citra_qt/citra_qt.cpp
+++ b/src/citra_qt/citra_qt.cpp
@@ -550,8 +550,15 @@
         const qsizetype at = spec.lastIndexOf(QLatin1Char('@'));
         const qsizetype colon = spec.lastIndexOf(QLatin1Char(':'));
         const auto member = Network::GetRoomMember().lock();
-        if (member && at > 0 && colon > at) {
-            member->Join(spec.left(at).toStdString(), Service::CFG::GetConsoleIdHash(system),
+        // the room takes 4-20 of [ a-zA-Z0-9._-] (room.cpp IsValidNickname); Steam names may not fit
+        std::string nickname;
+        for (const QChar c : spec.left(at).left(20))
+            nickname += c.unicode() < 128 && (c.isLetterOrNumber() || QStringLiteral(" ._-").contains(c))
+                            ? static_cast<char>(c.unicode())
+                            : '_';
+        nickname.resize(std::max<std::size_t>(nickname.size(), 4), '_');
+        if (member && at >= 0 && colon > at) {
+            member->Join(nickname, Service::CFG::GetConsoleIdHash(system),
                          spec.mid(at + 1, colon - at - 1).toStdString().c_str(),
                          static_cast<u16>(spec.mid(colon + 1).toUInt()), 0,
                          Service::CFG::GetConsoleMacAddress(system));
@@ -1394,6 +1401,10 @@
 
     if (!UISettings::values.inserted_cartridge.GetValue().empty()) {
         system.InsertCartridge(UISettings::values.inserted_cartridge.GetValue());
+    } else {
+        // USCL: a cartridge image booted directly is the card in the slot, so Download Play (MK7
+        // local rooms) finds its child partition; InsertCartridge ignores anything but NCSD
+        system.InsertCartridge(filename.toStdString());
     }
 
     const Core::System::ResultStatus result{
--- a/src/citra_qt/multiplayer/state.cpp
+++ b/src/citra_qt/multiplayer/state.cpp
@@ -2,6 +2,7 @@
 // Licensed under GPLv2 or any later version
 // Refer to the license.txt file included.
 
+#include <cstdlib>
 #include <QAction>
 #include <QApplication>
 #include <QIcon>
@@ -120,7 +121,9 @@
     if (state == Network::RoomMember::State::Joined ||
         state == Network::RoomMember::State::Moderator) {
 
-        OnOpenNetworkRoom();
+        // USCL: a room joined through USCL_ROOM stays out of the way (the status bar still opens it)
+        if (!std::getenv("USCL_ROOM"))
+            OnOpenNetworkRoom();
         status_icon->setPixmap(QIcon::fromTheme(QStringLiteral("connected")).pixmap(16));
         status_text->setText(tr("Connected"));
         leave_room->setEnabled(true);
