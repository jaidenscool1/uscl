+void Module::Interface::AttachToEventNotification(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    frd->notification_event = rp.PopObject<Kernel::Event>();
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push(ResultSuccess);
+    LOG_WARNING(Service_FRD, "(STUBBED) called");
+}
+
+void Module::Interface::SetNotificationMask(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 mask = rp.Pop<u32>();
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push(ResultSuccess);
+    LOG_WARNING(Service_FRD, "(STUBBED) called, mask={:08X}", mask);
+}
+
+namespace {
+// libctru GameAuthenticationData: what the NASC LOGIN hands the game
+struct GameAuthenticationData {
+    u32_le nasc_result;
+    u32_le http_status_code;
+    std::array<char, 0x20> server_address;
+    u16_le server_port;
+    std::array<u8, 6> padding;
+    std::array<char, 0x100> token;
+    u64_le server_time;
+};
+static_assert(sizeof(GameAuthenticationData) == 0x138);
+
+// NEX DateTime: year<<26 | month<<22 | day<<17 | hour<<12 | minute<<6 | second
+u64 NexTimeNow() {
+    const std::time_t now = std::time(nullptr);
+    const std::tm t = *std::gmtime(&now);
+    return (u64(t.tm_year + 1900) << 26) | (u64(t.tm_mon + 1) << 22) | (u64(t.tm_mday) << 17) |
+           (u64(t.tm_hour) << 12) | (u64(t.tm_min) << 6) | u64(t.tm_sec);
+}
+} // namespace
+
+void Module::Interface::RequestGameAuthentication(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 server_id = rp.Pop<u32>();
+    std::array<u32, 6> ingamesn; // 12 UTF-16 characters
+    rp.PopRaw(ingamesn);
+    const u32 sdk_major = rp.Pop<u32>();
+    const u32 sdk_minor = rp.Pop<u32>();
+    rp.PopPID();
+    const auto event = rp.PopObject<Kernel::Event>();
+
+    GameAuthenticationData data{};
+    data.http_status_code = 200;
+    data.server_time = NexTimeNow();
+    const char* nex = std::getenv("USCL_NEX");
+    const char* colon = nex ? std::strrchr(nex, ':') : nullptr;
+    if (colon && colon != nex && std::size_t(colon - nex) < data.server_address.size()) {
+        data.nasc_result = 1; // NASC_SUCCESS
+        std::memcpy(data.server_address.data(), nex, colon - nex);
+        data.server_port = static_cast<u16>(std::strtoul(colon + 1, nullptr, 10));
+        const char* token = std::getenv("USCL_NEX_TOKEN");
+        std::strncpy(data.token.data(), token ? token : "uscl", data.token.size() - 1);
+    } else {
+        data.nasc_result = 110; // NASC_SERVER_NO_LONGER_AVAILABLE: what Nintendo's servers say now
+    }
+    frd->game_auth_data.resize(sizeof(data));
+    std::memcpy(frd->game_auth_data.data(), &data, sizeof(data));
+    LOG_INFO(Service_FRD, "USCL: game auth server_id={:08X} sdk={:x}.{:x} -> nasc {} {}:{}", server_id,
+             sdk_major, sdk_minor, u32{data.nasc_result}, data.server_address.data(),
+             u16{data.server_port});
+    if (event)
+        event->Signal();
+
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push(ResultSuccess);
+}
+
+void Module::Interface::GetGameAuthenticationData(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    std::vector<u8> buffer = frd->game_auth_data;
+    buffer.resize(sizeof(GameAuthenticationData));
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push(ResultSuccess);
+    rb.PushStaticBuffer(std::move(buffer), 0);
+}
+
+void Module::Interface::GetMyPassword(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    const u32 size = rp.Pop<u32>();
+    // the NEX (Kerberos) password the game logs in with; our servers set the same one per player
+    const char* password = std::getenv("USCL_NEX_PASSWORD");
+    std::vector<u8> buffer(size);
+    if (password && size)
+        std::strncpy(reinterpret_cast<char*>(buffer.data()), password, size - 1);
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 2);
+    rb.Push(ResultSuccess);
+    rb.PushStaticBuffer(std::move(buffer), 0);
+}
+
+void Module::Interface::Logout(Kernel::HLERequestContext& ctx) {
+    IPC::RequestParser rp(ctx);
+    frd->logged_in = false;
+    IPC::RequestBuilder rb = rp.MakeBuilder(1, 0);
+    rb.Push(ResultSuccess);
+}
+
+Module::Module(Core::System& system) : system(system) {
+    // USCL_NEX_PID: this player's NEX principal id (GetMyFriendKey); Azahar leaves it 0 otherwise
+    if (const char* pid = std::getenv("USCL_NEX_PID"))
+        my_friend_key.friend_id = static_cast<u32>(std::strtoul(pid, nullptr, 0));
+};
 Module::~Module() = default;
 
