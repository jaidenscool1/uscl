From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 22:25:00 -0700
Subject: [PATCH] USCL: NEX password from USCL_NEX_PASSWORD (no account server)

For PretendoNetwork/mario-kart-7 at 1f00a0c (AGPL-3.0). A USCL host runs this
server for its friends only; every player's Azahar (uscl-3ds 0003) logs in with
the same USCL_NEX_PASSWORD, so the Pretendo account gRPC service is not needed.
Not run yet (needs Postgres; see ../README.md).
---
diff --git a/globals/password_from_pid.go b/globals/password_from_pid.go
index 0c905d4..47ab160 100644
--- a/globals/password_from_pid.go
+++ b/globals/password_from_pid.go
@@ -2,6 +2,7 @@ package globals
 
 import (
 	"context"
+	"os"
 
 	pb "github.com/PretendoNetwork/grpc-go/account"
 	"github.com/PretendoNetwork/nex-go/v2"
@@ -11,6 +12,12 @@ import (
 )
 
 func PasswordFromPID(pid types.PID) (string, uint32) {
+	// USCL: friends play on the host's own server; every player's Azahar logs in with this password
+	// (USCL_NEX_PASSWORD, set in both), so no Pretendo account server is needed
+	if password := os.Getenv("USCL_NEX_PASSWORD"); password != "" {
+		return password, 0
+	}
+
 	ctx := metadata.NewOutgoingContext(context.Background(), GRPCAccountCommonMetadata)
 
 	response, err := GRPCAccountClient.GetNEXPassword(ctx, &pb.GetNEXPasswordRequest{Pid: uint32(pid)})
