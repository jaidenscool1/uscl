+		"&&cod7-stun.us.demonware.net=127.0.0.1&&cod7-stun.eu.demonware.net=127.0.0.1"
+		"&&cod7-stun.jp.demonware.net=127.0.0.1&&cod7-stun.au.demonware.net=127.0.0.1&&stun.us.demonware.net=127.0.0.1";
+
+	struct game_preset
+	{
+		const char* label;
+		const char* bridge_preset; // uscl-bridge host <preset>
+		bool demonware;
+	};
+
+	constexpr game_preset presets[] = {
+		{QT_TRANSLATE_NOOP("uscl_dialog", "Any game that uses PSN (Minecraft, ...)"), "", false},
+		{QT_TRANSLATE_NOOP("uscl_dialog", "Call of Duty: Black Ops II"), "bo2", true},
+		{QT_TRANSLATE_NOOP("uscl_dialog", "Skate 3 (community server, run it yourself)"), "skate3", false},
+	};
+
+	// Copy the files of a template folder that don't exist yet in the destination.
+	void copy_missing(const QString& from, const QString& to)
+	{
+		QDirIterator it(from, QDir::Files, QDirIterator::Subdirectories);
+		while (it.hasNext())
+		{
+			const QString src = it.next();
+			const QString dst = to + "/" + QDir(from).relativeFilePath(src);
+			if (!QFileInfo::exists(dst))
+			{
+				QDir().mkpath(QFileInfo(dst).absolutePath());
+				QFile::copy(src, dst);
+			}
+		}
+	}
+}
