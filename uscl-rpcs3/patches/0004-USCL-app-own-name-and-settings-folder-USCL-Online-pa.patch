+QString uscl_dialog::service_name(service s)
+{
+	switch (s)
+	{
+	case rpcn: return tr("Online server (RPCN)");
+	case demonware: return tr("Call of Duty server (Demonware)");
+	case bridge: return tr("Steam connection");
+	default: return {};
+	}
+}
+
+QString uscl_dialog::tool_path(const QString& name)
+{
+#ifdef _WIN32
+	return QCoreApplication::applicationDirPath() + "/" + name + ".exe";
+#else
+	return QCoreApplication::applicationDirPath() + "/" + name;
+#endif
+}
+
+QString uscl_dialog::data_dir()
+{
+	return QString::fromStdString(fs::get_config_dir()) + "uscl";
+}
+
+QString uscl_dialog::template_dir()
+{
+	// Linux packages: usr/bin + usr/share/uscl. Windows: uscl-data next to the executable.
+	for (const QString& dir : {QCoreApplication::applicationDirPath() + "/../share/uscl", QCoreApplication::applicationDirPath() + "/uscl-data"})
+	{
+		if (QFileInfo(dir).isDir())
+			return dir;
+	}
+	return {};
+}
+
+void uscl_dialog::apply_online_settings()
+{
+	const QString name = m_name->text().trimmed();
+	if (!QRegularExpression("^[A-Za-z0-9_-]{3,16}$").match(name).hasMatch())
+	{
+		QMessageBox::warning(this, tr("Online name"), tr("Pick a name of 3 to 16 letters, digits, - or _."));
+		return;
+	}
+
+	// RPCS3 network settings: online through RPCN, Demonware names to our server
+	m_emu_settings->LoadSettings();
+	m_emu_settings->SetSetting(emu_settings_type::InternetStatus, "Connected");
+	m_emu_settings->SetSetting(emu_settings_type::PSNStatus, "RPCN");
+	m_emu_settings->SetSetting(emu_settings_type::BindAddress, "0.0.0.0");
+	m_emu_settings->SetSetting(emu_settings_type::IpSwapList, swap_list);
+	m_emu_settings->SaveSettings();
+
+	// RPCN account on the session's server (127.0.0.1 through the Steam connection); created on first login
+	g_cfg_rpcn.load();
+	g_cfg_rpcn.add_host("USCL", "127.0.0.1");
+	g_cfg_rpcn.set_host("127.0.0.1");
+	g_cfg_rpcn.set_npid(name.toStdString());
+	if (g_cfg_rpcn.get_password().empty())
+	{
+		g_cfg_rpcn.set_password(QString::number(QRandomGenerator::system()->generate64(), 36).toStdString());
+	}
+	g_cfg_rpcn.save();
+
+	uscl_log.success("Online settings applied for %s", name.toStdString());
+	QMessageBox::information(this, tr("USCL"), tr("This PC is set up. If a game is running, restart it so it uses the new settings."));
+}
+
+bool uscl_dialog::start(service s, const QString& program, const QStringList& args, const QString& work_dir, const QProcessEnvironment& env)
+{
+	service_state& st = m_services[s];
+	if (st.process && st.process->state() != QProcess::NotRunning)
+		return true;
+
+	if (!QFileInfo(program).isExecutable())
+	{
+		QMessageBox::critical(this, tr("USCL"), tr("%0 is missing:\n%1\nReinstall USCL.").arg(service_name(s), program));
+		return false;
+	}
+
+	QDir().mkpath(work_dir);
+	st.log.clear();
+	if (!st.process)
+	{
+		st.process = new QProcess(this);
+		st.process->setProcessChannelMode(QProcess::MergedChannels);
+		connect(st.process, &QProcess::readyRead, this, [this, s]()
+		{
+			const QString out = QString::fromUtf8(m_services[s].process->readAll());
+			m_services[s].log += out;
+			if (s != bridge)
+				return;
+			// "uscl-bridge: session 1097… (hosting); give friends this number or invite them from Steam"
+			const QRegularExpressionMatch m = QRegularExpression("session (\\d+) \\((hosting|joined)\\)").match(out);
+			if (m.hasMatch())
+			{
+				m_session_label->setText(m.captured(2) == "hosting"
+					? tr("Hosting session %0. Give friends this number or invite them from Steam.").arg(m.captured(1))
+					: tr("Joined session %0. Start the game and go online.").arg(m.captured(1)));
+			}
+		});
+		connect(st.process, &QProcess::stateChanged, this, &uscl_dialog::update_status);
+	}
+	st.process->setWorkingDirectory(work_dir);
+	st.process->setProcessEnvironment(env);
+	st.process->start(program, args);
+	uscl_log.notice("Started %s %s", program.toStdString(), args.join(' ').toStdString());
+	return true;
+}
+
+void uscl_dialog::host_session()
+{
+	const game_preset& p = presets[std::clamp(m_game->currentIndex(), 0, static_cast<int>(std::size(presets)) - 1)];
+	const QString data = data_dir();
+	if (const QString templates = template_dir(); !templates.isEmpty())
+	{
+		copy_missing(templates + "/rpcn", data + "/rpcn");
+		copy_missing(templates + "/dw", data + "/dw");
+	}
+
+	// RPCN needs a TLS certificate of its own; make one the first time this PC hosts
+	if (!QFileInfo::exists(data + "/rpcn/cert.pem"))
+	{
+		QProcess cert_gen;
+		cert_gen.setWorkingDirectory(data + "/rpcn");
+		cert_gen.start(tool_path("uscl-rpcn"), {"--cert-gen"});
+		if (!cert_gen.waitForFinished(30000) || !QFileInfo::exists(data + "/rpcn/cert.pem"))
+		{
+			uscl_log.error("Could not make the RPCN certificate: %s", cert_gen.readAll().toStdString());
+			QMessageBox::warning(this, tr("USCL"), tr("Could not set up the online server (certificate). See the RPCS3 log."));
+			return;
+		}
+	}
+
+	const QProcessEnvironment env = QProcessEnvironment::systemEnvironment();
+	QProcessEnvironment rpcn_env = env;
+	rpcn_env.insert("USCL_LOCAL", "1");
+	if (!start(rpcn, tool_path("uscl-rpcn"), {}, data + "/rpcn", rpcn_env))
+		return;
+
+	if (p.demonware)
+	{
+		QProcessEnvironment dw_env = env;
+		dw_env.insert("DW_ADDR", "127.0.0.1:3074");
+		dw_env.insert("DW_STUN_ADDR", "127.0.0.1:3074");
+		dw_env.insert("DW_STUN_ALT_ADDR", "127.0.0.1:3077");
+		dw_env.insert("DW_STUN_SELF_ADDR", "127.0.0.1:39001"); // the host is slot 1
+		dw_env.insert("RUST_LOG", "info");
+		if (!start(demonware, tool_path("dw-server"), {}, data + "/dw", dw_env))
+			return;
+	}
+
+	QStringList args{"host"};
+	if (*p.bridge_preset)
+		args << p.bridge_preset;
+	start(bridge, tool_path("uscl-bridge"), args, QCoreApplication::applicationDirPath(), env);
+	m_session_label->setText(tr("Starting the session..."));
+}
+
+void uscl_dialog::join_session()
+{
+	QStringList args{"join"};
+	const QString id = m_session->text().trimmed();
+	if (!id.isEmpty())
+	{
+		if (!QRegularExpression("^\\d+$").match(id).hasMatch())
+		{
+			QMessageBox::warning(this, tr("USCL"), tr("The session number is the long number the host sees."));
+			return;
+		}
+		args << id;
+	}
+	start(bridge, tool_path("uscl-bridge"), args, QCoreApplication::applicationDirPath(), QProcessEnvironment::systemEnvironment());
+	m_session_label->setText(id.isEmpty() ? tr("Waiting for a friend's session or Steam invite...") : tr("Joining..."));
+}
+
+void uscl_dialog::stop_all()
+{
+	for (service_state& st : m_services)
+	{
+		if (st.process && st.process->state() != QProcess::NotRunning)
+		{
+			st.process->terminate();
+			if (!st.process->waitForFinished(3000))
+				st.process->kill();
+		}
+	}
+	if (m_session_label)
+		m_session_label->setText(tr("Not in a session."));
+}
+
+void uscl_dialog::update_status()
+{
+	bool any = false;
+	for (service_state& st : m_services)
+	{
+		const bool running = st.process && st.process->state() != QProcess::NotRunning;
+		any |= running;
+		st.status->setText(running ? tr("running") : tr("stopped"));
+	}
+	m_host->setEnabled(!any);
+	m_join->setEnabled(!any);
+	m_stop->setEnabled(any);
+}
+
+void uscl_dialog::show_log(service s)
+{
+	QDialog* dlg = new QDialog(this);
+	dlg->setAttribute(Qt::WA_DeleteOnClose);
+	dlg->setWindowTitle(service_name(s));
+	QPlainTextEdit* text = new QPlainTextEdit(m_services[s].log.isEmpty() ? tr("(nothing yet)") : m_services[s].log);
+	text->setReadOnly(true);
+	QVBoxLayout* layout = new QVBoxLayout(dlg);
+	layout->addWidget(text);
+	dlg->resize(700, 400);
+	dlg->show();
+}
