+uscl_dialog::uscl_dialog(std::shared_ptr<emu_settings> emu_settings, QWidget* parent)
+	: QDialog(parent)
+	, m_emu_settings(std::move(emu_settings))
+{
+	setWindowTitle(tr("USCL Online"));
+	setObjectName("uscl_dialog");
+
+	QLabel* intro = new QLabel(tr("Play online with your Steam friends. One player hosts a session and the others join it. "
+		"USCL carries everything over Steam, so nobody needs to forward ports."));
+	intro->setWordWrap(true);
+
+	// 1. This PC
+	QGroupBox* setup_box = new QGroupBox(tr("1. Set up this PC (once)"));
+	// RPCN makes up an "RPCS3_..." name when there is none; ask for a real one instead
+	const QString npid = QString::fromStdString(g_cfg_rpcn.get_npid());
+	m_name = new QLineEdit(npid.startsWith("RPCS3_") ? QString() : npid);
+	m_name->setPlaceholderText(tr("3-16 letters, digits, - or _"));
+	QPushButton* apply = new QPushButton(tr("Save and set up"));
+	QFormLayout* setup_layout = new QFormLayout(setup_box);
+	setup_layout->addRow(tr("Online name:"), m_name);
+	setup_layout->addRow(apply);
+
+	// 2. Session
+	QGroupBox* session_box = new QGroupBox(tr("2. Play"));
+	m_game = new QComboBox();
+	for (const game_preset& p : presets)
+		m_game->addItem(tr(p.label));
+	m_host = new QPushButton(tr("Host a session"));
+	m_session = new QLineEdit();
+	m_session->setPlaceholderText(tr("Session number (leave empty to accept a friend's Steam invite)"));
+	m_join = new QPushButton(tr("Join a session"));
+	m_stop = new QPushButton(tr("Stop"));
+	m_session_label = new QLabel(tr("Not in a session."));
+	m_session_label->setWordWrap(true);
+	m_session_label->setMinimumHeight(m_session_label->fontMetrics().lineSpacing() * 2); // the dialog does not grow when the text wraps
+	m_session_label->setTextInteractionFlags(Qt::TextSelectableByMouse);
+	QFormLayout* session_layout = new QFormLayout(session_box);
+	session_layout->addRow(tr("Game:"), m_game);
+	session_layout->addRow(m_host);
+	session_layout->addRow(tr("Join:"), m_session);
+	session_layout->addRow(m_join);
+	session_layout->addRow(m_session_label);
+	session_layout->addRow(m_stop);
+
+	// Services
+	QGroupBox* services_box = new QGroupBox(tr("Services"));
+	QVBoxLayout* services_layout = new QVBoxLayout(services_box);
+	for (int i = 0; i < service_count; i++)
+	{
+		const service s = static_cast<service>(i);
+		m_services[i].status = new QLabel();
+		QPushButton* log_button = new QPushButton(tr("Log"));
+		connect(log_button, &QPushButton::clicked, this, [this, s]() { show_log(s); });
+		QHBoxLayout* row = new QHBoxLayout();
+		row->addWidget(new QLabel(service_name(s)));
+		row->addStretch();
+		row->addWidget(m_services[i].status);
+		row->addWidget(log_button);
+		services_layout->addLayout(row);
+	}
+
+	QVBoxLayout* layout = new QVBoxLayout(this);
+	layout->addWidget(intro);
+	layout->addWidget(setup_box);
+	layout->addWidget(session_box);
+	layout->addWidget(services_box);
+
+	connect(apply, &QPushButton::clicked, this, &uscl_dialog::apply_online_settings);
+	connect(m_host, &QPushButton::clicked, this, &uscl_dialog::host_session);
+	connect(m_join, &QPushButton::clicked, this, &uscl_dialog::join_session);
+	connect(m_stop, &QPushButton::clicked, this, &uscl_dialog::stop_all);
+
+	update_status();
+}
