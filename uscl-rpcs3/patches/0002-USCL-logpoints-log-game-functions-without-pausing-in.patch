From eb89636d5f89f483ec8786b793286404b2c0cec9 Mon Sep 17 00:00:00 2001
From: HempFiend <17104973+jaidenscool1@users.noreply.github.com>
Date: Fri, 23 Oct 2026 14:28:28 -0700
Subject: [PATCH 2/2] USCL logpoints: log game functions without pausing
 (interpreter)

USCL_LOGPOINTS=<file>, lines "PPU-<hash> <hex address> <name>". The first
call logs name, LR and r3-r5 and puts the original back; '*' names log
every call, '@rN' also logs the string rN points to. A breakpoint that
doesn't pause, for games with a hang watchdog (Black Ops II).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 rpcs3/Emu/Cell/PPUModule.cpp |  3 ++
 rpcs3/Emu/Cell/PPUThread.cpp | 88 ++++++++++++++++++++++++++++++++++++
 2 files changed, 91 insertions(+)

diff --git a/rpcs3/Emu/Cell/PPUModule.cpp b/rpcs3/Emu/Cell/PPUModule.cpp
index 22e8ff9..60d76e3 100644
--- a/rpcs3/Emu/Cell/PPUModule.cpp
+++ b/rpcs3/Emu/Cell/PPUModule.cpp
@@ -2505,6 +2505,9 @@ bool ppu_load_exec(const ppu_exec_object& elf, bool virtual_load, const std::str
 		}
 	}
 
+	extern std::string g_uscl_exec_hash;
+	g_uscl_exec_hash = hash;
+
 	if (applied.empty())
 	{
 		ppu_loader.warning("PPU executable hash: %s", hash);
diff --git a/rpcs3/Emu/Cell/PPUThread.cpp b/rpcs3/Emu/Cell/PPUThread.cpp
index 76793a3..4d61f99 100644
--- a/rpcs3/Emu/Cell/PPUThread.cpp
+++ b/rpcs3/Emu/Cell/PPUThread.cpp
@@ -1228,6 +1228,92 @@ static void ppu_break(ppu_thread& ppu, ppu_opcode_t, be_t<u32>* this_op, ppu_int
 	return ppu_cache(ppu.cia)(ppu, {*this_op}, this_op, ppu.state ? &ppu_ret : next_fn);
 }
 
+// USCL logpoints: USCL_LOGPOINTS=<file> with lines "PPU-<hash> <hex address> <name>". With the interpreter, the
+// first time the executable with that hash runs an address, log its name, LR and r3-r5, then carry on (a breakpoint
+// that doesn't pause, so games with a hang watchdog keep running). One-shot: the original is put back on the hit.
+// A name starting with '*' logs every call instead; ending in "@rN" (N = 3..10) also logs the string rN points to.
+std::string g_uscl_exec_hash;
+static shared_mutex s_logpoint_mutex;
+static std::unordered_map<u32, std::string> s_logpoints;
+
+static void ppu_logpoint(ppu_thread& ppu, ppu_opcode_t op, be_t<u32>* this_op, ppu_intrp_func* next_fn)
+{
+	const u32 addr = vm::get_addr(this_op);
+	std::string name;
+	{
+		std::lock_guard lock(s_logpoint_mutex);
+		if (auto it = s_logpoints.find(addr); it != s_logpoints.end())
+		{
+			name = it->second;
+			if (!name.starts_with('*'))
+			{
+				s_logpoints.erase(it);
+				write_to_ptr_unsafe<ppu_intrp_func_t>(ppu_ptr(addr), ppu_cache(addr));
+			}
+		}
+	}
+
+	if (!name.empty())
+	{
+		std::string text;
+		if (const usz at = name.rfind("@r"); at != umax)
+		{
+			const u32 reg = std::stoul(name.substr(at + 2));
+			const u32 ptr = static_cast<u32>(ppu.gpr[reg < 32 ? reg : 3]);
+			for (u32 i = 0; i < 256 && vm::check_addr(ptr + i); i++)
+			{
+				const char c = *vm::get_super_ptr<char>(ptr + i);
+				if (!c) break;
+				text += c;
+			}
+		}
+
+		ppu_log.success("USCL logpoint 0x%08x %s lr=0x%08x r3=0x%x r4=0x%x r5=0x%x \"%s\" (%s)", addr, name, ppu.lr, ppu.gpr[3], ppu.gpr[4], ppu.gpr[5], text, ppu.get_name());
+	}
+
+	return ppu_cache(addr)(ppu, op, this_op, next_fn);
+}
+
+static void ppu_install_logpoints()
+{
+	const char* path = std::getenv("USCL_LOGPOINTS");
+	if (!path || g_cfg.core.ppu_decoder == ppu_decoder_type::llvm)
+	{
+		if (path) ppu_log.error("USCL_LOGPOINTS needs the PPU interpreter");
+		return;
+	}
+
+	const fs::file f(path);
+	if (!f)
+	{
+		ppu_log.error("USCL_LOGPOINTS: can't read %s", path);
+		return;
+	}
+
+	std::lock_guard lock(s_logpoint_mutex);
+	u32 count = 0;
+	for (const auto& line : fmt::split(f.to_string(), {"\n"}))
+	{
+		const auto parts = fmt::split(line, {" "});
+		if (parts.size() < 3 || parts[0] != g_uscl_exec_hash)
+		{
+			continue;
+		}
+
+		const u32 addr = static_cast<u32>(std::stoul(parts[1], nullptr, 16));
+		if (addr % 4 || !vm::check_addr(addr, vm::page_executable))
+		{
+			continue;
+		}
+
+		s_logpoints[addr] = parts[2];
+		write_to_ptr_unsafe<ppu_intrp_func_t>(ppu_ptr(addr), &ppu_logpoint);
+		count++;
+	}
+
+	ppu_log.success("USCL: %u logpoints for %s", count, g_uscl_exec_hash);
+}
+
 // Set or remove breakpoint
 extern bool ppu_breakpoint(u32 addr, bool is_adding)
 {
@@ -4886,6 +4972,8 @@ extern void ppu_initialize()
 
 		ppu_initialize(*ptr);
 	}
+
+	ppu_install_logpoints();
 }
 
 template <u32 (*Estimate)(u32, bool)>
