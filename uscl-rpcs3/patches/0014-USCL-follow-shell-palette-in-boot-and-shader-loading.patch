diff --git a/rpcs3/Emu/RSX/Overlays/uscl_loading_theme.h b/rpcs3/Emu/RSX/Overlays/uscl_loading_theme.h
new file mode 100644
index 000000000..4b62e9438
--- /dev/null
+++ b/rpcs3/Emu/RSX/Overlays/uscl_loading_theme.h
@@ -0,0 +1,44 @@
+#pragma once
+
+// USCL loading-only palette. GPL-2.0, like the RPCS3 code this accompanies.
+#include <array>
+#include <cstdlib>
+#include <optional>
+#include <string_view>
+
+namespace uscl
+{
+	using loading_palette = std::array<std::array<float, 3>, 3>;
+
+	inline std::optional<loading_palette> parse_loading_palette(std::string_view colors)
+	{
+		// Exactly three six-digit RGB values; invalid input leaves upstream rendering untouched.
+		if (colors.size() != 20 || colors[6] != ',' || colors[13] != ',') return {};
+		loading_palette result{};
+		for (unsigned color = 0; color < 3; color++)
+		{
+			for (unsigned channel = 0; channel < 3; channel++)
+			{
+				unsigned value = 0;
+				for (unsigned digit = 0; digit < 2; digit++)
+				{
+					const char c = colors[color * 7 + channel * 2 + digit];
+					const int n = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 :
+					    c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+					if (n < 0) return {};
+					value = value * 16 + static_cast<unsigned>(n);
+				}
+				result[color][channel] = value / 255.f;
+			}
+		}
+		return result;
+	}
+
+	inline std::optional<loading_palette> loading_colors()
+	{
+		const char* shell = std::getenv("USCL_SHELL");
+		const char* colors = std::getenv("USCL_LOADING_COLORS");
+		if (!shell || std::string_view(shell) != "1" || !colors) return {};
+		return parse_loading_palette(colors);
+	}
+}
