From ef2520dee8cee77f32e7c9a7481d9394bfa50b89 Mon Sep 17 00:00:00 2001
From: HempFiend <17104973+jaidenscool1@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:32:00 -0700
Subject: [PATCH 3/4] USCL: GDB server survives a client leaving; '!' logpoints
 dump game memory

A closed connection or 'D' (detach) ended in a fatal error that froze
emulation; now the session ends and emulation resumes. A logpoint named
'!...' writes all mapped game memory to $USCL_MEMDUMP_DIR when hit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 rpcs3/Emu/Cell/PPUThread.cpp | 29 +++++++++++++++++++++++++++++
 rpcs3/Emu/GDB.cpp            | 27 +++++++++++++++++++++++++++
 2 files changed, 56 insertions(+)

diff --git a/rpcs3/Emu/Cell/PPUThread.cpp b/rpcs3/Emu/Cell/PPUThread.cpp
index 4d61f99..92e487b 100644
--- a/rpcs3/Emu/Cell/PPUThread.cpp
+++ b/rpcs3/Emu/Cell/PPUThread.cpp
@@ -1232,6 +1232,7 @@ static void ppu_break(ppu_thread& ppu, ppu_opcode_t, be_t<u32>* this_op, ppu_int
 // first time the executable with that hash runs an address, log its name, LR and r3-r5, then carry on (a breakpoint
 // that doesn't pause, so games with a hang watchdog keep running). One-shot: the original is put back on the hit.
 // A name starting with '*' logs every call instead; ending in "@rN" (N = 3..10) also logs the string rN points to.
+// A name starting with '!' also writes all mapped game memory to $USCL_MEMDUMP_DIR (one file per mapped range).
 std::string g_uscl_exec_hash;
 static shared_mutex s_logpoint_mutex;
 static std::unordered_map<u32, std::string> s_logpoints;
@@ -1269,6 +1270,34 @@ static void ppu_logpoint(ppu_thread& ppu, ppu_opcode_t op, be_t<u32>* this_op, p
 		}
 
 		ppu_log.success("USCL logpoint 0x%08x %s lr=0x%08x r3=0x%x r4=0x%x r5=0x%x \"%s\" (%s)", addr, name, ppu.lr, ppu.gpr[3], ppu.gpr[4], ppu.gpr[5], text, ppu.get_name());
+
+		if (const char* dir = std::getenv("USCL_MEMDUMP_DIR"); dir && name.starts_with('!'))
+		{
+			// 64 KiB steps over the 32-bit space; consecutive mapped steps go into one file named by start address
+			u32 start = 0, count = 0;
+			const auto flush = [&]()
+			{
+				if (count)
+				{
+					fs::write_file(fmt::format("%s/%08x.bin", dir, start), fs::rewrite, vm::get_super_ptr<u8>(start), count * 0x10000ull);
+				}
+				count = 0;
+			};
+			for (u64 a = 0x10000; a < 0x1'0000'0000; a += 0x10000)
+			{
+				if (vm::check_addr(static_cast<u32>(a)) && vm::check_addr(static_cast<u32>(a + 0xffff)))
+				{
+					if (!count) start = static_cast<u32>(a);
+					count++;
+				}
+				else
+				{
+					flush();
+				}
+			}
+			flush();
+			ppu_log.success("USCL: memory dumped to %s", dir);
+		}
 	}
 
 	return ppu_cache(addr)(ppu, op, this_op, next_fn);
diff --git a/rpcs3/Emu/GDB.cpp b/rpcs3/Emu/GDB.cpp
index afb7800..833ee73 100644
--- a/rpcs3/Emu/GDB.cpp
+++ b/rpcs3/Emu/GDB.cpp
@@ -320,6 +320,19 @@ bool gdb_thread::read_cmd(gdb_cmd& out_cmd)
 {
 	while (true)
 	{
+		// USCL: a closed connection ends the session. Reading on into it was a fatal error that froze emulation.
+		char c;
+		int r;
+		while ((r = recv(client_socket, &c, 1, MSG_PEEK)) == -1 && check_errno_again() && thread_ctrl::state() != thread_state::aborting)
+		{
+			thread_ctrl::wait_for(5000);
+		}
+		if (r <= 0)
+		{
+			GDB.notice("Client closed the connection.");
+			return false;
+		}
+
 		if (try_read_cmd(out_cmd))
 		{
 			ack(true);
@@ -1028,6 +1041,11 @@ void gdb_thread::operator()()
 					break;
 				}
 				GDB.trace("Command %s with data %s received.", cmd.cmd, cmd.data);
+				if (cmd.cmd == "D")
+				{
+					send_cmd_ack("OK");
+					break;
+				}
 				PROCESS_CMD("!", cmd_extended_mode);
 				PROCESS_CMD("?", cmd_reason);
 				PROCESS_CMD("qSupported", cmd_supported);
@@ -1053,6 +1071,15 @@ void gdb_thread::operator()()
 					break;
 				}
 			}
+
+			// USCL: end of session (detach or disconnect): let the game run again and wait for the next client
+			closesocket(client_socket);
+			client_socket = -1;
+			if (Emu.IsPaused())
+			{
+				Emu.Resume();
+			}
+			GDB.success("Client disconnected, emulation resumed.");
 		}
 	}
 }
