From aebd5139c94fcf9ac0df8b601c0d17024f2f2ea8 Mon Sep 17 00:00:00 2001
From: HempFiend <17104973+jaidenscool1@users.noreply.github.com>
Date: Thu, 22 Oct 2026 13:07:15 -0700
Subject: [PATCH 1/5] USCL: send CELL_SYSUTIL_NP_INVITATION_SELECTED after
 sceNpBasicRecvMessageCustom picks an invite (Skate 3 waits for it)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 rpcs3/Emu/Cell/Modules/sceNp.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/rpcs3/Emu/Cell/Modules/sceNp.cpp b/rpcs3/Emu/Cell/Modules/sceNp.cpp
index a13e49f..d6760df 100644
--- a/rpcs3/Emu/Cell/Modules/sceNp.cpp
+++ b/rpcs3/Emu/Cell/Modules/sceNp.cpp
@@ -1693,7 +1693,9 @@ error_code recv_message_gui(ppu_thread& ppu, u16 mainType, u32 recvOptions)
 	nph.set_message_selected(data.id, chosen_msg_id);
 
 	// Is this sent if used from home menu but not from sceNpBasicRecvMessageCustom, not sure
-	// sysutil_send_system_cmd(CELL_SYSUTIL_NP_INVITATION_SELECTED, 0);
+	// USCL test: Skate 3 accepts invites through sceNpBasicRecvMessageCustom and waits for this before fading in
+	if (mainType == SCE_NP_BASIC_MESSAGE_MAIN_TYPE_INVITE)
+		sysutil_send_system_cmd(CELL_SYSUTIL_NP_INVITATION_SELECTED, 0);
 
 	nph.queue_basic_event(to_add);
 	nph.send_basic_event(event_to_send, 0, 0);
-- 
