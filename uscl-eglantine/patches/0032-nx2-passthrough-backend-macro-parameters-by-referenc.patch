+    x.prefix.insert(x.prefix.end(),
+                    {Hdr(0, NVC56F_SEM_ADDR_LO, 5), static_cast<NvU32>(address), static_cast<NvU32>(address >> 32), value, 0,
+                     static_cast<NvU32>(circular ? DRF_DEF(C56F, _SEM_EXECUTE, _OPERATION, _ACQ_CIRC_GEQ)
+                              : DRF_DEF(C56F, _SEM_EXECUTE, _OPERATION, _ACQ_STRICT_GEQ))});
+    ++s.counts[HwLate];
