+    if (!met && Nx2Passthrough::Sole() &&
+        (pending_acquire->operation == static_cast<u32>(GpuSemaphoreOperation::AcquireGequal) ||
+         pending_acquire->operation == static_cast<u32>(GpuSemaphoreOperation::AcquireCircularGequal)) &&
