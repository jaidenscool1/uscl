+
+    // --- Step 2: the guest VA space ---
+
+    /// Maps [va, va + size) to guest memory at `off` (bytes from the guest memory base), replacing what was there.
+    void Map(NvU64 va, NvU64 off, NvU64 size) {
+        Unmap(va, size);
+        MapOff(va, off, size);
+    }
+
+    /// Unmaps [va, va + size); the parts of overlapping mappings outside it stay mapped.
+    void Unmap(NvU64 va, NvU64 size) {
+        const NvU64 hi = va + size;
+        for (auto& [pva, p] : TakePieces(va, hi)) {
+            RmUnmap(pva, p.mem);
+            if (pva < va) MapPiece(pva, va - pva, p.off, p.kind);
+            if (pva + p.size > hi) MapPiece(hi, pva + p.size - hi, p.off + (hi - pva), p.kind);
+        }
+    }
+
+    /// The guest's kind over [va, va + size) changed: remember it, remap what is mapped there.
+    void SetKind(NvU64 va, NvU64 size, std::optional<NvU32> host_kind) {
+        AssignKind(va, va + size, host_kind);
+        ++kind_changes;
+        for (auto& [pva, p] : TakePieces(va, va + size)) {
+            RmUnmap(pva, p.mem);
+            MapOff(pva, p.off, p.size);
+        }
+    }
+
+    void SetGuestMemory(std::span<u8> guest) {
+        guest_base = guest.data();
+        guest_size = guest.size();
+        granules.assign((guest_size + GRANULE - 1) / GRANULE, 0);
+    }
+    const u8* GuestBase() const { return guest_base; }
+    NvU64 GuestSize() const { return guest_size; }
+
+    /// Copies `bytes` at guest VA `va` into the check buffer with the copy engine (part of the next Submit).
+    void QueueCheckCopy(std::vector<NvU32>& words, NvU64 va, NvU64 bytes) {
+        if (!copy_bound) {
+            words.insert(words.end(), {Hdr(4, 0, 1), AMPERE_DMA_COPY_B});
+            copy_bound = true;
+        }
+        const NvU64 dst = gva + CHECK;
+        words.insert(words.end(), {Hdr(4, NVC7B5_OFFSET_IN_UPPER, 4), static_cast<NvU32>(va >> 32),
+                                   static_cast<NvU32>(va), static_cast<NvU32>(dst >> 32), static_cast<NvU32>(dst),
+                                   Hdr(4, NVC7B5_LINE_LENGTH_IN, 2), static_cast<NvU32>(bytes), 1,
+                                   Hdr(4, NVC7B5_LAUNCH_DMA, 1),
+                                   DRF_DEF(C7B5, _LAUNCH_DMA, _DATA_TRANSFER_TYPE, _NON_PIPELINED) |
+                                       DRF_DEF(C7B5, _LAUNCH_DMA, _FLUSH_ENABLE, _TRUE) |
+                                       DRF_DEF(C7B5, _LAUNCH_DMA, _SRC_MEMORY_LAYOUT, _PITCH) |
+                                       DRF_DEF(C7B5, _LAUNCH_DMA, _DST_MEMORY_LAYOUT, _PITCH)});
+    }
+    const volatile NvU8* CheckBuffer() const { return cpu + CHECK; }
+
+    /// The kind the mirror mapped at va (~0u where nothing is mapped).
+    NvU32 MappedKind(NvU64 va) const {
+        auto it = pieces.upper_bound(va);
+        if (it == pieces.begin() || va >= std::prev(it)->first + std::prev(it)->second.size) return ~0u;
+        return std::prev(it)->second.kind;
+    }
+
+    /// The guest memory the mirror maps at va (nullptr where nothing is mapped): what the GPU should read.
+    const u8* MirroredHost(NvU64 va) const {
+        auto it = pieces.upper_bound(va);
+        if (it == pieces.begin()) return nullptr;
+        --it;
+        if (va >= it->first + it->second.size) return nullptr;
+        return guest_base + it->second.off + (va - it->first);
+    }
+
+    // Counters for the log.
+    NvU64 pinned = 0, rm_maps = 0, rm_unmaps = 0, kind_changes = 0, kind_fallbacks = 0;
+    std::chrono::nanoseconds import_time{};
+    size_t Pieces() const { return pieces.size(); }
+
 private:
+    struct Piece {
+        NvU64 size, off;
+        NvU32 kind;
+        NvHandle mem;
+    };
+    struct Run {
+        NvU64 end;
+        NvU32 kind;
+    };
+
+    /// Removes and returns the mappings that overlap [lo, hi).
+    std::vector<std::pair<NvU64, Piece>> TakePieces(NvU64 lo, NvU64 hi) {
+        std::vector<std::pair<NvU64, Piece>> out;
+        auto it = pieces.upper_bound(lo);
+        if (it != pieces.begin() && std::prev(it)->first + std::prev(it)->second.size > lo) --it;
+        while (it != pieces.end() && it->first < hi) {
+            out.emplace_back(*it);
+            it = pieces.erase(it);
+        }
+        return out;
+    }
+
+    /// Maps, split where a granule or the guest's kind changes.
+    void MapOff(NvU64 va, NvU64 off, NvU64 size) {
+        while (size != 0) {
+            const auto [kind, run_end] = KindAt(va);
+            const NvU64 n = std::min({size, (off / GRANULE + 1) * GRANULE - off, run_end - va});
+            MapPiece(va, n, off, kind);
+            va += n;
+            off += n;
+            size -= n;
+        }
+    }
+
+    void MapPiece(NvU64 va, NvU64 size, NvU64 off, NvU32 kind) {
+        static const bool pitch_only = [] {
+            const char* v = std::getenv("EDEN_NX2_PASSTHROUGH_KINDS"); // 0: map everything as pitch (bisecting)
+            return v != nullptr && v[0] == '0';
+        }();
+        if (pitch_only) kind = 0;
+        const NvHandle mem = Granule(off / GRANULE);
+        NVOS46_PARAMETERS p{};
+        p.hClient = root;
+        p.hDevice = device;
+        p.hDma = guest_va;
+        p.hMemory = mem;
+        p.offset = off % GRANULE;
+        p.length = size;
+        // Not cached in the GPU's L2: the guest CPU rewrites this memory all the time (rings reused every frame)
+        // and nothing invalidates the L2 on a CPU write (measured: cached, 6% of re-read pushbuffer entries stale).
+        p.flags = DRF_DEF(OS46, _FLAGS, _DMA_OFFSET_FIXED, _TRUE) | DRF_DEF(OS46, _FLAGS, _PAGE_SIZE, _4KB) |
+                  DRF_DEF(OS46, _FLAGS, _PAGE_KIND_OVERRIDE, _YES) | DRF_DEF(OS46, _FLAGS, _GPU_CACHEABLE, _NO);
+        p.kindOverride = kind;
+        p.dmaOffset = va;
+        Ioctl(ctl, NV_ESC_RM_MAP_MEMORY_DMA, &p, "map guest memory");
+        if (p.status == NV_ERR_NO_MEMORY) { // seen once per session in RM's page-table walk; a retry succeeds
+            p.dmaOffset = va;
+            Ioctl(ctl, NV_ESC_RM_MAP_MEMORY_DMA, &p, "map guest memory");
+        }
+        if (p.status != NV_OK && kind != 0) { // a kind the host does not take: pitch keeps the bytes reachable
+            if (++kind_fallbacks <= 8) {
+                LOG_WARNING(HW_GPU, "Nx2 passthrough: map [{:#x}, +{:#x}) kind {:#x} failed (status {:#x}), as pitch",
+                            va, size, kind, p.status);
+            }
+            kind = 0;
+            p.kindOverride = 0;
+            p.dmaOffset = va;
+            Ioctl(ctl, NV_ESC_RM_MAP_MEMORY_DMA, &p, "map guest memory");
+        }
+        if (p.status != NV_OK) throw Error("map guest memory", p.status);
+        pieces[va] = Piece{size, off, kind, mem};
+        ++rm_maps;
+    }
+
+    void RmUnmap(NvU64 va, NvHandle mem) {
+        NVOS47_PARAMETERS p{};
+        p.hClient = root;
+        p.hDevice = device;
+        p.hDma = guest_va;
+        p.hMemory = mem;
+        p.dmaOffset = va;
+        Ioctl(ctl, NV_ESC_RM_UNMAP_MEMORY_DMA, &p, "unmap guest memory");
+        if (p.status != NV_OK) throw Error("unmap guest memory", p.status);
+        ++rm_unmaps;
+    }
+
+    /// The OS descriptor over granule g of guest memory, imported (pinned) on first use.
+    NvHandle Granule(NvU64 g) {
+        if (granules.at(g) != 0) return granules[g];
+        const NvU64 size = std::min(GRANULE, guest_size - g * GRANULE);
+        const auto start = std::chrono::steady_clock::now();
+        nv_ioctl_nvos02_parameters_with_fd d{};
+        d.fd = -1;
+        d.params.hRoot = root;
+        d.params.hObjectParent = device;
+        d.params.hObjectNew = 0x72000000u + static_cast<NvU32>(g); // this escape takes the handle from the client
+        d.params.hClass = NV01_MEMORY_SYSTEM_OS_DESCRIPTOR;
+        d.params.flags = DRF_DEF(OS02, _FLAGS, _PHYSICALITY, _NONCONTIGUOUS) |
+                         DRF_DEF(OS02, _FLAGS, _COHERENCY, _CACHED) | DRF_DEF(OS02, _FLAGS, _MAPPING, _NO_MAP);
+        d.params.pMemory = reinterpret_cast<NvP64>(guest_base + g * GRANULE);
+        d.params.limit = size - 1;
