+void MemoryManager::PassthroughMap(GPUVAddr gpu_addr, DAddr dev_addr, std::size_t size) {
+    // The passthrough backend maps host memory: one call per run of device pages that is contiguous there.
+    auto& backing = system.DeviceMemory().buffer;
+    const std::span<u8> guest{backing.BackingBasePointer(), backing.BackingSize()};
+    constexpr u64 page = 1ULL << 12;
+    const u8* run = nullptr;
+    u64 run_start = 0;
+    for (u64 off = 0; off <= size; off += page) {
+        const u8* const p = off < size ? memory.GetPointer<u8>(dev_addr + off) : nullptr;
+        if (run != nullptr && p != run + (off - run_start)) {
+            Nx2Passthrough::OnMap(this, gpu_addr + run_start, run, off - run_start, guest);
+            run = nullptr;
+        }
+        if (run == nullptr && p != nullptr) {
+            run = p;
+            run_start = off;
+        }
+    }
+}
+
 GPUVAddr MemoryManager::MapSparse(GPUVAddr gpu_addr, std::size_t size, bool is_big_pages) {
     PreserveMapping(gpu_addr, size);
+    Nx2Passthrough::OnUnmap(this, gpu_addr, size); // the passthrough range is sparse: unmapped reads 0
     if (is_big_pages)
         return BigPageTableOp(gpu_addr, 0, size, PTEKind::INVALID, EntryType::Reserved);
     return PageTableOp(gpu_addr, 0, size, PTEKind::INVALID, EntryType::Reserved);
@@ -277,6 +303,7 @@ void MemoryManager::Unmap(GPUVAddr gpu_addr, std::size_t size) {
     if (size == 0) {
         return;
     }
+    Nx2Passthrough::OnUnmap(this, gpu_addr, size);
     PreserveMapping(gpu_addr, size);
     GetSubmappedRangeImpl<false>(gpu_addr, size, page_stash);
 
