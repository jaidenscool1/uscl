 #include "input_common/drivers/camera.h"
 #include "input_common/drivers/keyboard.h"
 #include "input_common/drivers/mouse.h"
@@ -99,8 +102,53 @@ struct InputSubsystem::Impl {
                                             std::make_shared<TouchFromButton>());
         Common::Input::RegisterInputFactory("analog_from_button",
                                             std::make_shared<StickFromButton>());
+#ifdef HAVE_SDL3
+        AutoMapPads();
+#endif
     }
 
+#ifdef HAVE_SDL3
+    // USCL: with USCL_AUTO_PADS set, every connected game controller (USB or Bluetooth) becomes
+    // players 1-8 in the order it was connected, mapped like Configure Input -> Input Device does
+    // (button layout per controller type, Joy-Con pairs, motion). No controller: settings stay.
+    void AutoMapPads() {
+        if (!std::getenv("USCL_AUTO_PADS")) {
+            return;
+        }
+        const auto pads = sdl->GetPadsInConnectionOrder();
+        if (pads.empty()) {
+            return;
+        }
+        auto& players = Settings::values.players.GetValue();
+        for (std::size_t i = 0; i < 8; ++i) {
+            auto& player = players[i];
+            if (i >= pads.size()) {
+                player.connected = false;
+                continue;
+            }
+            const auto& pad = pads[i];
+            player.connected = true;
+            player.controller_type = pad.Has("guid2") ? Settings::ControllerType::DualJoyconDetached
+                                                      : Settings::ControllerType::ProController;
+            player.profile_name.clear();
+            player.buttons.fill({});
+            player.analogs.fill({});
+            player.motions.fill({});
+            for (const auto& [id, param] : sdl->GetButtonMappingForDevice(pad)) {
+                player.buttons[id] = param.Serialize();
+            }
+            for (const auto& [id, param] : sdl->GetAnalogMappingForDevice(pad)) {
+                player.analogs[id] = param.Serialize();
+            }
+            for (const auto& [id, param] : sdl->GetMotionMappingForDevice(pad)) {
+                player.motions[id] = param.Serialize();
+            }
+            LOG_INFO(Input, "USCL: player {} = {}", i + 1, pad.Get("display", ""));
+        }
+        players[8].connected = false; // handheld: the players above are the controllers
+    }
+#endif
