+    /// Waits until every channel executed what it was given up to its last fence. False after 2 s.
+    bool Drain() {
+        const auto start = std::chrono::steady_clock::now();
+        for (auto& [guest, c] : channels) {
+            Ring(c);
+            while (static_cast<s32>(*reinterpret_cast<volatile NvU32*>(c.cpu + SEM) - c.fence) < 0) {
+                if (std::chrono::steady_clock::now() - start > WAIT_LIMIT) return false;
