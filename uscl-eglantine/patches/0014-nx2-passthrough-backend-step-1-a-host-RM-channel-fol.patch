+++ b/src/video_core/CMakeLists.txt
@@ -41,6 +41,8 @@ add_library(video_core STATIC
     dirty_flags.cpp
     dirty_flags.h
     dma_pusher.cpp
+    nx2_passthrough.cpp
+    nx2_passthrough.h
     dma_pusher.h
     engines/sw_blitter/blitter.cpp
     engines/sw_blitter/blitter.h
@@ -509,6 +511,15 @@ if (ENABLE_NSIGHT_AFTERMATH)
     target_include_directories(video_core PRIVATE "$ENV{NSIGHT_AFTERMATH_SDK}/include")
 endif()
 
+# EDEN_NX2_PASSTHROUGH_SDK=<NVIDIA open kernel module src dir, e.g. /usr/src/nvidia-615.78.08/src>: build the
+# passthrough backend (nx2_passthrough.cpp, Linux) against the driver's RM headers.
+set(EDEN_NX2_PASSTHROUGH_SDK "" CACHE PATH "NVIDIA open kernel module sources for the NX2 passthrough backend")
+if (EDEN_NX2_PASSTHROUGH_SDK AND LINUX)
+    set_source_files_properties(nx2_passthrough.cpp PROPERTIES
+        COMPILE_DEFINITIONS NX2_PASSTHROUGH
+        COMPILE_OPTIONS "-isystem;${EDEN_NX2_PASSTHROUGH_SDK}/common/sdk/nvidia/inc;-isystem;${EDEN_NX2_PASSTHROUGH_SDK}/nvidia/arch/nvalloc/unix/include;-isystem;${EDEN_NX2_PASSTHROUGH_SDK}/common/inc;-Wno-conversion")
+endif()
+
 if (MSVC)
     target_compile_options(video_core PRIVATE
         /we4242 # 'identifier': conversion from 'type1' to 'type2', possible loss of data
