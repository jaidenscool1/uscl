 #if defined(ARCHITECTURE_x86_64)
@@ -246,7 +255,12 @@ void ThreadManager::StartThread(VideoCore::RendererBase& renderer, Core::Fronten
                 }
             } else {
                 Profile::Scope scope{Profile::Zone::Idle};
+                const auto idle_start = std::chrono::steady_clock::now();
                 state.queue.PopWait(next, stop_token);
+                if (Tegra::Nx2Passthrough::Timing()) [[unlikely]] {
+                    Tegra::Nx2Passthrough::NoteTime(Tegra::Nx2Passthrough::Time::FrontIdle,
