+    const auto present_start = std::chrono::steady_clock::now();
+    SCOPE_EXIT {
+        if (Tegra::Nx2Passthrough::Timing()) [[unlikely]] {
+            Tegra::Nx2Passthrough::NoteTime(VideoCommon::GpuSplit::OnBackThread()
+                                                ? Tegra::Nx2Passthrough::Time::PresentBack
+                                                : Tegra::Nx2Passthrough::Time::PresentFront,
+                                            (std::chrono::steady_clock::now() - present_start).count());
+        }
+    };
     SCOPE_EXIT {
         render_window.OnFrameDisplayed();
     };
