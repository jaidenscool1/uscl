+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -3061,7 +3061,12 @@ std::optional<FramebufferTextureInfo> RasterizerVulkan::AccelerateDisplay(
     }
     if (Tegra::Nx2Passthrough::Sole()) [[unlikely]] {
         // The host GPU rendered the frame into guest memory: present it from there (Layer::UpdateRawImage).
