@@ -362,6 +363,15 @@ struct GPU::Impl {
                         }
                         free_swap_counters.push_back(current_request_counter);
                     }
+                    // Passthrough sole mode: the guest syncpoint moves on the front as it parses (SoleSyncpoint),
+                    // so the present would run there and stop the parsing that feeds the host GPU for its ~6 ms
+                    // (a CPU de-tile of the frame): the back, otherwise idle in sole mode, presents instead.
+                    if (Tegra::Nx2Passthrough::Sole() && VideoCommon::GpuSplit::OnGpuThread() &&
+                        VideoCommon::GpuSplit::Get().Active()) [[unlikely]] {
+                        Tegra::Nx2Passthrough::DeferToBack(
+                            [this, composite_layers] { renderer->Composite(composite_layers); });
+                        return;
+                    }
                     renderer->Composite(composite_layers);
                 };
                 for (size_t i = 0; i < num_fences; i++) {
