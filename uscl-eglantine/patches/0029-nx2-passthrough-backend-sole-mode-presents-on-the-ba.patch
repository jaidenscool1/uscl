diff --git a/src/video_core/nx2_passthrough.cpp b/src/video_core/nx2_passthrough.cpp
index 6076afc0f..9f8aad3d6 100644
--- a/src/video_core/nx2_passthrough.cpp
+++ b/src/video_core/nx2_passthrough.cpp
@@ -3829,6 +3829,25 @@ std::mutex& VulkanMutex() {
     return m;
 }
 
+std::mutex back_mutex;
+std::vector<std::function<void()>> back_queue; // (back_mutex) DeferToBack, handed over by OnEntryDone
+
+void DeferToBack(std::function<void()> f) {
+    std::scoped_lock lk{back_mutex};
+    back_queue.push_back(std::move(f));
+}
+
+/// Entry thread, no locks held: DeferToBack's functions to the back.
+void HandBack() {
+    std::vector<std::function<void()>> run;
+    {
+        std::scoped_lock lk{back_mutex};
+        if (back_queue.empty()) return;
+        run.swap(back_queue);
+    }
+    for (auto& f : run) VideoCommon::GpuSplit::Get().DeferFunction(std::move(f));
+}
+
 void SetGpuAstc(GpuAstc g) {
     gpu_astc_on = false;
     gpu_astc = std::move(g);
@@ -3841,6 +3860,7 @@ void OnEntryDone(s32 channel) {
     }
     SubmitEntry(channel, ~size_t{0}, true);
     DispatchGpuAstc();
+    HandBack();
 }
 
 void OnEntrySuspended(s32 channel, size_t words) {
@@ -3848,6 +3868,7 @@ void OnEntrySuspended(s32 channel, size_t words) {
         return;
     }
     SubmitEntry(channel, words, false);
+    HandBack();
 }
 
 void Shutdown() {
@@ -3907,6 +3928,9 @@ void AfterEntry(s32, std::function<void()> done) {
 void WaitHost() {}
 void SoleSyncpoint(Host1x::SyncpointManager&, u32, s32) {}
 void SetGpuAstc(GpuAstc) {}
+void DeferToBack(std::function<void()> f) {
+    f();
+}
 std::mutex& VulkanMutex() {
     static std::mutex m;
     return m;
@@ -3915,3 +3939,38 @@ std::mutex& VulkanMutex() {
 } // namespace Tegra::Nx2Passthrough
 
 #endif
+
+namespace Tegra::Nx2Passthrough {
+
+bool Timing() {
+    static const bool on = [] {
+        const char* v = std::getenv("EDEN_NX2_PASSTHROUGH_TIMES");
+        return v != nullptr && v[0] == '1';
+    }();
+    return on;
+}
+
+void NoteTime(Time what, u64 ns) {
+    static std::array<std::atomic<u64>, static_cast<size_t>(Time::Count)> sum{}, count{};
+    static std::atomic<s64> window{0};
+    sum[static_cast<size_t>(what)] += ns;
+    ++count[static_cast<size_t>(what)];
+    const s64 now = std::chrono::steady_clock::now().time_since_epoch().count();
+    s64 start = window.load();
+    if (start == 0) {
+        window.compare_exchange_strong(start, now);
+        return;
+    }
+    if (now - start < 5'000'000'000 || !window.compare_exchange_strong(start, now)) return;
+    static constexpr std::array<const char*, static_cast<size_t>(Time::Count)> names{
+        "front idle", "front acquire waits", "present on the front", "present on the back", "present's host wait"};
+    std::string line;
+    const double secs = double(now - start) / 1e9;
+    for (size_t i = 0; i < names.size(); ++i) {
+        line += fmt::format("{}{} {:.0f} ms/s ({:.0f}/s)", i ? ", " : "", names[i], double(sum[i].exchange(0)) / 1e6 / secs,
+                            double(count[i].exchange(0)) / secs);
+    }
+    LOG_INFO(HW_GPU, "Nx2 passthrough times: {}", line);
+}
+
+} // namespace Tegra::Nx2Passthrough
diff --git a/src/video_core/nx2_passthrough.h b/src/video_core/nx2_passthrough.h
index a541cac82..241b94643 100644
--- a/src/video_core/nx2_passthrough.h
+++ b/src/video_core/nx2_passthrough.h
@@ -112,6 +112,17 @@ void SetGpuAstc(GpuAstc gpu_astc);
 /// run on the GPU front: a guest syncpoint action, while the batches run on the back).
 std::mutex& VulkanMutex();
 
+/// Sole mode, GPU front: runs `f` on the split's back thread, handed over when the entry being parsed is done
+/// (callers may hold locks the back takes, such as the syncpoint manager's: a full ring would deadlock there).
+void DeferToBack(std::function<void()> f);
+
+/// EDEN_NX2_PASSTHROUGH_TIMES=1 (measuring): where time goes, summed over every thread that notes it and logged
+/// every 5 s: the GPU front idle (no commands from the game), waiting on acquires, presenting (on the front or the
+/// back), and the present's wait for the host GPU.
+enum class Time : u32 { FrontIdle, FrontAcquire, PresentFront, PresentBack, WaitHost, Count };
+bool Timing();
+void NoteTime(Time what, u64 ns);
+
 /// Frees the host channel and RM client (also done at process exit).
 void Shutdown();
 
