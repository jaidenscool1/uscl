+void TextureCacheRuntime::PollPassthroughTranscodes() {
+    if (passthrough_transcodes.empty()) {
+        return;
+    }
+    if (!scheduler.IsSubmitted(passthrough_transcodes.back().tick)) {
+        scheduler.Flush();
+    }
+    scheduler.GpuCaughtUp(); // refreshes the known GPU tick
+    while (!passthrough_transcodes.empty() && scheduler.IsFree(passthrough_transcodes.front().tick)) {
+        PassthroughTranscode& t = passthrough_transcodes.front();
+        t.done(t.output.mapped_span.first(t.size));
+        staging_buffer_pool.FreeDeferred(t.output);
+        passthrough_transcodes.pop_front();
+    }
