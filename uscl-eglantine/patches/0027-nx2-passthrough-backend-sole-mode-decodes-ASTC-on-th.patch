 void WaitHost();
 
+/// Sole mode: the Vulkan device, otherwise idle, transcodes ASTC textures for the backend (the CPU decoder
+/// finished ~20-50 large textures a second). `transcode(header, guest, bc3, done)`: the texture TIC `header`
+/// describes, its guest bytes `guest` (its own layout; `native_tiling`: the memory manager's), to BC1 (`bc3`
+/// false) or BC3 blocks, each level's layers in order, handed to `done` by a later `poll`. Both run on the thread
+/// that owns the Vulkan scheduler.
+struct GpuAstc {
+    std::function<void(const std::array<u32, 8>& header, std::span<const u8> guest, bool native_tiling, bool bc3,
+                       std::function<void(std::span<const u8>)> done)>
+        transcode;
+    std::function<void()> poll;
+};
+void SetGpuAstc(GpuAstc gpu_astc);
+/// Sole mode: held around the GpuAstc batches and the presenter's use of the Vulkan scheduler (a present can
+/// run on the GPU front: a guest syncpoint action, while the batches run on the back).
+std::mutex& VulkanMutex();
+
 /// Frees the host channel and RM client (also done at process exit).
 void Shutdown();
 
