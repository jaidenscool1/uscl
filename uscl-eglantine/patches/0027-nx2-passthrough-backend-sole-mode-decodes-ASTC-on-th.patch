+    void CheckGpu(const VideoCommon::ImageInfo& info, const AstcJob& job, VideoCommon::BufferImageCopy level0) {
+        using namespace VideoCommon;
+        Tegra::Texture::TICEntry tic{};
+        std::memcpy(&tic, job.header.data(), 32);
