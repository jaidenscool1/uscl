+/// Entry thread, outside the state lock (the scheduler's thread takes it, SoleSyncpoint, so a full split ring
+/// must not be waited on while holding it): finished blocks to the workers, checked jobs to the Vulkan device
+/// (EDEN_NX2_PASSTHROUGH_GPU_ASTC_MB of decode images at a time, 512 by default), and a poll for finished ones
+/// at most every millisecond.
+void DispatchGpuAstc() {
+    if (!gpu_astc_on.load(std::memory_order_relaxed)) return;
+    static const u64 budget = [] {
+        const char* v = std::getenv("EDEN_NX2_PASSTHROUGH_GPU_ASTC_MB");
+        return (v != nullptr ? std::strtoull(v, nullptr, 0) : 512ull) << 20;
+    }();
+    static std::chrono::steady_clock::time_point last_poll{};
+    std::vector<GpuBlocks> done;
+    {
+        std::scoped_lock lk{gpu_done_mutex};
+        done.swap(gpu_done);
+    }
+    State& s = Get();
+    std::vector<std::tuple<std::array<u32, 8>, std::vector<u8>, bool, u64>> jobs;
+    bool native = false;
+    {
+        std::scoped_lock lk{s.mutex};
+        if (!s.host) return;
+        native = s.host->NativeTiling();
+        if (!done.empty()) s.host->QueueBlocks(std::move(done));
+        for (auto& j : s.host->TakeGpuJobs(budget)) jobs.emplace_back(j.header, std::move(j.guest), j.bc3, j.decode_bytes);
+    }
+    const auto now = std::chrono::steady_clock::now();
+    if (jobs.empty() && (gpu_in_flight.load() == 0 || now - last_poll < std::chrono::milliseconds(1))) return;
+    last_poll = now;
+    auto run = [jobs = std::move(jobs), native] {
+        std::scoped_lock vk{VulkanMutex()};
+        for (const auto& [header, guest, bc3, bytes] : jobs) {
+            static const int check_n = [] {
+                const char* v = std::getenv("EDEN_NX2_PASSTHROUGH_GPU_ASTC_CHECK");
+                return v != nullptr ? std::atoi(v) : 0;
+            }();
+            static int checked = 0;
+            std::vector<u8> source = checked < check_n ? guest : std::vector<u8>{};
+            checked += !source.empty();
+            gpu_astc.transcode(header, guest, native, bc3, [header, bc3, bytes, source = std::move(source)](std::span<const u8> blocks) {
+                std::scoped_lock lk{gpu_done_mutex};
+                gpu_done.push_back({header, bc3, bytes, std::vector<u8>(blocks.begin(), blocks.end()), source});
+                gpu_in_flight -= bytes;
+            });
+        }
+        gpu_astc.poll();
+    };
+    auto& split = VideoCommon::GpuSplit::Get();
+    if (split.Active()) {
+        split.DeferFunction(std::move(run));
+    } else {
+        run();
+    }
+}
+
+std::mutex& VulkanMutex() {
+    static std::mutex m;
+    return m;
+}
