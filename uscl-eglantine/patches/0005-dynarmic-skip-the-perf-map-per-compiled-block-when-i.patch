From 937f8521cedf2b971ea0a7ddd380158f30343295 Mon Sep 17 00:00:00 2001
From: HempFiend <17104973+jaidenscool1@users.noreply.github.com>
Date: Sat, 14 Nov 2026 19:09:59 -0700
Subject: [PATCH 5/6] dynarmic: skip the perf map per compiled block when it is
 off

Without PERF_BUILDID_DIR every compiled block took a global lock, looked the
variable up again and formatted the block's name. All cores compile at once
while a game boots (Mario Kart World: ~500k blocks): 17.8 -> 16.8 us per block.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/dynarmic/src/dynarmic/backend/x64/emit_x64.cpp | 4 +++-
 src/dynarmic/src/dynarmic/backend/x64/perf_map.cpp | 8 +++++++-
 src/dynarmic/src/dynarmic/backend/x64/perf_map.h   | 3 +++
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/src/dynarmic/src/dynarmic/backend/x64/emit_x64.cpp b/src/dynarmic/src/dynarmic/backend/x64/emit_x64.cpp
index b0d43bda2..4752d0ac5 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/emit_x64.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/emit_x64.cpp
@@ -352,7 +352,9 @@ Xbyak::Label EmitX64::EmitCond(IR::Cond cond) {
 }
 
 EmitX64::BlockDescriptor EmitX64::RegisterBlock(const IR::LocationDescriptor& descriptor, CodePtr entrypoint, size_t size) {
-    PerfMapRegister(entrypoint, code.getCurr(), LocationDescriptorToFriendlyName(descriptor));
+    if (PerfMapEnabled()) {
+        PerfMapRegister(entrypoint, code.getCurr(), LocationDescriptorToFriendlyName(descriptor));
+    }
     Patch(descriptor, entrypoint);
 
     BlockDescriptor block_desc{entrypoint, size};
diff --git a/src/dynarmic/src/dynarmic/backend/x64/perf_map.cpp b/src/dynarmic/src/dynarmic/backend/x64/perf_map.cpp
index eaa6c9e2b..e43e24407 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/perf_map.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/perf_map.cpp
@@ -44,9 +44,15 @@ void OpenFile() {
 }
 }  // anonymous namespace
 
+bool PerfMapEnabled() {
+    static const bool enabled = std::getenv("PERF_BUILDID_DIR") != nullptr;
+    return enabled;
+}
+
 namespace detail {
 void PerfMapRegister(const void* start, const void* end, std::string_view friendly_name) {
-    if (start == end) {
+    // Off: no lock or environment lookup per compiled block (every core compiles at once on boot).
+    if (start == end || !PerfMapEnabled()) {
         // Nothing to register
         return;
     }
diff --git a/src/dynarmic/src/dynarmic/backend/x64/perf_map.h b/src/dynarmic/src/dynarmic/backend/x64/perf_map.h
index 2d7530a6b..d454f6e00 100644
--- a/src/dynarmic/src/dynarmic/backend/x64/perf_map.h
+++ b/src/dynarmic/src/dynarmic/backend/x64/perf_map.h
@@ -15,6 +15,8 @@
 namespace Dynarmic::Backend::X64 {
 
 #if defined(__linux__) && !defined(__ANDROID__)
+/// Whether PERF_BUILDID_DIR asked for a perf map (read once).
+bool PerfMapEnabled();
 namespace detail {
 void PerfMapRegister(const void* start, const void* end, std::string_view friendly_name);
 }  // namespace detail
@@ -25,6 +27,7 @@ void PerfMapRegister(T start, const void* end, std::string_view friendly_name) n
 void PerfMapClear();
 #else
 // Resolve to no-op (compiler thinks fmt has side effects)
+inline bool PerfMapEnabled() noexcept { return false; }
 template<typename T> inline void PerfMapRegister(T, const void*, std::string_view) noexcept {}
 inline void PerfMapClear() noexcept {}
 #endif
-- 
