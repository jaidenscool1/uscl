+    static void NoteWfiDone(Channel& c) {
+        while (!c.wfi_fences.empty() && static_cast<s32>(Passed(c) - c.wfi_fences.front()) >= 0) {
+            c.wfi_done = c.wfi_fences.front();
+            c.wfi_fences.pop_front();
