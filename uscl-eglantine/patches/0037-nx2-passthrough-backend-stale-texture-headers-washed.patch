+    /// Moves each channel's `flushed` past the L2 flushes the GPU ran. True when one moved.
+    bool UpdateFlushed() {
+        bool moved = false;
+        while (!l2_flushes.empty() && static_cast<s32>(Passed(*l2_flushes.front().c) - l2_flushes.front().fence) >= 0) {
+            for (const auto [ch, f] : l2_flushes.front().before) {
+                if (static_cast<s32>(f - ch->flushed) > 0) {
+                    ch->flushed = f;
+                    moved = true;
+                }
+            }
+            l2_flushes.pop_front();
+        }
+        return moved;
+    }
