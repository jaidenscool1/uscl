index 000000000..c443d339c
--- /dev/null
+++ b/src/video_core/nx2_helper_loads.h
@@ -0,0 +1,40 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eglantine Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <span>
+#include <string>
+#include <vector>
+
+#include "common/common_types.h"
+
+// Helper-lane loads for the GPU passthrough backend: on Ada, a pixel shader's helper lanes (coverage 0, run only
+// for derivatives) do not perform global loads, so LDG leaves its destination unchanged. Guest code such as
+// `LDG R5, [R5.U32+UR4]` then keeps the address as the loaded count (MKW: a light loop of ~10^9 iterations per
+// helper lane, 100+ ms draws, Xid 109). Each LDG of a pixel program is redirected to a trampoline that performs it
+// and zeroes the destination in helper lanes; helper status (SR_THREAD_KILL != 0) is computed once at the program
+// start into a predicate the program never uses. Port of USCL ptcap.py PT_HELPER_LOADS (SM86 words checked with
+// nvdisasm there). shortcut: helper lanes get 0, not a covered neighbour's value (derivatives of loaded values are
+// wrong on triangle edges); LDG only (no LD/LDS/ATOM). Upgrade when a game needs it.
+namespace Tegra::Nx2Passthrough::HelperLoads {
+
+struct Result {
+    /// The program from its SPH up to its end (rounded to 32 bytes), with each LDG replaced by a branch.
+    std::vector<u8> program;
+    /// Trampoline words appended to the caller's arena (at arena_va + arena_offset_before).
+    std::vector<u8> trampolines;
+    u32 loads = 0;
+    /// Why the program was left alone (empty when patched or when it has no loads).
+    std::string skipped;
+};
+
+/// The offset of a program's `EXIT; BRA self` pair (from the SPH), or 0 when not found within `image`.
+size_t ProgramEnd(std::span<const u8> image);
+
+/// Patches the pixel program at GPU VA `program` (`image` = its memory from the SPH on, at least to its end).
+/// Trampolines are laid out for GPU VA `trampoline_va`. `skipped` explains a program left alone; a program with
+/// no loads comes back unchanged.
+Result Patch(u64 program, std::span<const u8> image, u64 trampoline_va);
+
+} // namespace Tegra::Nx2Passthrough::HelperLoads
