diff --git a/src/video_core/nx2_helper_loads.cpp b/src/video_core/nx2_helper_loads.cpp
new file mode 100644
index 000000000..5bb538971
--- /dev/null
+++ b/src/video_core/nx2_helper_loads.cpp
@@ -0,0 +1,236 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eglantine Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+
+#include "video_core/nx2_helper_loads.h"
+
+namespace Tegra::Nx2Passthrough::HelperLoads {
+namespace {
+
+// One SM86 instruction: bits 0-63 in lo, 64-127 in hi; control (stall, yield, barriers, wait mask) at 105-127.
+struct Word {
+    u64 lo = 0, hi = 0;
+};
+constexpr u64 CTL_HI = ~((u64{1} << 41) - 1); // bits 105-127 of the instruction
+constexpr u32 SPH = 0x80;
+
+Word Load(std::span<const u8> b, size_t at) {
+    Word w;
+    std::memcpy(&w.lo, b.data() + at, 8);
+    std::memcpy(&w.hi, b.data() + at + 8, 8);
+    return w;
+}
+
+void Store(std::vector<u8>& b, size_t at, Word w) {
+    std::memcpy(b.data() + at, &w.lo, 8);
+    std::memcpy(b.data() + at + 8, &w.hi, 8);
+}
+
+void Append(std::vector<u8>& b, Word w) {
+    b.resize(b.size() + 16);
+    Store(b, b.size() - 16, w);
+}
+
+Word Ctl(Word x, u32 stall = 2, u32 yld = 0, u32 wr = 7, u32 rd = 7, u32 wait = 0) {
+    const u64 c = stall | yld << 4 | wr << 5 | rd << 8 | u64{wait} << 11;
+    return {x.lo, (x.hi & ~CTL_HI) | c << 41};
+}
+
+/// BRA to (this instruction + 16 + off).
+Word Bra(s64 off) {
+    const u64 o = static_cast<u64>(off) & ((u64{1} << 50) - 1);
+    return Ctl({0x7947 | 7 << 12 | (o & 0xFFFFFFFF) << 32, (o >> 32) | 0x03800000}, 5, 1);
+}
+
+/// S2R R<r>, SR_THREAD_KILL: nonzero in helper lanes (PIXLD.COVMASK's predicate is no helper test on Ada).
+Word S2rThreadKill(u32 r, u32 wr) {
+    return Ctl({0x7919 | u64{r} << 16, 0x13 << 8}, 1, 0, wr);
+}
+
+/// ISETP.NE.U32.AND P<p>, PT, R<r>, RZ, PT
+Word IsetpNeZero(u32 p, u32 r, u32 wait) {
+    return Ctl({0x720C | 7 << 12 | u64{r} << 24 | u64{0xFF} << 32, 0x0003F05070ULL | u64{p} << 17}, 5, 0, 7, 7, wait);
+}
+
+/// @P<p> MOV R<r>, RZ
+Word MovRzIf(u32 p, u32 r, u32 wait) {
+    return Ctl({0x0202 | u64{p} << 12 | u64{r} << 16 | u64{0xFF} << 32, 0xF00}, 2, 0, 7, 7, wait);
+}
+
+u32 Opcode(Word w) {
+    return static_cast<u32>(w.lo & 0xFFF);
+}
+
+/// LDG (generic address + uniform offset), as nvdisasm prints `LDG... R<d>, [R.U32+UR]`.
+bool IsLdg(Word w) {
+    return Opcode(w) == 0x981;
+}
+
+/// Registers an LDG writes: 1 (up to 32 bits), 2 (.64), 4 (.128).
+u32 LdgRegs(Word w) {
+    switch ((w.hi >> 9) & 7) {
+    case 5:
+        return 2;
+    case 6:
+    case 7:
+        return 4;
+    default:
+        return 1;
+    }
+}
+
+/// The 3-bit predicate operand fields (absolute bit offsets) an opcode uses, measured with nvdisasm on MKW's 320
+/// pixel programs: every predicate nvdisasm names sits in these fields. -1: opcode never seen (all candidates).
+constexpr std::array<int, 5> CANDIDATES{68, 77, 81, 84, 87};
+std::span<const int> PredicateFields(u32 op) {
+    static constexpr std::array<int, 1> f87{87};
+    static constexpr std::array<int, 1> f81{81};
+    static constexpr std::array<int, 2> f81_87{81, 87};
+    static constexpr std::array<int, 3> f81_84_87{81, 84, 87};
+    static constexpr std::array<int, 3> f68_81_87{68, 81, 87};
+    static constexpr std::array<int, 4> f68_81_84_87{68, 81, 84, 87};
+    static constexpr std::array<int, 0> none{};
+    switch (op) {
+    case 0x207: case 0x208: case 0x209: case 0x20a: case 0x217: case 0x807: case 0x808: case 0x809: case 0x80a:
+    case 0x817: case 0x947: case 0x94d: case 0xa09: case 0xa0a: case 0xc17:
+        return f87;
+    case 0x589: case 0xf89:
+        return f81;
+    case 0x212: case 0x812:
+        return f81_87;
+    case 0xa12:
+        return f68_81_87;
+    case 0x20b: case 0x80b: case 0xa0b:
+    // Carry-capable families (IADD3, LEA, IMAD): no predicate operands in the measured programs, but they can.
+    case 0x210: case 0x810: case 0xa10: case 0xc10: case 0x211: case 0x811: case 0xa11: case 0xc11:
+    case 0x224: case 0x824: case 0xa24: case 0xc24:
+        return f81_84_87;
+    case 0x20c: case 0x80c: case 0xa0c:
+        return f68_81_84_87;
+    case 0x81c:
+        return CANDIDATES;
+    // Seen without predicate operands.
+    case 0x202: case 0x220: case 0x221: case 0x223: case 0x230: case 0x23e: case 0x245: case 0x299: case 0x300:
+    case 0x305: case 0x306: case 0x307: case 0x308: case 0x326: case 0x421: case 0x423: case 0x424: case 0x621:
+    case 0x623: case 0x624: case 0x802: case 0x805: case 0x816: case 0x819: case 0x820: case 0x822: case 0x823:
+    case 0x882: case 0x890: case 0x892: case 0x899: case 0x91a: case 0x941: case 0x945: case 0x95b: case 0x981:
+    case 0xa02: case 0xa20: case 0xa23: case 0xab9: case 0xb05: case 0xb08: case 0xb60: case 0xb63: case 0xb66:
+    case 0xb69: case 0xb82: case 0xc20: case 0xc45: case 0xd06:
+        return none;
+    default:
+        return CANDIDATES;
+    }
+}
+
+/// Predicates an instruction may name: its guard (bits 12-14) and its predicate operand fields (7 = PT).
+u32 PredicateMask(Word w) {
+    u32 m = 1u << ((w.lo >> 12) & 7);
+    for (const int bit : PredicateFields(static_cast<u32>(w.lo & 0xFFF))) {
+        m |= 1u << ((w.hi >> (bit - 64)) & 7);
+    }
+    return m & 0x7F;
+}
+
+/// P2R / R2P read or write the whole predicate file.
+bool UsesPr(Word w) {
+    const u32 op = Opcode(w);
+    return op == 0x803 || op == 0x804 || op == 0x903 || op == 0x904;
+}
+
+bool IsBranch(Word w) {
+    switch (Opcode(w)) {
+    case 0x943: case 0x945: case 0x947: case 0x949: case 0x94A: case 0x950: case 0x94D:
+        return true;
+    default:
+        return false;
+    }
+}
+
+} // Anonymous namespace
+
+size_t ProgramEnd(std::span<const u8> image) {
+    const Word self = Bra(-0x10);
+    for (size_t o = SPH; o + 32 <= image.size(); o += 16) {
+        if (image[o] == 0x4D && (image[o + 1] & 0xF) == 9) {
+            const Word next = Load(image, o + 16);
+            if (next.lo == self.lo && (next.hi & ~CTL_HI) == (self.hi & ~CTL_HI)) {
+                return o;
+            }
+        }
+    }
+    return 0;
+}
+
+Result Patch(u64 program, std::span<const u8> image, u64 trampoline_va) {
+    Result r;
+    const size_t end = ProgramEnd(image);
+    if (end == 0) {
+        r.skipped = "no program end found";
+        return r;
+    }
+    r.program.assign(image.begin(), image.begin() + std::min(image.size(), (end + 0x20 + 31) / 32 * 32));
+    struct Site {
+        size_t off;
+        u32 rd, regs;
+    };
+    std::vector<Site> sites;
+    u32 used = 0;
+    bool pr = false;
+    for (size_t o = SPH; o <= end; o += 16) {
+        const Word w = Load(r.program, o);
+        used |= PredicateMask(w);
+        pr |= UsesPr(w);
+        if (IsLdg(w)) sites.push_back({o, static_cast<u32>((w.lo >> 16) & 0xFF), LdgRegs(w)});
+    }
+    if (sites.empty()) return r;
+    int free = -1;
+    for (int p = 6; p >= 0 && !pr; --p) {
+        if ((used & (1u << p)) == 0) {
+            free = p;
+            break;
+        }
+    }
+    if (free < 0) {
+        r.skipped = "no free predicate";
+        return r;
+    }
+    const Word first = Load(r.program, SPH);
+    if (IsBranch(first)) {
+        r.skipped = "starts with a branch";
+        return r;
+    }
+    const u32 p = static_cast<u32>(free);
+    auto& t = r.trampolines;
+    const auto va_now = [&] { return trampoline_va + t.size(); };
+    // Entry trampoline: P<p> = helper lane, once (no GPR is live at a pixel program's start, so R0 is scratch);
+    // then the program's first instruction (and, if that is an LDG, its zeroing), BRA back.
+    const u64 entry_va = va_now();
+    Append(t, S2rThreadKill(0, 0));
+    Append(t, IsetpNeZero(p, 0, 1));
+    Append(t, {first.lo, first.hi & ~(u64{0xF} << 58)}); // no operand reuse across the jump
+    const u32 first_wr = static_cast<u32>((first.hi >> 46) & 7);
+    if (IsLdg(first)) {
+        for (u32 i = 0; i < LdgRegs(first); ++i) Append(t, MovRzIf(p, static_cast<u32>((first.lo >> 16) & 0xFF) + i, 1u << first_wr));
+        ++r.loads;
+    }
+    Append(t, Bra(static_cast<s64>(program + SPH + 0x10) - static_cast<s64>(va_now() + 16)));
+    Store(r.program, SPH, Bra(static_cast<s64>(entry_va) - static_cast<s64>(program + SPH + 16)));
+    for (const Site& s : sites) {
+        if (s.off == SPH) continue;
+        Word x = Load(r.program, s.off);
+        const u32 wr = static_cast<u32>((x.hi >> 46) & 7);
+        x.hi &= ~(u64{0xF} << 58);
+        const u64 site_va = program + s.off, at = va_now();
+        Append(t, x);
+        for (u32 i = 0; i < s.regs; ++i) Append(t, MovRzIf(p, s.rd + i, 1u << wr));
+        Append(t, Bra(static_cast<s64>(site_va + 16) - static_cast<s64>(va_now() + 16)));
+        Store(r.program, s.off, Bra(static_cast<s64>(at) - static_cast<s64>(site_va + 16)));
+        ++r.loads;
+    }
+    return r;
+}
+
+} // namespace Tegra::Nx2Passthrough::HelperLoads
