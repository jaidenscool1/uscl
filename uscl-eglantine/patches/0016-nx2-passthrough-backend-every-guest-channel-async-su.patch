+    bool Reserve(Channel& c, NvU64 n, NvU64& at) {
+        // Guest entries run ~125k/s: read the fence (video memory over BAR) only when room runs short.
+        auto room = [&]() -> bool {
+            if (c.pending.size() >= ENTRIES - 1) return false;
