+            if (c.head >= tail) {
+                if (PB_WORDS - c.head >= n) { at = c.head; return true; }
+                if (tail > n) { at = 0; return true; }
+                return false;
+            }
+            if (tail - c.head > n) { at = c.head; return true; }
+            return false;
+        };
