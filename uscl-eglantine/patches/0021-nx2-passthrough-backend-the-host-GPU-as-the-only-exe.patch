+void AfterEntry(s32 channel, std::function<void()> done) {
+    State& s = Get();
+    {
+        std::scoped_lock lk{s.mutex};
+        if (s.host && s.submit_words) {
+            s.after[channel].push_back(std::move(done));
+            return;
+        }
+        ++s.after_now;
+    }
+    done();
+}
+
+void SoleSyncpoint(Host1x::SyncpointManager& syncpoints, u32 id, s32 channel) {
+    if (id >= Host1x::SyncpointManager::NUM_MAX_SYNCPOINTS) return; // command words read wrong (fence manager)
+    syncpoints.IncrementGuest(id);
+    std::function<void()> done = [&syncpoints, id] { syncpoints.IncrementHost(id); };
+    if (channel < 0) { // no entry to attach it to (the back's thread): after everything submitted so far
+        State& s = Get();
+        {
+            std::scoped_lock lk{s.mutex};
+            if (s.host && s.submit_words) {
+                s.armed.push_back({s.host->RingAll(), {std::move(done)}});
+                return;
+            }
+        }
+        done();
+        return;
+    }
+    AfterEntry(channel, std::move(done));
+}
+
+void WaitHost() {
+    State& s = Get();
+    std::vector<std::pair<Host::Channel*, NvU32>> wait;
+    {
+        std::scoped_lock lk{s.mutex};
+        if (!s.host) return;
+        wait = s.host->RingAll();
+    }
+    const auto start = std::chrono::steady_clock::now();
+    for (const auto& [c, fence] : wait) {
+        for (;;) {
+            {
+                std::scoped_lock lk{s.mutex};
+                if (!s.host || Host::PassedFence(*c, fence)) break;
+            }
+            if (std::chrono::steady_clock::now() - start > std::chrono::milliseconds(250)) return;
+            std::this_thread::sleep_for(std::chrono::microseconds(100));
+        }
+    }
