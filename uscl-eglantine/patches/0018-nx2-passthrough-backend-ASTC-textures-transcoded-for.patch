+void SwizzleImageToBuffer(const ImageInfo& info, std::span<const BufferImageCopy> copies,
+                          std::span<const u8> input, std::span<u8> output, bool native_tiling) {
+    const LevelInfo level_info = MakeLevelInfo(info);
+    const Extent2D tile_size = DefaultBlockSize(info.format);
+    const u32 bytes_per_block = BytesPerBlock(info.format);
+    const u32 num_levels = info.resources.levels;
+    const std::array sizes = CalculateLevelSizes(level_info, num_levels);
+    const size_t layer_stride = AlignLayerSize(CalculateLevelBytes(sizes, num_levels), info.size, level_info.block,
+                                               tile_size.height, info.tile_width_spacing);
+    for (const BufferImageCopy& copy : copies) {
+        const s32 level = copy.image_subresource.base_level;
+        const Extent3D level_size = AdjustMipSize(info.size, level);
+        const Extent3D num_tiles = AdjustTileSize(level_size, tile_size);
+        const Extent3D block = AdjustMipBlockSize(num_tiles, level_info.block, level, level_info.num_levels);
+        const size_t host_bytes_per_layer = size_t{NumBlocks(level_size, tile_size)} * bytes_per_block;
+        size_t host_offset = copy.buffer_offset, guest_offset = CalculateLevelBytes(sizes, level);
+        for (s32 layer = 0; layer < info.resources.layers; ++layer) {
+            if (guest_offset + sizes[level] > output.size() || host_offset >= input.size()) {
+                break;
+            }
+            SwizzleTexture(output.subspan(guest_offset, sizes[level]), input.subspan(host_offset), bytes_per_block,
+                           num_tiles.width, num_tiles.height, num_tiles.depth, block.height, block.depth, 1,
+                           native_tiling);
+            host_offset += host_bytes_per_layer;
+            guest_offset += layer_stride;
+        }
+    }
+}
