     void Open() {
         ctl = open("/dev/nvidiactl", O_RDWR | O_CLOEXEC);
@@ -473,6 +484,283 @@ public:
         Control(subdevice, NV2080_CTRL_CMD_GR_CTXSW_PREEMPTION_BIND, &b, "preemption bind");
     }
 
+    // --- Step 6, first version: ASTC ---
+    // The RTX samples no ASTC (a raw header reads black, no fault: measured on mkw21's replay). The guest's
+    // texture header pools become shadow pages; an ASTC header there points at an A8B8G8R8 copy in a host
+    // arena, decoded by a worker with Eglantine's own decoder and re-swizzled to the header's block layout.
+    // Until its copy is ready (or when it is too large) a header stays as the guest wrote it.
+    // shortcut: decoded once; data the guest uploads later into the same texture is not seen; the arena is a
+    // bump allocator never freed (EDEN_NX2_PASSTHROUGH_ASTC_MB, 2048 by default). BC7/BC1 targets: plan step 6.
+    static bool IsAstc(u32 w0) {
+        const u32 f = w0 & 0x7F;
+        return (f >= 0x40 && f <= 0x46) || (f >= 0x50 && f <= 0x57);
+    }
+    using Header = std::array<u32, 8>;
+    struct Pool {
+        u32 count = 0;
+        std::vector<u8> copy; // the guest's headers as last translated
+        bool full = true;     // translate every page at the next refresh
+        std::set<NvU64> dirty; // page offsets to translate (newly sampled headers)
+    };
+
+    /// Headers the game samples (Eglantine read them): their pages are translated at the next refresh.
+    void MarkUsed(std::span<const u64> addresses) {
+        for (const u64 a : addresses) {
+            auto it = pools.upper_bound(a);
+            if (it == pools.begin()) continue;
+            --it;
+            if (a >= it->first + u64{it->second.count} * 32 || (a - it->first) % 32 != 0) continue;
+            if (used_headers.insert(a).second) it->second.dirty.insert((a - it->first) & ~(PAGE - 1));
+        }
+    }
+
+    void SetHeaderPool(NvU64 va, u32 count) {
+        if (va < GUEST_VA_LO || count == 0 || count > (1u << 20)) return;
+        Pool& pool = pools[va];
+        if (pool.count == count) return;
+        pool.count = count;
+        pool.full = true;
+        if (!astc_thread.joinable()) StartAstc();
+    }
+
+    /// Entry thread: decoded copies become visible, changed guest headers are translated into the shadow pages.
+    void RefreshPools(u64 epoch) {
+        if (pools.empty() || epoch == pools_epoch || astc_cpu == nullptr) return;
+        pools_epoch = epoch;
+        bool fresh = false;
+        {
+            std::scoped_lock lk{astc_mutex};
+            for (auto& [header, result] : astc_done) {
+                decoded[header] = result;
+                fresh = true;
+                result.first != 0 ? ++astc_decoded : ++astc_failed;
+            }
+            astc_done.clear();
+        }
+        for (auto& [va, pool] : pools) {
+            const size_t bytes = size_t{pool.count} * 32;
+            std::vector<u8> cur(bytes);
+            cur.resize(ReadGuest(va, cur));
+            const bool full = pool.full || fresh || pool.copy.size() != cur.size();
+            if (pool.full) ShadowRange(va, cur.size());
+            for (size_t o = 0; o < cur.size(); o += PAGE) {
+                const size_t n = std::min<size_t>(PAGE, cur.size() - o);
+                if (!full && !pool.dirty.contains(o) && std::memcmp(cur.data() + o, pool.copy.data() + o, n) == 0) {
+                    continue;
+                }
+                std::vector<u8> page(cur.begin() + o, cur.begin() + o + n);
+                for (size_t h = 0; h + 32 <= n; h += 32) TranslateHeader(page.data() + h, va + o + h);
+                WriteShadow(va + o, page, true, false); // shortcut: no wait for a header slot the GPU may read
+            }
+            pool.copy = std::move(cur);
+            pool.full = false;
+            pool.dirty.clear();
+        }
+    }
+
+    /// Makes [va, va + bytes) shadow pages with one unmap of the guest mapping (page by page, every page split
+    /// and re-mapped the large rest of it: RM ran out of page-table memory, NV_ERR_NO_MEMORY).
+    void ShadowRange(NvU64 va, NvU64 bytes) {
+        std::vector<std::pair<NvU64, const u8*>> todo;
+        for (NvU64 page = va & ~(PAGE - 1); page < va + bytes; page += PAGE) {
+            const auto it = pieces.find(page);
+            if (it != pieces.end() && it->second.shadow != ~0u) continue;
+            if (const u8* src = MirroredHost(page)) todo.emplace_back(page, src);
+        }
+        if (todo.empty()) return;
+        for (size_t i = 0; i < todo.size();) { // runs of consecutive pages (shadow pages between them stay)
+            size_t j = i + 1;
+            while (j < todo.size() && todo[j].first == todo[j - 1].first + PAGE) ++j;
+            Unmap(todo[i].first, todo[j - 1].first + PAGE - todo[i].first, true);
+            i = j;
+        }
+        for (const auto& [page, src] : todo) {
+            if (NewShadowPage(page, src) == ~0u) {
+                MapOff(page, static_cast<NvU64>(src - guest_base), PAGE); // pool full: the guest page back
+            }
+        }
+    }
+
+    void TranslateHeader(u8* raw, NvU64 header_va) {
+        Header h;
+        std::memcpy(h.data(), raw, 32);
+        if (!IsAstc(h[0])) return;
+        if (const auto it = decoded.find(h); it != decoded.end()) {
+            const auto [va, components] = it->second;
+            if (va == 0) return;
+            h[0] = (h[0] & ~0x7Fu) | components;                                // COMPONENTS
+            h[1] = (h[1] & 0x1FFu) | (static_cast<u32>(va) & ~0x1FFu);          // ADDRESS_BITS31TO9
+            h[2] = (h[2] & ~0x1FFFFu) | (static_cast<u32>(va >> 32) & 0x1FFFFu); // ADDRESS_BITS48TO32
+            std::memcpy(raw, h.data(), 32);
+            ++astc_headers;
+            return;
+        }
+        if (astc_queued.contains(h) || !used_headers.contains(header_va)) return; // decoded once the game samples it
+        Tegra::Texture::TICEntry tic{};
+        std::memcpy(&tic, h.data(), 32);
+        const VideoCommon::ImageInfo info(tic);
+        VideoCommon::ImageInfo rgba = info;
+        rgba.format = VideoCore::Surface::PixelFormat::A8B8G8R8_UNORM;
+        const u64 guest_size = VideoCommon::CalculateGuestSizeInBytes(info);
+        const bool block_linear = info.type != VideoCommon::ImageType::Linear;
+        if (!block_linear || !VideoCore::Surface::IsPixelFormatASTC(info.format) || guest_size == 0 ||
+            guest_size > (64ull << 20) || VideoCommon::CalculateGuestSizeInBytes(rgba) > (128ull << 20)) {
+            decoded[h] = {0, 0}; // left raw (MKW: 8192^2 x 68 virtual-texture arrays)
+            ++astc_too_large;
+            return;
+        }
+        std::array<u8, 4096> head{};
+        const size_t probe = std::min<size_t>(guest_size, head.size());
+        if (ReadGuest(tic.Address(), std::span<u8>(head).first(probe)) != probe ||
+            std::all_of(head.begin(), head.begin() + probe, [](u8 b) { return b == 0; })) {
+            return; // not there yet: looked at again at a later refresh
+        }
+        AstcJob job{h, std::vector<u8>(guest_size)};
+        if (ReadGuest(tic.Address(), job.guest) != guest_size) return;
+        astc_queued.insert(h);
+        std::scoped_lock lk{astc_mutex};
+        astc_jobs.push_back(std::move(job));
+        astc_cv.notify_one();
+    }
+
+    void SetMemoryManager(Tegra::MemoryManager* mm) { memory_manager = mm; }
+    NvU64 astc_decoded = 0, astc_failed = 0, astc_too_large = 0, astc_headers = 0;
+    NvU64 AstcArenaUsed() const { return astc_used.load(); }
+
+private:
+    struct AstcJob {
+        Header header;
+        std::vector<u8> guest;
+    };
+
+    void StartAstc() {
+        const char* v = std::getenv("EDEN_NX2_PASSTHROUGH_ASTC_MB");
+        astc_size = (v != nullptr ? std::strtoull(v, nullptr, 0) : 2048ull) << 20;
+        if (astc_size == 0) return;
+        void* p = mmap(nullptr, astc_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (p == MAP_FAILED) throw Error("ASTC arena", 0);
+        maps.emplace_back(p, astc_size);
+        nv_ioctl_nvos02_parameters_with_fd d{};
+        d.fd = -1;
+        d.params.hRoot = root;
+        d.params.hObjectParent = device;
+        d.params.hObjectNew = 0x73000000u;
+        d.params.hClass = NV01_MEMORY_SYSTEM_OS_DESCRIPTOR;
+        d.params.flags = DRF_DEF(OS02, _FLAGS, _PHYSICALITY, _NONCONTIGUOUS) |
+                         DRF_DEF(OS02, _FLAGS, _COHERENCY, _CACHED) | DRF_DEF(OS02, _FLAGS, _MAPPING, _NO_MAP);
+        d.params.pMemory = reinterpret_cast<NvP64>(p);
+        d.params.limit = astc_size - 1;
+        Ioctl(fds.at(0), NV_ESC_RM_ALLOC_MEMORY, &d, "import ASTC arena");
+        if (d.params.status != NV_OK) throw Error("import ASTC arena", d.params.status);
+        astc_gva = MapGpu(d.params.hObjectNew, astc_size);
+        astc_cpu = static_cast<u8*>(p);
+        astc_thread = std::thread([this] { AstcWorker(); });
+        LOG_INFO(HW_GPU, "Nx2 passthrough: ASTC arena {} MiB at {:#x}", astc_size >> 20, astc_gva);
+    }
+
+    void StopAstc() {
+        {
+            std::scoped_lock lk{astc_mutex};
+            astc_stop = true;
+        }
+        astc_cv.notify_all();
+        if (astc_thread.joinable()) astc_thread.join();
+    }
+
+    void AstcWorker() {
+        for (;;) {
+            AstcJob job;
+            {
+                std::unique_lock lk{astc_mutex};
+                astc_cv.wait(lk, [&] { return astc_stop || !astc_jobs.empty(); });
+                if (astc_stop) return;
+                job = std::move(astc_jobs.front());
+                astc_jobs.pop_front();
+            }
+            std::pair<NvU64, u32> result{};
+            try {
+                result = Decode(job);
+            } catch (...) {
+                result = {};
+            }
+            std::scoped_lock lk{astc_mutex};
+            astc_done.emplace_back(job.header, result);
+        }
+    }
+
+    /// The texture `job` describes, decoded, in the header's own block-linear layout, in the arena: VA and
+    /// the TIC COMPONENTS code (0: none). BC1 when it is opaque, else BC3 (EDEN_NX2_PASSTHROUGH_ASTC_FORMAT=rgba:
+    /// A8B8G8R8, 4x the memory): the RTX samples BCn.
+    std::pair<NvU64, u32> Decode(const AstcJob& job) {
+        using namespace VideoCommon;
+        using VideoCore::Surface::PixelFormat;
+        static const bool rgba_only = [] {
+            const char* v = std::getenv("EDEN_NX2_PASSTHROUGH_ASTC_FORMAT");
+            return v != nullptr && std::string_view{v} == "rgba";
+        }();
+        Tegra::Texture::TICEntry tic{};
+        std::memcpy(&tic, job.header.data(), 32);
+        const ImageInfo info(tic);
+        std::vector<u8> linear(CalculateUnswizzledSizeBytes(info));
+        auto copies = UnswizzleImage(*memory_manager, tic.Address(), info, job.guest, linear);
+        const bool bc1 = !rgba_only && Tegra::Texture::ASTC::IsOpaque(linear);
+        ImageInfo out_info = info;
+        out_info.format = rgba_only ? PixelFormat::A8B8G8R8_UNORM : bc1 ? PixelFormat::BC1_RGBA_UNORM : PixelFormat::BC3_UNORM;
+        const u32 bw = VideoCore::Surface::DefaultBlockWidth(info.format);
+        const u32 bh = VideoCore::Surface::DefaultBlockHeight(info.format);
+        size_t total = 0;
+        for (const BufferImageCopy& copy : copies) {
+            total += size_t{(copy.image_extent.width + 3) & ~3u} * ((copy.image_extent.height + 3) & ~3u) *
+                     copy.image_subresource.num_layers * copy.image_extent.depth * 4;
+        }
+        std::vector<u8> pixels(total), rgba;
+        size_t out = 0;
+        for (BufferImageCopy& copy : copies) {
+            const u32 w = copy.image_extent.width, h = copy.image_extent.height;
+            const u32 depth = copy.image_subresource.num_layers * copy.image_extent.depth;
+            rgba.resize(size_t{w} * h * depth * 4);
+            Tegra::Texture::ASTC::Decompress(std::span<const u8>(linear).subspan(copy.buffer_offset), w, h, depth, bw,
+                                             bh, rgba);
+            copy.buffer_offset = out;
+            if (rgba_only) {
+                std::memcpy(pixels.data() + out, rgba.data(), rgba.size());
+                out += rgba.size();
+                continue;
+            }
+            const size_t bytes = size_t{(w + 3) & ~3u} * ((h + 3) & ~3u) * depth / (bc1 ? 2 : 1);
+            (bc1 ? Tegra::Texture::BCN::CompressBC1 : Tegra::Texture::BCN::CompressBC3)(
+                rgba, w, h, depth, std::span<u8>(pixels).subspan(out, bytes));
+            out += bytes;
+        }
+        std::vector<u8> swizzled(CalculateGuestSizeInBytes(out_info));
+        SwizzleImageToBuffer(out_info, copies, pixels, swizzled, memory_manager->UsesNativeTiling());
+        // 4 KiB: the header takes 512-byte aligned addresses (64 KiB padding filled 2 GiB with 26k small textures)
+        const NvU64 size = (swizzled.size() + 0xFFF) & ~NvU64{0xFFF};
+        NvU64 at = astc_used.load();
+        do {
+            if (at + size > astc_size) return {0, 0}; // arena full
+        } while (!astc_used.compare_exchange_weak(at, at + size));
+        std::memcpy(astc_cpu + at, swizzled.data(), swizzled.size());
+        return {astc_gva + at, rgba_only ? 0x08u : bc1 ? 0x24u : 0x26u}; // A8B8G8R8, DXT1, DXT45
+    }
+
+    std::map<NvU64, Pool> pools;
+    u64 pools_epoch = 0;
+    std::map<Header, std::pair<NvU64, u32>> decoded; // entry thread: header -> its copy's VA (0: raw), format
+    std::set<Header> astc_queued;
+    std::set<NvU64> used_headers; // header VAs Eglantine sampled
+    Tegra::MemoryManager* memory_manager = nullptr;
+    std::mutex astc_mutex;
+    std::condition_variable astc_cv;
+    std::deque<AstcJob> astc_jobs;
+    std::vector<std::pair<Header, std::pair<NvU64, u32>>> astc_done;
+    bool astc_stop = false;
+    std::thread astc_thread;
+    u8* astc_cpu = nullptr;
+    NvU64 astc_gva = 0, astc_size = 0;
+    std::atomic<NvU64> astc_used{0};
+
+public:
     // --- Step 2: the guest VA space ---
 
     /// Maps [va, va + size) to guest memory at `off` (bytes from the guest memory base), replacing what was there.
@@ -496,6 +784,7 @@ public:
             RmUnmap(pva, p.mem);
             if (p.shadow != ~0u) { // the guest remaps code: the page is rebuilt at the next bind
                 free_shadow.push_back(p.shadow);
+                for (auto& [pva_, pool] : pools) pool.full = true; // a pool page may have been one
                 continue;
             }
             if (pva < va) MapPiece(pva, va - pva, p.off, p.kind);
@@ -619,7 +908,7 @@ public:
     }
 
     // Counters for the log.
-    NvU64 doorbells = 0;
+    NvU64 doorbells = 0, map_retries = 0;
     NvU64 ring_waits = 0, pinned = 0, rm_maps = 0, rm_unmaps = 0, kind_changes = 0, kind_fallbacks = 0;
     std::chrono::nanoseconds import_time{};
     size_t Pieces() const { return pieces.size(); }
@@ -686,7 +975,7 @@ private:
 
     /// Writes `bytes` at va into shadow pages: `create` makes missing shadow pages (copies of the guest page);
     /// otherwise only pages already shadowed are written. True when a shadow page changed.
-    bool WriteShadow(NvU64 va, std::span<const u8> bytes, bool create) {
+    bool WriteShadow(NvU64 va, std::span<const u8> bytes, bool create, bool quiesce = true) {
         bool changed = false;
         for (NvU64 page = va & ~(PAGE - 1); page < va + bytes.size(); page += PAGE) {
             auto it = pieces.find(page);
@@ -699,7 +988,7 @@ private:
             const NvU64 lo = std::max(va, page), hi = std::min<NvU64>(va + bytes.size(), page + PAGE);
             u8* copy = shadow_copy.data() + index * PAGE + (lo - page);
             if (std::memcmp(copy, bytes.data() + (lo - va), hi - lo) == 0) continue; // as the GPU has it already
-            if (!fresh_shadow.contains(index)) {
+            if (!fresh_shadow.contains(index) && quiesce) {
                 ++quiesce_sites[1];
                 Quiesce(); // the GPU may be running code in this page
             }
@@ -712,8 +1001,9 @@ private:
     }
 
     /// Replaces the guest page at `page` with a shadow copy of it; ~0u when the pool is full or nothing is mapped.
-    u32 NewShadowPage(NvU64 page) {
-        const u8* src = MirroredHost(page);
+    /// `src`: the guest memory the page stands for, when the caller already unmapped it.
+    u32 NewShadowPage(NvU64 page, const u8* src = nullptr) {
+        if (src == nullptr) src = MirroredHost(page);
         if (src == nullptr || (free_shadow.empty() && shadow_next == SHADOW_POOL / PAGE)) return ~0u;
         const u32 index = free_shadow.empty() ? shadow_next++ : free_shadow.back();
         if (!free_shadow.empty() && index == free_shadow.back()) free_shadow.pop_back();
@@ -787,9 +1077,12 @@ private:
         p.kindOverride = kind;
         p.dmaOffset = va;
         Ioctl(ctl, NV_ESC_RM_MAP_MEMORY_DMA, &p, "map guest memory");
-        if (p.status == NV_ERR_NO_MEMORY) { // seen once per session in RM's page-table walk; a retry succeeds
+        for (int retry = 0; retry < 8 && p.status == NV_ERR_NO_MEMORY; ++retry) {
+            // RM's page-table walk fails now and then (once a session, more with many 4 KiB pieces)
+            std::this_thread::sleep_for(std::chrono::milliseconds(1 << retry));
             p.dmaOffset = va;
             Ioctl(ctl, NV_ESC_RM_MAP_MEMORY_DMA, &p, "map guest memory");
+            ++map_retries;
         }
         if (p.status != NV_OK && kind != 0) { // a kind the host does not take: pitch keeps the bytes reachable
             if (++kind_fallbacks <= 8) {
@@ -1039,6 +1332,7 @@ constexpr u32 INSTRUMENTATION_A = 0x150 / 4, INSTRUMENTATION_B = 0x154 / 4, LINE
               SEND_SIGNALING_PCAS2_B = 0x2C0 / 4, LM_NON_THROTTLED_B = 0x2E8 / 4, SPA_VERSION = 0x310 / 4,
