     /// Sends the current execution context to the GPU.
     u64 Flush(VkSemaphore signal_semaphore = {}, VkSemaphore wait_semaphore = {});
 
+    /// The next batch sent to the GPU, whatever sends it, waits at every stage for `semaphore`,
+    /// which is kept until that batch has completed. Sparse binds use it: the commands recorded
+    /// after a bind (the uploads into its blocks) must not run before it, even when something
+    /// flushes before the code that recorded them is done.
+    void WaitBeforeNextSubmit(vk::Semaphore semaphore) {
+        next_submit_waits.push_back(std::move(semaphore));
+    }
