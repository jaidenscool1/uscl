 static constexpr VkPipelineStageFlags wait_stage_mask = VK_PIPELINE_STAGE_VERTEX_SHADER_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT |
                                                         VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
 
+namespace {
+// The wait semaphores of one batch: the swapchain's (shader and colour output stages) and the
+// extra ones, waited for at every stage.
+struct BatchWaits {
+    BatchWaits(VkSemaphore wait_semaphore, std::span<const VkSemaphore> extra_waits) {
+        if (wait_semaphore) {
+            Add(wait_semaphore, wait_stage_mask);
+        }
+        for (const VkSemaphore extra : extra_waits) {
+            Add(extra, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT);
+        }
+    }
+    void Add(VkSemaphore semaphore, VkPipelineStageFlags stages) {
+        semaphores.push_back(semaphore);
+        masks.push_back(stages);
+        values.push_back(0);
+        infos.push_back(VkSemaphoreSubmitInfo{
+            .sType = VK_STRUCTURE_TYPE_SEMAPHORE_SUBMIT_INFO,
+            .pNext = nullptr,
+            .semaphore = semaphore,
+            .value = 0,
+            .stageMask = static_cast<VkPipelineStageFlags2>(stages),
+            .deviceIndex = 0,
+        });
+    }
+    u32 Count() const {
+        return static_cast<u32>(semaphores.size());
+    }
+    // Pointers must be null when the count is zero (best-practices)
+    template <typename T>
+    static const T* Data(const std::vector<T>& list) {
+        return list.empty() ? nullptr : list.data();
+    }
+    std::vector<VkSemaphore> semaphores;
+    std::vector<VkPipelineStageFlags> masks;
+    std::vector<u64> values; // binary semaphores: ignored
+    std::vector<VkSemaphoreSubmitInfo> infos;
+};
+} // Anonymous namespace
