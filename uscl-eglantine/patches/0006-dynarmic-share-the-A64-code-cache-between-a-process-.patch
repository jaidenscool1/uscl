@@ -427,15 +505,28 @@ void ArmDynarmic64::MakeJit(Common::PageTable* page_table, std::size_t address_s
         config.fastmem_pointer = std::nullopt;
         config.fastmem_exclusive_access = false;
     }
+    if (page_table && SharedJit()) {
+        config.shared_code = true;
+        config.callbacks = &g_shared_callbacks;
+        // One cache instead of one per core; offsets in it must stay under 1 GiB.
+        config.code_cache_size = std::uint32_t(960_MiB);
+        if (m_core_index != 0) {
+            auto* const first = static_cast<ArmDynarmic64*>(m_cb->m_process->GetArmInterface(0));
+            ASSERT(first != nullptr && first->m_jit);
+            config.share_code_with = &*first->m_jit;
+        }
+    }
     m_jit.emplace(config);
 }
 
 HaltReason ArmDynarmic64::RunThread(Kernel::KThread* thread) {
+    t_running_callbacks = &*m_cb;
     m_jit->ClearExclusiveState();
     return TranslateHaltReason(m_jit->Run());
 }
 
 HaltReason ArmDynarmic64::StepThread(Kernel::KThread* thread) {
+    t_running_callbacks = &*m_cb;
     m_jit->ClearExclusiveState();
     return TranslateHaltReason(m_jit->Step());
 }
