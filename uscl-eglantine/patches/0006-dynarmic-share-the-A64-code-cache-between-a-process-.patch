+    if (conf.shared_code) {
+        Xbyak::Label skip;
+        code.jng(skip, code.T_NEAR);
+        EmitSharedLink(target_desc, target_code_ptr);
+        code.L(skip);
+        return;
+    }
     const CodePtr patch_location = code.getCurr();
     if (target_code_ptr) {
         code.jg(target_code_ptr);
@@ -779,6 +825,13 @@ void A64EmitX64::EmitPatchJg(const IR::LocationDescriptor& target_desc, CodePtr
 }
 
