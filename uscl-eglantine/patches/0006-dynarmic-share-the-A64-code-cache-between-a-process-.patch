+    }
+    u64 GetTicksRemaining() override {
+        return t_running_callbacks->DynarmicCallbacks64::GetTicksRemaining();
+    }
+    u64 GetCNTPCT() override {
+        return t_running_callbacks->DynarmicCallbacks64::GetCNTPCT();
+    }
+};
+
+SharedCallbacks64 g_shared_callbacks;
+
+/// One JIT code cache for all cores of a process: a block runs on whichever core needs it
+/// without being compiled again (Mario Kart World compiled each block about 3 times).
+/// USCL_SHARED_JIT=0 gives every core its own.
+bool SharedJit() {
+    static const bool shared = [] {
+        const char* value = std::getenv("USCL_SHARED_JIT");
+        return value == nullptr || value[0] != '0';
+    }();
+    return shared;
+}
+
+} // namespace
