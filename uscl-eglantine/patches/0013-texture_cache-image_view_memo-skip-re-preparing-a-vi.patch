 #pragma once
 
 #include <array>
+#include <atomic>
 #include <optional>
 #include <vector>
 #include <boost/container/small_vector.hpp>
@@ -22,6 +23,15 @@
 
 namespace VideoCommon {
 
+/// Bumped whenever an image gains CpuModified or Alias, or is deleted: a texture cache answer
+/// that relied on no image needing preparation stays valid while it is unchanged (Nx2Perf
+/// image_view_memo).
+inline std::atomic<u64> g_image_state_epoch{1};
+
+inline void BumpImageStateEpoch() noexcept {
+    g_image_state_epoch.fetch_add(1, std::memory_order_relaxed);
+}
+
 enum class ImageFlagBits : u32 {
     AcceleratedUpload = 1 << 0, ///< Upload can be accelerated in the GPU
     Converted = 1 << 1,   ///< Guest format is not supported natively and it has to be converted
