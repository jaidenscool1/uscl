 #include "video_core/nx2_hazard.h"
 #include "video_core/host1x/gpu_device_memory_manager.h"
 #include "video_core/nx2.h"
@@ -1249,8 +1250,32 @@ ImageViewId TextureCache<P>::VisitImageView(u32 index, bool compute) {
         return NULL_IMAGE_VIEW_ID;
     }
     const auto id = table.bound_ids[index];
-    if (id != NULL_IMAGE_VIEW_ID)
-        PrepareImageView(id, false, false);
+    if (id == NULL_IMAGE_VIEW_ID) {
+        return id;
+    }
+    // Nx2Perf image_view_memo: this index already prepared this view this frame and no image
+    // changed state since, so PrepareImageView would only touch the LRU again (same tick).
+    const u64 epoch = g_image_state_epoch.load(std::memory_order_relaxed);
+    auto& memo = table.memo[index];
+    const bool memo_hit = memo.view == id.index && memo.epoch == epoch &&
+                          memo.frame == frame_tick &&
+                          Nx2Perf::On(Nx2Perf::Opt::ImageViewMemo);
+    if (memo_hit && !Nx2Perf::Verify()) [[likely]] {
+        return id;
+    }
+    const ImageViewBase& image_view = slot_image_views[id];
+    if (image_view.IsBuffer()) {
+        return id;
+    }
+    const ImageBase& image = slot_images[image_view.image_id];
+    const bool clean = False(image.flags & (ImageFlagBits::CpuModified | ImageFlagBits::Alias));
+    if (memo_hit && !clean) [[unlikely]] {
+        LOG_ERROR(HW_GPU, "Nx2Perf image_view_memo: view {} index {} needed preparation",
+                  id.index, index);
+    }
+    PrepareImage(image_view.image_id, false, false);
+    using Memo = std::remove_reference_t<decltype(memo)>;
+    memo = clean ? Memo{epoch, frame_tick, id.index} : Memo{};
     return id;
 }
 
