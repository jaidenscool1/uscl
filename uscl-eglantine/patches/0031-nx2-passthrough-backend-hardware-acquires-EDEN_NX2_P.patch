+
+bool HwAcquire(s32 channel, size_t word, GPUVAddr address, u32 value, const std::function<bool(u32)>& meets) {
+    if (HwAcqMode() == 0) return false;
+    // The entry's words before the acquire are translated first: its own releases (MKW: the dispatch just
+    // before, whose QMD adds 1) count. A part that ends inside a method run is held: its writes are pending below.
+    SubmitEntry(channel, word, false);
+    State& s = Get();
+    std::scoped_lock lk{s.mutex};
+    if (!s.host || !s.submit_words) return false;
+    auto& x = s.xlate[channel];
+    const bool pending_here = std::any_of(x.writes.begin(), x.writes.end(), [&](const auto& w) { return w.va == address; });
+    const auto it = s.promised.find(address);
+    const u8* p = it != s.promised.end() || pending_here ? s.host->MirroredHost(address) : nullptr;
+    if (p == nullptr || s.unpredictable.contains(address)) {
+        ++s.counts[HwUnknown];
+        return false;
+    }
+    u32 now;
+    std::memcpy(&now, p, 4);
+    if (meets(now)) return false; // met already: the front's usual path
+    u32 promised = now;
+    const auto last = s.last_write.find(address);
+    if (it != s.promised.end() && static_cast<s32>(now - it->second) <= 0 && last != s.last_write.end() &&
+        !Host::PassedFence(*last->second.first, last->second.second)) {
+        promised = it->second; // writes still pending on the host; else memory holds them (or was reset)
+    }
+    if (it != s.promised.end()) it->second = promised;
+    for (const auto& w : x.writes) { // this channel's, not submitted yet: they come before the acquire
+        if (w.va != address) continue;
+        if (w.how == 2) return false;
+        promised = w.how == 0 ? w.payload : promised + w.payload;
+    }
