 namespace {
+/// EDEN_NX2_PASSTHROUGH_HWACQ: 0 off, 1 the front leaves acquires the submitted host work meets to the host,
+/// 2 also compares the entries it parsed ahead of them with memory once they are met (measuring).
+u32 HwAcqMode() {
+    static const u32 mode = [] {
+        const char* v = std::getenv("EDEN_NX2_PASSTHROUGH_HWACQ");
+        return Sole() && v != nullptr ? static_cast<u32>(std::strtoul(v, nullptr, 0)) : 0u;
+    }();
+    return mode;
+}
+
+/// EDEN_NX2_PASSTHROUGH_HWACQ_LOG=<n> (bisecting): logs the first n promises and acquires left to the host.
+bool HwAcqLog() {
+    static const u64 limit = [] {
+        const char* v = std::getenv("EDEN_NX2_PASSTHROUGH_HWACQ_LOG");
+        return v != nullptr ? std::strtoull(v, nullptr, 0) : 0ull;
+    }();
+    static std::atomic<u64> logged{0};
+    return limit != 0 && logged.fetch_add(1, std::memory_order_relaxed) < limit;
+}
+
+/// HWACQ=2, poller: channels whose passed acquires memory now meets: their entries parsed meanwhile, as memory
+/// holds them now (what the front would have read had it waited), against what it read.
+void CheckAhead(State& s) {
+    for (auto& [channel, a] : s.ahead) {
+        if (a.conditions.empty() || !s.host) continue;
+        const bool met = std::all_of(a.conditions.begin(), a.conditions.end(), [&](const auto& c) {
+            const u8* p = s.host->MirroredHost(c.first);
+            u32 word = 0;
+            if (p != nullptr) std::memcpy(&word, p, 4);
+            return p == nullptr || c.second(word);
+        });
+        if (!met) continue;
+        for (const auto& [va, words] : a.entries) {
+            ++s.counts[AheadEntries];
+            const u8* p = (va & 0xFFF) + words.size() * 4 <= 0x1000 ? s.host->MirroredHost(va) : nullptr;
+            if (p == nullptr) {
+                ++s.counts[AheadUnread];
+                continue;
+            }
+            if (std::memcmp(p, words.data(), words.size() * 4) == 0) continue;
+            if (s.counts[AheadDiffer]++ < 16) {
+                size_t i = 0;
+                while (std::memcmp(p + i * 4, &words[i], 4) == 0) ++i;
+                u32 now;
+                std::memcpy(&now, p + i * 4, 4);
+                LOG_INFO(HW_GPU, "Nx2 passthrough HWACQ check: channel {} entry {:#x} ({} words) changed at word {}: "
+                         "{:#x} -> {:#x}", channel, va, words.size(), i, words[i], now);
+            }
+        }
+        a.conditions.clear();
+        a.entries.clear();
+    }
+}
