+/// GPUTIME, poller: sums the finished submissions' GPU time; logs every 5 s.
+void GpuTimes(State& s) {
+    for (auto& [guest, c] : s.host->Channels()) {
+        if (c.gt_cpu == nullptr) continue;
+        const NvU32 passed = Host::Passed(c);
+        while (static_cast<s32>(passed - c.gt_done) > 0) {
+            const NvU32 fence = ++c.gt_done;
+            const NvU64 slot = fence % Host::GT_SLOTS;
+            const volatile NvU8* p = c.gt_cpu + slot * 32;
+            if (*reinterpret_cast<const volatile NvU32*>(p) != fence || *reinterpret_cast<const volatile NvU32*>(p + 16) != fence) {
+                continue; // an untimed submission (by reference, or before the ring)
+            }
+            const u64 t0 = *reinterpret_cast<const volatile u64*>(p + 8), t1 = *reinterpret_cast<const volatile u64*>(p + 24);
+            auto& e = s.gt_sum[c.gt_meta[slot]];
+            e.first += t1 - t0;
+            ++e.second;
+        }
+    }
+    const auto now = std::chrono::steady_clock::now();
+    const double secs = std::chrono::duration<double>(now - s.gt_since).count();
+    if (secs < 5.0) return;
+    std::map<s32, u64> per_channel;
+    std::vector<std::pair<u64, std::pair<s32, NvU64>>> top;
+    for (const auto& [key, e] : s.gt_sum) {
+        per_channel[key.first] += e.first;
+        top.emplace_back(e.first, key);
+    }
+    std::sort(top.rbegin(), top.rend());
+    std::string line;
+    for (const auto& [ch, ns] : per_channel) line += fmt::format(" ch {} {:.0f} ms/s;", ch, ns / 1e6 / secs);
+    LOG_INFO(HW_GPU, "Nx2 passthrough GPU time:{}", line);
+    for (size_t i = 0; i < std::min<size_t>(top.size(), 16); ++i) {
+        const auto& [ns, key] = top[i];
+        const NvU64 sig = key.second;
+        const char* kind = (sig >> 62) == 1 ? "compute" : (sig >> 62) == 2 ? "draws, pixel" : "other";
+        LOG_INFO(HW_GPU, "Nx2 passthrough GPU time: ch {} {} {:#x}: {:.1f} ms/s in {:.0f} submissions/s", key.first,
+                 kind, sig & ((NvU64{1} << 62) - 1), ns / 1e6 / secs, s.gt_sum[key].second / secs);
+    }
+    s.gt_sum.clear();
+    s.gt_since = now;
+}
