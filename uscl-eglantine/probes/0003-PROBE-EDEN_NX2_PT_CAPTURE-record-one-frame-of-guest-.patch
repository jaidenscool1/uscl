+// PROBE (EDEN_NX2_PT_CAPTURE): as FrontMacroEngine / FrontMacroPositions choose.
+std::span<const u32> KeplerCompute::PtNativeMacroPositions() const {
+    const bool uploaded = front ? front->compute_uploaded : native_compute_uploaded;
+    if (native_context) {
+        return uploaded ? std::span<const u32>{native_context->compute_positions}
+                        : std::span<const u32>{native_context->positions};
+    }
+    return native_macro_positions;
+}
+
+std::span<const u32> KeplerCompute::PtNativeMacroCode() const {
+    const bool uploaded = front ? front->compute_uploaded : native_compute_uploaded;
+    if (native_context) {
+        return uploaded ? std::span<const u32>{native_context->compute_engine.native_code}
+                        : std::span<const u32>{native_context->engine.native_code};
+    }
+    const MacroEngine* macro = front ? front->macro : native_macro;
+    return macro ? std::span<const u32>{macro->native_code} : std::span<const u32>{};
+}
