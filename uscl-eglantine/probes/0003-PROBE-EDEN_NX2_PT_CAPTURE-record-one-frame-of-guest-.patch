+// SPDX-FileCopyrightText: Copyright 2026 Eglantine Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// PROBE: EDEN_NX2_PT_CAPTURE=<dir> records one frame's guest GPU work for the passthrough replay
+// (USCL uscl-eglantine/passthrough): every command list entry as executed, each channel's engine
+// state and macro RAM when it is first seen, the GPU VA map and the device memory behind it.
+// Touch <dir>/capture.now while playing: recording starts at the next present and stops two
+// presents later. Nothing happens without the variable.
+#pragma once
+
+#include "common/common_types.h"
+
+namespace Tegra::PtCapture {
+
+bool Enabled();
+void NoteMap(const void* memory_manager, u64 gpu_addr, u64 dev_addr, u64 size, u32 kind, bool sparse);
+void NoteUnmap(const void* memory_manager, u64 gpu_addr, u64 size);
+/// The PTE kinds the guest asks for (nx2:gpu 212, 216; Eglantine maps everything as pitch), from boot:
+/// written as kinds.txt with the capture. 0xff/0xff forgets the range (a plain map or an unmap).
+void NoteGuestKind(u64 gpu_addr, u64 size, u32 kind, u32 fallback_kind);
+/// Guest CPU side, once per present.
+void NotePresent();
+/// The inline QMD the compute engine writes to memory (LOAD_INLINE_QMD_DATA(63)), while recording.
+void NoteInlineQmd(u64 gpu_addr, const u32* words);
+/// Compute macro trace while recording (mme.txt): 'C' call (start, parameter count), 'R' register read,
+/// 'E' emitted method.
+bool Recording();
+void NoteMme(char kind, u32 a, u32 v);
+/// Guest bytes the GPU back read for the entry being executed, while recording: deltas.bin, so the
+/// replay sees what the guest CPU wrote mid-frame. `site` (top 4 bits of the record's entry) says
+/// where: 0 uniform bank pages whose contents changed, 1 buffer uploads, 2 uniform binds, 3 texture
+/// uploads. A record equal to the last one at the same address is dropped. Recording drains the
+/// split at each entry so the back's entry is the front's.
+void NoteCpuData(u64 device_addr, const u8* data, u32 size, u32 site = 0);
+/// As NoteCpuData for bytes read at a GPU VA (texture uploads), split over the VA map.
+void NoteGpuData(const void* memory_manager, u64 gpu_addr, const u8* data, u64 size, u32 site);
+/// True while a dump flushes the host caches: the rasterizer then reports GPU-written images as dirty
+/// at every accuracy level (normally only GPU accuracy High does), so render targets and other images
+/// the GPU wrote in earlier frames reach the dump instead of stale guest memory.
+bool Dumping();
+/// A texture header or sampler the texture cache read while recording (descriptors.txt): the replay
+/// transcodes only the textures the frame samples (ASTC: the host has no ASTC sampling).
+void NoteDescriptor(u64 gpu_addr);
+
+} // namespace Tegra::PtCapture
