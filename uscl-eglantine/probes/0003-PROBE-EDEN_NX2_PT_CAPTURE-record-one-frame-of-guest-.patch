index 000000000..e9d46b2aa
--- /dev/null
+++ b/src/video_core/nx2_pt_capture.cpp
@@ -0,0 +1,528 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eglantine Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// PROBE: see nx2_pt_capture.h. Files in <dir>:
+//   maps.txt        "mm gpu dev size kind sparse" (hex) for every GPU mapping when recording starts
+//   kinds.txt       "gpu size kind fallback_kind" (hex): the PTE kinds the guest asked for (NoteGuestKind)
+//   dev-<addr>.bin  device memory, one file per coalesced device range of those mappings
+//   state-<ch>.bin  per channel, when its first entry is recorded (layout in WriteState)
+//   stream.bin      entries in execution order: u32 'PTE1', s32 channel, u64 gpu address,
+//                   u32 words, u32 dma state (method | subchannel << 16), u32 method count, words
+//   end-maps.txt, end-dev-<addr>.bin   the same when recording stops (after the frame)
+//   qmds.bin        inline QMDs the compute engine wrote: u32 entry, u64 gpu address, u32 words[64]
+//   mme.txt         compute macro trace: "<entry> C <start> <parameter count>", "R <reg> <value>",
+//                   "E <method> <value>" (hex)
+//   deltas.bin      guest bytes the back read per entry (NoteCpuData): u32 entry (top 4 bits: site),
+//                   u64 device address, u32 size, bytes
+//   descriptors.txt GPU addresses of the texture headers and samplers read while recording (hex)
+//   snap-<entry>-<gpu>.bin  EDEN_NX2_PT_CAPTURE_SNAP=<entry>[-<last>[/<step>]]:<gpu>:<size>[,...] (hex gpu/size):
+//                   those GPU ranges flushed and read right after that entry ran (per-pass references for the replay)
+//   done.txt        written when recording stops (first/last present, entry count)
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <map>
+#include <mutex>
+#include <set>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include "common/cityhash.h"
+#include "common/logging.h"
+#include "core/core.h"
+#include "video_core/control/channel_state.h"
+#include "video_core/dma_pusher.h"
+#include "video_core/engines/kepler_compute.h"
+#include "video_core/engines/maxwell_3d.h"
+#include "video_core/gpu_split.h"
+#include "video_core/memory_manager.h"
+#include "video_core/nx2_pt_capture.h"
+
+namespace Tegra::PtCapture {
+namespace {
+
+std::atomic<bool> dumping{false};
+
+struct Range {
+    u64 size;
+    u64 dev;
+    u32 kind;
+    bool sparse;
+};
+
+enum class Phase { Idle, Armed, Recording, Stopping, Done };
+
+struct State {
+    std::mutex mutex;
+    std::filesystem::path dir;
+    std::map<const void*, std::map<u64, Range>> maps;
+    std::map<u64, Range> guest_kinds; // dev = the fallback kind
+    std::atomic<Phase> phase{Phase::Idle};
+    u64 presents = 0, first_present = 0;
+    std::FILE* stream = nullptr;
+    std::FILE* qmds = nullptr;
+    std::FILE* mme = nullptr;
+    std::FILE* deltas = nullptr;
+    std::set<s32> channels_seen;
+    std::set<u64> descriptors;
+    std::unordered_map<u64, u64> noted; // device address -> hash of the last delta written there
+    u64 entries = 0;
+};
+
+State& Get() {
+    static State state;
+    return state;
+}
+
+const char* Dir() {
+    static const char* const dir = std::getenv("EDEN_NX2_PT_CAPTURE");
+    return dir != nullptr && *dir != '\0' ? dir : nullptr;
+}
+
+void EraseRange(std::map<u64, Range>& map, u64 gpu, u64 size) {
+    const u64 end = gpu + size;
+    auto it = map.lower_bound(gpu);
+    if (it != map.begin()) {
+        --it;
+    }
+    while (it != map.end() && it->first < end) {
+        const u64 b = it->first, e = b + it->second.size;
+        if (e <= gpu) {
+            ++it;
+            continue;
+        }
+        const Range r = it->second;
+        it = map.erase(it);
+        if (b < gpu) {
+            map.emplace(b, Range{gpu - b, r.dev, r.kind, r.sparse});
+        }
+        if (e > end) {
+            map.emplace(end, Range{e - end, r.sparse ? 0 : r.dev + (end - b), r.kind, r.sparse});
+        }
+    }
+}
+
+void DumpMemory(State& s, MemoryManager& memory_manager, const char* prefix) {
+    // What the GPU wrote in earlier frames (inline QMDs, uploads, render targets) is in the host caches,
+    // not guest memory, until flushed: flush every dirty mapped range first. The caches belong to the
+    // split's back, so the flush runs there (as DmaPusher::FlushGpuWrittenCommands does).
+    auto& split = VideoCommon::GpuSplit::Get();
+    split.Drain(VideoCommon::DrainSite::ListFlush);
+    dumping = true;
+    u64 flushed = 0;
+    for (const auto& [mm, map] : s.maps) {
+        if (mm != &memory_manager) {
+            continue;
+        }
+        for (const auto& [gpu, r] : map) {
+            if (r.sparse || !memory_manager.IsMemoryDirty(gpu, r.size, VideoCommon::CacheType::All)) {
+                continue;
+            }
+            const auto flush = [memory = &memory_manager, gpu, size = r.size] {
+                memory->FlushRegion(gpu, size, VideoCommon::CacheType::All);
+            };
+            if (split.Active()) {
+                split.Run(flush, VideoCommon::DrainSite::ListFlush);
+            } else {
+                flush();
+            }
+            flushed += r.size;
+        }
+    }
+    dumping = false;
+    LOG_WARNING(HW_GPU, "pt capture: flushed {} MiB of dirty mappings", flushed >> 20);
+    std::FILE* maps_file = std::fopen((s.dir / fmt::format("{}maps.txt", prefix)).string().c_str(), "w");
+    std::vector<std::pair<u64, u64>> dev;
+    for (const auto& [mm, map] : s.maps) {
+        for (const auto& [gpu, r] : map) {
+            if (maps_file) {
+                fmt::print(maps_file, "{:x} {:x} {:x} {:x} {:x} {}\n", reinterpret_cast<uintptr_t>(mm),
+                           gpu, r.dev, r.size, r.kind, r.sparse ? 1 : 0);
+            }
+            if (!r.sparse) {
+                dev.emplace_back(r.dev, r.dev + r.size);
+            }
+        }
+    }
+    if (maps_file) {
+        std::fclose(maps_file);
+    }
+    if (std::FILE* f = std::fopen((s.dir / fmt::format("{}kinds.txt", prefix)).string().c_str(), "w")) {
+        for (const auto& [gpu, r] : s.guest_kinds) {
+            fmt::print(f, "{:x} {:x} {:x} {:x}\n", gpu, r.size, r.kind, r.dev);
+        }
+        std::fclose(f);
+    }
+    std::sort(dev.begin(), dev.end());
+    std::vector<std::pair<u64, u64>> merged;
+    for (const auto& d : dev) {
+        if (!merged.empty() && d.first <= merged.back().second) {
+            merged.back().second = std::max(merged.back().second, d.second);
+        } else {
+            merged.push_back(d);
+        }
+    }
+    std::vector<u8> chunk(16 << 20);
+    u64 total = 0;
+    for (const auto& [b, e] : merged) {
+        std::FILE* f = std::fopen((s.dir / fmt::format("{}dev-{:x}.bin", prefix, b)).string().c_str(), "wb");
+        if (!f) {
+            continue;
+        }
+        for (u64 a = b; a < e; a += chunk.size()) {
+            const u64 n = std::min<u64>(chunk.size(), e - a);
+            memory_manager.PtReadDeviceUnsafe(a, chunk.data(), n);
+            std::fwrite(chunk.data(), 1, n, f);
+        }
+        std::fclose(f);
+        total += e - b;
+    }
+    LOG_WARNING(HW_GPU, "pt capture: {} device ranges, {} MiB", merged.size(), total >> 20);
+}
+
+void Snapshots(State& s, MemoryManager& memory_manager, u64 entry) {
+    struct Snap {
+        u64 first, last, step, gpu, size;
+    };
+    static const std::vector<Snap> snaps = [] {
+        std::vector<Snap> out;
+        const char* text = std::getenv("EDEN_NX2_PT_CAPTURE_SNAP");
+        for (const char* p = text; p && *p;) {
+            Snap snap{};
+            char* end = nullptr;
+            snap.first = snap.last = std::strtoull(p, &end, 10);
+            snap.step = 1;
+            if (*end == '-') snap.last = std::strtoull(end + 1, &end, 10);
+            if (*end == '/') snap.step = std::max<u64>(std::strtoull(end + 1, &end, 10), 1);
+            if (*end++ != ':') break;
+            snap.gpu = std::strtoull(end, &end, 16);
+            if (*end++ != ':') break;
+            snap.size = std::strtoull(end, &end, 16);
+            out.push_back(snap);
+            p = *end == ',' ? end + 1 : end;
+        }
+        return out;
+    }();
+    auto& split = VideoCommon::GpuSplit::Get();
+    for (const Snap& snap : snaps) {
+        if (entry < snap.first || entry > snap.last || (entry - snap.first) % snap.step != 0) {
+            continue;
+        }
+        dumping = true;
+        const auto flush = [memory = &memory_manager, snap] {
+            memory->FlushRegion(snap.gpu, snap.size, VideoCommon::CacheType::All);
+        };
+        if (split.Active()) {
+            split.Run(flush, VideoCommon::DrainSite::ListFlush);
+        } else {
+            flush();
+        }
+        dumping = false;
+        std::vector<u8> data(snap.size);
+        memory_manager.ReadBlockUnsafe(snap.gpu, data.data(), data.size());
+        if (std::FILE* f = std::fopen((s.dir / fmt::format("snap-{}-{:x}.bin", entry, snap.gpu)).string().c_str(), "wb")) {
+            std::fwrite(data.data(), 1, data.size(), f);
+            std::fclose(f);
+        }
+    }
+}
+
+template <typename T>
+void Put(std::FILE* f, const T& v) {
+    std::fwrite(&v, sizeof(T), 1, f);
+}
+
+} // Anonymous namespace
+
+bool Enabled() {
+    return Dir() != nullptr;
+}
+
+void NoteMap(const void* memory_manager, u64 gpu_addr, u64 dev_addr, u64 size, u32 kind, bool sparse) {
+    if (!Enabled() || size == 0) {
+        return;
+    }
+    State& s = Get();
+    std::scoped_lock lk{s.mutex};
+    auto& map = s.maps[memory_manager];
+    EraseRange(map, gpu_addr, size);
+    map.emplace(gpu_addr, Range{size, dev_addr, kind, sparse});
+}
+
+void NoteUnmap(const void* memory_manager, u64 gpu_addr, u64 size) {
+    if (!Enabled() || size == 0) {
+        return;
+    }
+    State& s = Get();
+    std::scoped_lock lk{s.mutex};
+    EraseRange(s.maps[memory_manager], gpu_addr, size);
+}
+
+void NoteGuestKind(u64 gpu_addr, u64 size, u32 kind, u32 fallback_kind) {
+    if (!Enabled() || size == 0) {
+        return;
+    }
+    State& s = Get();
+    std::scoped_lock lk{s.mutex};
+    EraseRange(s.guest_kinds, gpu_addr, size);
+    if (kind != 0xff) {
+        s.guest_kinds.emplace(gpu_addr, Range{size, fallback_kind, kind, false});
+    }
+}
+
+void NotePresent() {
+    if (!Enabled()) {
+        return;
+    }
+    State& s = Get();
+    std::scoped_lock lk{s.mutex};
+    ++s.presents;
+    const Phase phase = s.phase.load();
+    if (phase == Phase::Idle) {
+        s.dir = Dir();
+        std::error_code ec;
+        if (std::filesystem::remove(s.dir / "capture.now", ec)) {
+            s.first_present = s.presents;
+            s.phase = Phase::Armed;
+            LOG_WARNING(HW_GPU, "pt capture: armed at present {}", s.presents);
+        }
+    } else if (phase == Phase::Recording && s.presents >= s.first_present + 2) {
+        s.phase = Phase::Stopping;
+    }
+}
+
+bool Dumping() {
+    return dumping.load(std::memory_order_relaxed);
+}
+
+bool Recording() {
+    return Enabled() && Get().phase.load(std::memory_order_relaxed) == Phase::Recording;
+}
+
+void NoteMme(char kind, u32 a, u32 v) {
+    State& s = Get();
+    std::scoped_lock lk{s.mutex};
+    if (s.phase != Phase::Recording) {
+        return;
+    }
+    if (!s.mme) {
+        s.mme = std::fopen((s.dir / "mme.txt").string().c_str(), "w");
+    }
+    if (s.mme) {
+        fmt::print(s.mme, "{} {} {:x} {:x}\n", s.entries - 1, kind, a, v);
+    }
+}
+
+void PutDelta(State& s, u64 device_addr, const u8* data, u32 size, u32 site) {
+    if (!s.deltas || size == 0) {
+        return;
+    }
+    const u64 hash = Common::CityHash64(reinterpret_cast<const char*>(data), size) ^ size;
+    const auto [it, fresh] = s.noted.try_emplace(device_addr, hash);
+    if (!fresh && it->second == hash) {
+        return;
+    }
+    it->second = hash;
+    Put(s.deltas, static_cast<u32>(s.entries - 1) | (site << 28));
+    Put(s.deltas, device_addr);
+    Put(s.deltas, size);
+    std::fwrite(data, 1, size, s.deltas);
+}
+
+void NoteCpuData(u64 device_addr, const u8* data, u32 size, u32 site) {
+    State& s = Get();
+    if (s.phase.load(std::memory_order_relaxed) != Phase::Recording) {
+        return;
+    }
+    std::scoped_lock lk{s.mutex};
+    PutDelta(s, device_addr, data, size, site);
+}
+
+void NoteGpuData(const void* memory_manager, u64 gpu_addr, const u8* data, u64 size, u32 site) {
+    State& s = Get();
+    if (s.phase.load(std::memory_order_relaxed) != Phase::Recording) {
+        return;
+    }
+    std::scoped_lock lk{s.mutex};
+    const auto mm = s.maps.find(memory_manager);
+    if (mm == s.maps.end()) {
+        return;
+    }
+    const u64 end = gpu_addr + size;
+    auto it = mm->second.upper_bound(gpu_addr);
+    if (it != mm->second.begin()) {
+        --it;
+    }
+    for (; it != mm->second.end() && it->first < end; ++it) {
+        const u64 lo = (std::max)(gpu_addr, it->first), hi = (std::min)(end, it->first + it->second.size);
+        if (lo >= hi || it->second.sparse) {
+            continue; // sparse/unmapped pieces read zero in the replay too
+        }
+        for (u64 at = lo; at < hi; at += 0x40000000) { // u32 record sizes
+            PutDelta(s, it->second.dev + (at - it->first), data + (at - gpu_addr),
+                     static_cast<u32>((std::min<u64>)(hi - at, 0x40000000)), site);
+        }
+    }
+}
+
+void NoteDescriptor(u64 gpu_addr) {
+    State& s = Get();
+    std::scoped_lock lk{s.mutex};
+    if (s.phase == Phase::Recording) {
+        s.descriptors.insert(gpu_addr);
+    }
+}
+
+void NoteInlineQmd(u64 gpu_addr, const u32* words) {
+    State& s = Get();
+    if (s.phase.load(std::memory_order_relaxed) != Phase::Recording) {
+        return;
+    }
+    std::scoped_lock lk{s.mutex};
+    if (s.qmds) {
+        Put(s.qmds, static_cast<u32>(s.entries - 1)); // the entry being executed
+        Put(s.qmds, gpu_addr);
+        std::fwrite(words, sizeof(u32), 64, s.qmds);
+    }
+}
+
+} // namespace Tegra::PtCapture
+
+namespace Tegra {
+
+// Layout of state-<ch>.bin: u32 'PTS1', s32 channel, u64 memory manager, u32 bound engine per
+// subchannel [8], dma state (method, subchannel, method count, non-incrementing) [4],
+// u32 native_turing, Maxwell3D regs [0xE00], compute native (Ampere layout) registers [0x1000], MME instruction RAM
+// [0x8000], 3D start addresses [0x80], compute start addresses [0x80], MME data RAM [0xC00], 3D constant buffer bindings
+// [5 stages][18 slots] of {u32 enabled, u32 size, u64 address}, compute MME instruction RAM [0x8000].
+void DmaPusher::PtCaptureEntry(const CommandListHeader& header,
+                               std::span<const CommandHeader> commands) {
+    using namespace PtCapture;
+    State& s = Get();
+    const Phase phase = s.phase.load(std::memory_order_relaxed);
+    if (phase != Phase::Armed && phase != Phase::Recording && phase != Phase::Stopping) {
+        return;
+    }
+    if (phase == Phase::Recording) {
+        // The back finishes the previous entries first: what it notes (NoteCpuData, inline QMDs)
+        // belongs to the entry it executes, which is then s.entries - 1.
+        VideoCommon::GpuSplit::Get().Drain(VideoCommon::DrainSite::ListFlush);
+        if (s.entries > 0) {
+            Snapshots(s, memory_manager, s.entries - 1); // entry s.entries - 1 has run
+        }
+    }
+    std::scoped_lock lk{s.mutex};
+    if (s.phase == Phase::Stopping) {
+        // Memory again at the end: what the guest CPU wrote during the frame (QMD and uniform rings).
+        DumpMemory(s, memory_manager, "end-");
+        if (s.stream) {
+            std::fclose(s.stream);
+            s.stream = nullptr;
+        }
+        if (s.qmds) {
+            std::fclose(s.qmds);
+            s.qmds = nullptr;
+        }
+        if (s.deltas) {
+            std::fclose(s.deltas);
+            s.deltas = nullptr;
+        }
+        if (s.mme) {
+            std::fclose(s.mme);
+            s.mme = nullptr;
+        }
+        if (std::FILE* f = std::fopen((s.dir / "descriptors.txt").string().c_str(), "w")) {
+            for (const u64 addr : s.descriptors) {
+                fmt::print(f, "{:x}\n", addr);
+            }
+            std::fclose(f);
+        }
+        if (std::FILE* f = std::fopen((s.dir / "done.txt").string().c_str(), "w")) {
+            fmt::print(f, "first_present {}\nlast_present {}\nentries {}\nchannels {}\n",
+                       s.first_present, s.presents, s.entries, s.channels_seen.size());
+            std::fclose(f);
+        }
+        LOG_WARNING(HW_GPU, "pt capture: done, {} entries", s.entries);
+        s.phase = Phase::Done;
+        return;
+    }
+    if (s.phase == Phase::Armed) {
+        // Start at an entry boundary with no method split across entries.
+        if (dma_state.method_count != 0) {
+            return;
+        }
+        std::filesystem::create_directories(s.dir);
+        DumpMemory(s, memory_manager, "");
+        s.stream = std::fopen((s.dir / "stream.bin").string().c_str(), "wb");
+        if (!s.stream) {
+            s.phase = Phase::Done;
+            return;
+        }
+        std::setvbuf(s.stream, nullptr, _IOFBF, 4 << 20);
+        s.qmds = std::fopen((s.dir / "qmds.bin").string().c_str(), "wb");
+        s.deltas = std::fopen((s.dir / "deltas.bin").string().c_str(), "wb");
+        s.noted.clear();
+        if (s.deltas) {
+            std::setvbuf(s.deltas, nullptr, _IOFBF, 4 << 20);
+        }
+        s.phase = Phase::Recording;
+    }
+    const s32 channel = channel_state.bind_id;
+    if (s.channels_seen.insert(channel).second) {
+        auto& payload = *channel_state.payload;
+        auto& m3d = payload.maxwell_3d;
+        if (std::FILE* f = std::fopen((s.dir / fmt::format("state-{}.bin", channel)).string().c_str(), "wb")) {
+            Put(f, u32{0x31535450});
+            Put(f, channel);
+            Put(f, static_cast<u64>(reinterpret_cast<uintptr_t>(&memory_manager)));
+            for (const auto engine : puller.BoundEngines()) {
+                Put(f, static_cast<u32>(engine));
+            }
+            Put(f, dma_state.method);
+            Put(f, dma_state.subchannel);
+            Put(f, dma_state.method_count);
+            Put(f, u32{dma_state.non_incrementing});
+            auto& macro = m3d.GetNativeMacroEngine();
+            Put(f, u32{macro.native_turing});
+            Put(f, m3d.regs.reg_array);
+            Put(f, payload.kepler_compute.PtNativeRegisters());
+            Put(f, macro.native_code);
+            const auto put_positions = [f](std::span<const u32> p) {
+                std::array<u32, 0x80> a{};
+                std::copy_n(p.begin(), std::min<size_t>(p.size(), a.size()), a.begin());
+                Put(f, a);
+            };
+            put_positions(m3d.GetNativeMacroPositions());
+            put_positions(payload.kepler_compute.PtNativeMacroPositions());
+            Put(f, m3d.GetNativeDataRam());
+            for (const auto& stage : m3d.state.shader_stages) {
+                for (const auto& cb : stage.const_buffers) {
+                    Put(f, u32{cb.enabled});
+                    Put(f, cb.size);
+                    Put(f, static_cast<u64>(cb.address));
+                }
+            }
+            std::array<u32, 0x8000> compute_code{};
+            const auto code = payload.kepler_compute.PtNativeMacroCode();
+            std::copy_n(code.begin(), std::min(code.size(), compute_code.size()), compute_code.begin());
+            Put(f, compute_code);
+            std::fclose(f);
+        }
+    }
+    Put(s.stream, u32{0x31455450});
+    Put(s.stream, channel);
+    Put(s.stream, static_cast<u64>(header.addr));
+    Put(s.stream, static_cast<u32>(commands.size()));
+    Put(s.stream, dma_state.method | (dma_state.subchannel << 16));
+    Put(s.stream, dma_state.method_count);
+    std::fwrite(commands.data(), sizeof(CommandHeader), commands.size(), s.stream);
+    ++s.entries;
+}
+
+} // namespace Tegra
