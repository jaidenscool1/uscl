+/// EDEN_NX2_AB=<Nx2Perf switch name>: flips that switch every 20,000 draws and logs the cycles
+/// per draw spent in RasterizerVulkan::Draw with it on and off: an A/B inside one race, where both
+/// sides see the same scenes (fps A/Bs between runs carry +-6% of noise). Only for switches read
+/// through Nx2Perf::On at each use.
+[[nodiscard]] inline int AbSwitch() {
+    static const int index = [] {
+        const char* const name = std::getenv("EDEN_NX2_AB");
+        if (name == nullptr) {
+            return -1;
+        }
+        for (size_t i = 0; i < Nx2Perf::opt_names.size(); ++i) {
+            if (Nx2Perf::opt_names[i] == name) {
+                (void)Nx2Perf::On(static_cast<Nx2Perf::Opt>(i)); // initializes the live mask
+                return static_cast<int>(i);
+            }
+        }
+        LOG_WARNING(HW_GPU, "EDEN_NX2_AB: unknown switch {}", name);
+        return -1;
+    }();
+    return index;
+}
+
+class AbTimer {
+public:
+    AbTimer() : index{AbSwitch()} {
+        if (index >= 0) [[unlikely]] {
+            start = Cycles();
+        }
+    }
+    ~AbTimer() {
+        if (index < 0) [[likely]] {
+            return;
+        }
+        const u64 elapsed = Cycles() - start;
+        auto& mask = Nx2Perf::detail::live_off_mask;
+        const u64 bit = u64{1} << index;
+        const bool on = (mask.load(std::memory_order_relaxed) & bit) == 0;
+        static std::array<u64, 2> cycles{}, draws{};
+        static u64 total{};
+        cycles[on] += elapsed;
+        ++draws[on];
+        if (++total % 20000 != 0) {
+            return;
+        }
+        mask.fetch_xor(bit, std::memory_order_relaxed);
+        if (total % 400000 == 0) {
+            const double off_cpd = static_cast<double>(cycles[0]) / static_cast<double>(draws[0]);
+            const double on_cpd = static_cast<double>(cycles[1]) / static_cast<double>(draws[1]);
+            LOG_INFO(HW_GPU, "nx2 A/B {}: on {:.0f} cycles/draw, off {:.0f} ({} draws): {:+.2f}%",
+                     Nx2Perf::opt_names[index], on_cpd, off_cpd, total,
+                     100.0 * (on_cpd - off_cpd) / off_cpd);
+        }
+    }
+    AbTimer(const AbTimer&) = delete;
+    AbTimer& operator=(const AbTimer&) = delete;
+
+private:
+    int index;
+    u64 start{};
+};
+
+/// PROBE EDEN_NX2_UBO_LIVE_PROBE: device pages written by inline GPU writes (WriteBlockCached).
+inline std::mutex g_inline_pages_mutex;
+inline std::unordered_set<u64> g_inline_pages;
+[[nodiscard]] inline bool LiveProbeOn() {
+    static const bool on = std::getenv("EDEN_NX2_UBO_LIVE_PROBE") != nullptr;
+    return on;
+}
+inline void NoteInlineWrite(u64 device_addr, u64 size) {
+    std::scoped_lock lock{g_inline_pages_mutex};
+    for (u64 page = device_addr >> 12; page <= (device_addr + size - 1) >> 12; ++page) {
+        g_inline_pages.insert(page);
+    }
+}
+[[nodiscard]] inline bool InlineWritten(u64 device_addr, u64 size) {
+    std::scoped_lock lock{g_inline_pages_mutex};
+    for (u64 page = device_addr >> 12; page <= (device_addr + size - 1) >> 12; ++page) {
+        if (g_inline_pages.contains(page)) {
+            return true;
+        }
+    }
+    return false;
+}
