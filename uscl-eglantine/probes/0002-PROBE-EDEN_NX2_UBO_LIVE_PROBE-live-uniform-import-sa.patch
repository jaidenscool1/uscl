@@ -95,6 +96,67 @@ inline void ResetUniformStreamReuse() noexcept {
 /// buffer, reusing the slot's previous allocation when the bytes and the command buffer are the
 /// same. Returns false (nothing bound) when the buffer does not qualify, so the caller binds it
 /// the classic way.
+/// PROBE EDEN_NX2_UBO_LIVE_PROBE=1: would binding small uniforms straight from guest memory (no
+/// copy, the host GPU reads it when it runs) see the bytes the copy took? Each bind's bytes are
+/// hashed and checked again once the GPU has finished its tick; logs the share that changed (an
+/// upper bound: a legitimate rewrite right after the GPU finished also counts) and how many host
+/// pointers meet the uniform offset alignment.
+template <class Runtime, class DeviceMemory>
+inline void UniformLiveProbe(Runtime& runtime, DeviceMemory& device_memory, u64 device_addr,
+                             const u8* bytes, u32 size) {
+    // =1: check once the GPU finished the tick; =2: once the tick was submitted (a lower bound);
+    // =3: as 1, reading the GPU tick at every bind (completion seen within one bind).
+    static const char mode = [] {
+        const char* value = std::getenv("EDEN_NX2_UBO_LIVE_PROBE");
+        return value != nullptr ? value[0] : '0';
+    }();
+    if (mode == '0') {
+        return;
+    }
+    struct Entry {
+        u64 addr, hash, tick;
+        u32 size;
+    };
+    static std::array<Entry, 1u << 16> ring;
+    static u64 head = 0, tail = 0, checked = 0, changed = 0, aligned = 0, binds = 0;
+    static u64 inline_binds = 0, changed_inline = 0;
+    static std::array<u8, 4096> again;
+    ++binds;
+    const u8* const host = device_memory.GetSpan(device_addr, size);
+    aligned += host != nullptr && (reinterpret_cast<uintptr_t>(host) & 0xff) == 0 ? 1 : 0;
+    inline_binds += Nx2DrawStats::InlineWritten(device_addr, size) ? 1 : 0;
+    if (head - tail < ring.size()) {
+        ring[head++ % ring.size()] =
+            Entry{device_addr, Nx2DrawStats::HashBytes(bytes, size), runtime.CurrentTick(), size};
+    }
+    if (mode == '3') {
+        runtime.RefreshGpuTick();
+    }
+    const u64 current = runtime.CurrentTick();
+    while (tail != head && (mode == '2' ? ring[tail % ring.size()].tick < current
+                                        : runtime.IsFree(ring[tail % ring.size()].tick))) {
+        const Entry& entry = ring[tail++ % ring.size()];
+        device_memory.ReadBlockUnsafe(entry.addr, again.data(), entry.size);
+        ++checked;
+        if (Nx2DrawStats::HashBytes(again.data(), entry.size) != entry.hash) {
+            ++changed;
+            changed_inline += Nx2DrawStats::InlineWritten(entry.addr, entry.size) ? 1 : 0;
+        }
+        if (checked % 500000 == 0) {
+            LOG_INFO(HW_GPU,
+                     "nx2 ubo live probe: {} binds, {:.1f}% host pointer 256-aligned; {} checked "
+                     "after their tick, {:.3f}% changed; on inline-written pages: {:.1f}% of "
+                     "binds, {:.1f}% of the changed",
+                     binds, 100.0 * static_cast<double>(aligned) / static_cast<double>(binds),
+                     checked, 100.0 * static_cast<double>(changed) / static_cast<double>(checked),
+                     100.0 * static_cast<double>(inline_binds) / static_cast<double>(binds),
+                     changed == 0 ? 0.0
+                                  : 100.0 * static_cast<double>(changed_inline) /
+                                        static_cast<double>(changed));
+        }
+    }
+}
+
 template <class Runtime, class DeviceMemory>
 [[nodiscard]] bool BindSmallUniformReusing(Runtime& runtime, DeviceMemory& device_memory,
                                            size_t stage, u32 index, u32 binding_index,
@@ -108,6 +170,7 @@ template <class Runtime, class DeviceMemory>
     typename Reuse::Slot& slot = reuse.slots[stage][index];
