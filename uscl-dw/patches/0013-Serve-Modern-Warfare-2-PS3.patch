diff --git a/libbitdemon/src/lobby/mw2.rs b/libbitdemon/src/lobby/mw2.rs
new file mode 100644
index 0000000..edec67c
--- /dev/null
+++ b/libbitdemon/src/lobby/mw2.rs
@@ -0,0 +1,432 @@
+//! Modern Warfare 2 (PS3)'s lobby. Its older Demonware writes tasks and expects replies as bit buffers (a type-checked
+//! bit, then 5-bit type tags, values LSB first), numbers tasks its own way, and matches replies to tasks first in,
+//! first out, so every task gets an answer. Layouts from github.com/elliot1377/mw2-ps3-server (MIT), checked against
+//! the 1.14 BLUS30377 executable. Matchmaking replies (echoed task id, one count) follow github.com/Tustin/mw2-rpcs3's
+//! notes on the game's parser.
+
+use crate::domain::title::Title;
+use crate::lobby::response::BdMessageType;
+use crate::lobby::storage::{
+    FileVisibility, StorageFileInfo, ThreadSafePublisherStorageService, ThreadSafeUserStorageService,
+};
+use crate::messaging::BdErrorCode;
+use crate::messaging::bd_reader::BdReader;
+use crate::messaging::bd_response::BdResponse;
+use crate::messaging::bd_writer::BdWriter;
+use crate::messaging::StreamMode;
+use crate::networking::bd_session::{BdSession, SessionId};
+use crate::networking::session_manager::SessionManager;
+use log::{debug, info, warn};
+use num_traits::ToPrimitive;
+use std::error::Error;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+
+const STORAGE: u8 = 10;
+// The player's own files are shown with ids from here, publisher files below it: task 5 downloads both by id
+const USER_FILE: u64 = 1 << 32;
+const STATS_FILE: &str = "iw4-mpdata";
+const MATCHMAKING: u8 = 5;
+const BANDWIDTH_TEST: u8 = 18;
+
+// task reply result types
+const RESULT_NONE: u8 = 0;
+const RESULT_SINGLE: u8 = 1;
+const RESULT_LIST: u8 = 4;
+const RESULT_FILE_LIST: u8 = 7;
+
+type Body<'a> = &'a dyn Fn(&mut BdWriter) -> Result<(), Box<dyn Error>>;
+
+struct GameSession {
+    connection: SessionId,
+    id: Vec<u8>,
+    key: Vec<u8>,
+    host_addr: Vec<u8>,
+    info: Vec<i32>,
+}
+
+pub struct Mw2Lobby {
+    publisher_files: Arc<ThreadSafePublisherStorageService>,
+    user_files: Arc<ThreadSafeUserStorageService>,
+    sessions: Mutex<Vec<GameSession>>,
+    transaction: AtomicU64,
+}
+
+pub fn is_mw2(session: &BdSession) -> bool {
+    session.authentication().is_some_and(|a| a.title == Title::Iw4Ps3)
+}
+
+impl Mw2Lobby {
+    pub fn new(
+        publisher_files: Arc<ThreadSafePublisherStorageService>,
+        user_files: Arc<ThreadSafeUserStorageService>,
+        session_manager: Arc<SessionManager>,
+    ) -> Arc<Mw2Lobby> {
+        let lobby = Arc::new(Mw2Lobby {
+            publisher_files,
+            user_files,
+            sessions: Mutex::new(Vec::new()),
+            transaction: AtomicU64::new(1),
+        });
+        let weak = Arc::downgrade(&lobby);
+        session_manager.on_session_unregistered(move |connection| {
+            if let Some(lobby) = weak.upgrade() {
+                lobby.sessions.lock().unwrap().retain(|s| s.connection != connection.id);
+            }
+        });
+        lobby
+    }
+
+    /// Answers one task; `reader` is positioned after the service id.
+    pub fn handle(&self, session: &mut BdSession, service: u8, mut reader: BdReader) -> Result<(), Box<dyn Error>> {
+        let mut response = match service {
+            BANDWIDTH_TEST => self.bandwidth_test(reader.remaining_data().len()),
+            _ => {
+                reader.set_mode(StreamMode::BitMode);
+                reader.read_type_checked_bit()?;
+                let task = reader.read_u8()?;
+                let data = reader.remaining_data().to_vec();
+                self.task(session, service, task, &mut reader).unwrap_or_else(|e| {
+                    warn!("MW2 service {service} task {task} not understood ({e}): {:02x?}", &data[..data.len().min(64)]);
+                    self.reply(RESULT_LIST, &empty)
+                })
+            }
+        }?;
+        response.send(session)
+    }
+
+    fn task(
+        &self,
+        session: &BdSession,
+        service: u8,
+        task: u8,
+        r: &mut BdReader,
+    ) -> Result<Result<BdResponse, Box<dyn Error>>, Box<dyn Error>> {
+        Ok(match (service, task) {
+            (STORAGE, 8) => {
+                let files = self.files(session);
+                self.reply(RESULT_FILE_LIST, &|w| {
+                    w.write_u32(files.len() as u32)?;
+                    for (id, file) in &files {
+                        w.write_u32(file.file_size as u32)?;
+                        file_header(w, *id, file)?;
+                    }
+                    Ok(())
+                })
+            }
+            // The stats download starts here: the game looks for its stats file among its files, then gets it by id.
+            // Error 1000 ("no such file") tells it this player has none yet: it starts from zero and uploads later.
+            (STORAGE, 7) => {
+                let me = session.authentication().unwrap().user_id;
+                let files = self.user_files.list_storage_files(session, me, 0, 0, 100).map(|s| s.into_data()).unwrap_or_default();
+                if files.is_empty() {
+                    return Ok(self.error(BdErrorCode::NoFile));
+                }
+                self.reply(RESULT_FILE_LIST, &|w| {
+                    w.write_u32(files.len() as u32)?;
+                    for file in &files {
+                        w.write_u32(file.file_size as u32)?;
+                        file_header(w, file.id + USER_FILE, file)?;
+                    }
+                    Ok(())
+                })
+            }
+            (STORAGE, 5) => {
+                r.read_u8()?;
+                let id = r.read_u64()?;
+                if id >= USER_FILE {
+                    let me = session.authentication().unwrap().user_id;
+                    let found = self.user_files.list_storage_files(session, me, 0, 0, 100).map(|s| s.into_data()).unwrap_or_default();
+                    let Some(file) = found.into_iter().find(|f| f.id == id - USER_FILE) else {
+                        return Ok(self.error(BdErrorCode::NoFile));
+                    };
+                    let data = self.user_files.get_storage_file_data_by_id(session, me, file.id).map_err(|e| format!("{e:?}"))?;
+                    info!("MW2: {} loaded {}", username(session), file.filename);
+                    return Ok(self.reply(RESULT_SINGLE, &|w| {
+                        w.write_u32(1)?;
+                        file_header(w, id, &file)?;
+                        w.write_blob(&data)
+                    }));
+                }
+                let Some((_, file)) = self.files(session).into_iter().find(|(i, _)| *i == id) else {
+                    return Ok(self.reply(RESULT_NONE, &empty));
+                };
+                let data = self
+                    .publisher_files
+                    .get_publisher_file_data(session, file.filename.clone())
+                    .map_err(|e| format!("{e:?}"))?;
+                info!("MW2: sent {} ({} bytes)", file.filename, data.len());
+                self.reply(RESULT_SINGLE, &|w| {
+                    w.write_u32(1)?;
+                    file_header(w, id, &file)?;
+                    w.write_blob(&data)
+                })
+            }
+            // The player's own files (the stats file). MW2 names the owner by a hash of its online id; we always use
+            // the signed-in user, so nobody reads or writes someone else's stats.
+            (STORAGE, 3) => {
+                r.read_u8()?;
+                r.read_u64()?;
+                let name = r.read_str()?;
+                let me = session.authentication().unwrap().user_id;
+                let found = self.user_files.list_storage_files(session, me, 0, 0, 100).map(|s| s.into_data()).unwrap_or_default();
+                let Some(file) = found.into_iter().find(|f| f.filename == name) else {
+                    // "no such file": a new player, the game starts from zeroed stats and uploads them later
+                    return Ok(self.error(BdErrorCode::NoFile));
+                };
+                let data = self.user_files.get_storage_file_data_by_id(session, me, file.id).map_err(|e| format!("{e:?}"))?;
+                self.reply(RESULT_SINGLE, &|w| {
+                    w.write_u32(1)?;
+                    file_header(w, file.id, &file)?;
+                    w.write_blob(&data)
+                })
+            }
+            (STORAGE, 1) => {
+                r.read_u8()?;
+                r.read_bool()?;
+                let name = r.read_str()?;
+                r.read_bool()?;
+                let data = r.read_blob()?;
+                let me = session.authentication().unwrap().user_id;
+                let found = self.user_files.list_storage_files(session, me, 0, 0, 100).map(|s| s.into_data()).unwrap_or_default();
+                let result = match found.into_iter().find(|f| f.filename == name) {
+                    Some(f) => self.user_files.update_storage_file_data(session, me, f.id, data),
+                    None => self.user_files.create_storage_file(session, me, name.clone(), FileVisibility::VisiblePrivate, data).map(|_| ()),
+                };
+                if let Err(e) = result {
+                    warn!("MW2: {} could not save {name}: {e:?}", username(session));
+                    return Ok(self.error(BdErrorCode::PermissionDenied));
+                }
+                info!("MW2: {} saved {name}", username(session));
+                self.reply(RESULT_LIST, &empty)
+            }
+            (STORAGE, 2) => {
+                r.read_u8()?;
+                let id = r.read_u64()?.wrapping_sub(USER_FILE);
+                let data = r.read_blob()?;
+                let me = session.authentication().unwrap().user_id;
+                let files = self.user_files.list_storage_files(session, me, 0, 0, 100).map(|s| s.into_data()).unwrap_or_default();
+                // A new player's game updates file 0 rather than creating its stats file: save it as that
+                let result = match files.iter().find(|f| f.id == id).or(files.iter().find(|f| f.filename == STATS_FILE)) {
+                    Some(f) => self.user_files.update_storage_file_data(session, me, f.id, data),
+                    None => self
+                        .user_files
+                        .create_storage_file(session, me, STATS_FILE.into(), FileVisibility::VisiblePrivate, data)
+                        .map(|_| ()),
+                };
+                if let Err(e) = result {
+                    warn!("MW2: {} could not update file {id}: {e:?}", username(session));
+                    return Ok(self.error(BdErrorCode::PermissionDenied));
+                }
+                info!("MW2: {} saved their stats", username(session));
+                self.reply(RESULT_LIST, &empty)
+            }
+            (MATCHMAKING, 1) => {
+                let (host_addr, _, _, info) = read_session_info(r)?;
+                let (id, key) = (rand::random::<[u8; 8]>().to_vec(), rand::random::<[u8; 16]>().to_vec());
+                let reply = self.reply(task, &|w| {
+                    w.write_u32(1)?;
+                    w.write_blob(&id)?;
+                    w.write_blob(&key)
+                });
+                info!("MW2: {} hosts a game at {:02x?} {info:?}", username(session), host_addr);
+                let connection = session.id;
+                self.sessions.lock().unwrap().push(GameSession { connection, id, key, host_addr, info });
+                reply
+            }
+            (MATCHMAKING, 2) => {
+                let (host_addr, id, _, info) = read_session_info(r)?;
+                if let Some(s) = self.sessions.lock().unwrap().iter_mut().find(|s| s.id == id && s.connection == session.id) {
+                    (s.host_addr, s.info) = (host_addr, info);
+                }
+                self.reply(task, &|_| Ok(()))
+            }
+            (MATCHMAKING, 3) => {
+                if r.next_is_u8()? {
+                    r.read_u8()?;
+                }
+                let id = r.read_blob()?;
+                self.sessions.lock().unwrap().retain(|s| !(s.id == id && s.connection == session.id));
+                self.reply(task, &|_| Ok(()))
+            }
+            (MATCHMAKING, 5) => {
+                r.read_u8()?;
+                let mut wanted = Vec::new();
+                while wanted.len() < 32 && r.next_is_i32().unwrap_or(false) {
+                    wanted.push(r.read_i32()?);
+                }
+                let sessions = self.sessions.lock().unwrap();
+                let found: Vec<&GameSession> =
+                    sessions.iter().filter(|s| s.connection != session.id && compatible(&s.info, &wanted)).collect();
+                debug!("MW2: {} looks for {wanted:?}: {} game(s)", username(session), found.len());
+                self.reply(task, &|w| {
+                    w.write_u32(found.len() as u32)?;
+                    for s in &found {
+                        w.write_blob(&s.host_addr)?;
+                        w.write_blob(&s.id)?;
+                        w.write_blob(&s.key)?;
+                        for v in &s.info {
+                            w.write_i32(*v)?;
+                        }
+                    }
+                    Ok(())
+                })
+            }
+            // user files, stats and the rest: OK with no results, which the game takes as "nothing yet"
+            _ => {
+                let data = r.remaining_data();
+                debug!("MW2: service {service} task {task} answered empty: {:02x?}", &data[..data.len().min(48)]);
+                self.reply(RESULT_LIST, &empty)
+            }
+        })
+    }
+
+    /// Service 18, plain little-endian bytes answered with message type 5. Phase 1 (19 bytes) gets the test
+    /// setup: the client then sends 5 x 512 bytes to our UDP 3074 (the NAT discovery socket ignores them). Finalize
+    /// (5 x u32 of its own, so longer) gets the measurement. The host computes its upload from it, and below
+    /// 256000 bit/s (or with zeros: NaN) it opens its lobby with no public slots, so nobody can join it. So we
+    /// report what a 50 ms send gives (Tustin/mw2-rpcs3 found 50 ms is what lets players join).
+    fn bandwidth_test(&self, len: usize) -> Result<BdResponse, Box<dyn Error>> {
+        const SEND_MS: u32 = 50;
+        let mut data = vec![5]; // BD_LSG_SERVICE_TASK_REPLY
+        data.extend_from_slice(&self.transaction.fetch_add(1, Ordering::Relaxed).to_le_bytes());
+        data.push(0); // accepted
+        if len >= 21 {
+            for v in [512 * 5, SEND_MS, 2, 0, 4] {
+                data.extend_from_slice(&u32::to_le_bytes(v)); // bytes, ms, average / first / last sequence
+            }
+        } else {
+            // packet size, count, sender wait, send time, receiver wait, receive time, linger
+            for v in [512, 5, 500, SEND_MS, 10000, 5000, 500] {
+                data.extend_from_slice(&u32::to_le_bytes(v));
+            }
+            let udp: std::net::SocketAddrV4 = std::env::var("DW_STUN_ADDR")
+                .ok()
+                .and_then(|a| a.parse().ok())
+                .unwrap_or_else(|| "127.0.0.1:3074".parse().unwrap());
+            data.extend_from_slice(&udp.port().to_le_bytes());
+            data.extend_from_slice(&udp.ip().octets());
+            data.extend_from_slice(&[0, 1, 2, 3, 4, 5, 6, 7]); // token
+        }
+        Ok(BdResponse::encrypted_if_available(data))
+    }
+
+    /// The publisher files with stable ids (1-based, by name): the game asks for them by id.
+    fn files(&self, session: &BdSession) -> Vec<(u64, StorageFileInfo)> {
+        let mut files = self.publisher_files.list_publisher_files(session, 0, 0, 100).map(|s| s.into_data()).unwrap_or_default();
+        files.sort_by(|a, b| a.filename.cmp(&b.filename));
+        files.into_iter().enumerate().map(|(i, f)| (i as u64 + 1, f)).collect()
+    }
+
+    /// Failed task: [typed u64 transaction id][typed u32 error]
+    fn error(&self, code: BdErrorCode) -> Result<BdResponse, Box<dyn Error>> {
+        let mut data = Vec::new();
+        {
+            let mut w = BdWriter::new(&mut data);
+            w.write_u8(BdMessageType::LobbyServiceTaskReply.to_u8().unwrap())?;
+            w.set_mode(StreamMode::BitMode);
+            w.set_type_checked(true);
+            w.write_type_checked_bit()?;
+            w.write_u64(self.transaction.fetch_add(1, Ordering::Relaxed))?;
+            w.write_u32(code.to_u32().unwrap())?;
+        }
+        Ok(BdResponse::encrypted_if_available(data))
+    }
+
+    /// Task reply: [typed u64 transaction id][typed u32 error][typed u8 result type, or the task id for
+    /// matchmaking][body]
+    fn reply(&self, result_type: u8, body: Body) -> Result<BdResponse, Box<dyn Error>> {
+        let mut data = Vec::new();
+        {
+            let mut w = BdWriter::new(&mut data);
+            w.write_u8(BdMessageType::LobbyServiceTaskReply.to_u8().unwrap())?;
+            w.set_mode(StreamMode::BitMode);
+            w.set_type_checked(true);
+            w.write_type_checked_bit()?;
+            w.write_u64(self.transaction.fetch_add(1, Ordering::Relaxed))?;
+            w.write_u32(0)?;
+            w.write_u8(result_type)?;
+            body(&mut w)?;
+        }
+        Ok(BdResponse::encrypted_if_available(data))
+    }
+}
+
+/// No results: [u32 count 0][u32 total 0]
+fn empty(w: &mut BdWriter) -> Result<(), Box<dyn Error>> {
+    w.write_u32(0)?;
+    w.write_u32(0)
+}
+
+/// bdLobbyFileHeader: [u64 id][u32 time][u32 size][bool][bool][u64 owner][string name]
+fn file_header(w: &mut BdWriter, id: u64, file: &StorageFileInfo) -> Result<(), Box<dyn Error>> {
+    w.write_u64(id)?;
+    w.write_u32(file.modified as u32)?;
+    w.write_u32(file.file_size as u32)?;
+    w.write_bool(true)?;
+    w.write_bool(false)?;
+    w.write_u64(0)?;
+    w.write_str(&file.filename)
+}
+
+/// Whether a hosted game fits a search. The host sends 4 slot counts then the title's fields, the search 2 of its
+/// own (type, max results) then its fields; matched by value in TDM / HC FFA sessions (playlist 1 / 4):
+/// host [.., playlist 5, version 6, netcode 8], search [.., playlist 3, netcode 4, version 6]. A game of another
+/// playlist or game version would send the searcher into a join that fails.
+fn compatible(host: &[i32], search: &[i32]) -> bool {
+    host.len() >= 9 && search.len() >= 7 && host[5] == search[3] && host[6] == search[6] && host[8] == search[4]
+}
+
+/// Create / update: [u8][blob host address][blob session id][blob key][int32 game info...]
+fn read_session_info(r: &mut BdReader) -> Result<(Vec<u8>, Vec<u8>, Vec<u8>, Vec<i32>), Box<dyn Error>> {
+    r.read_u8()?;
+    let (addr, id, key) = (r.read_blob()?, r.read_blob()?, r.read_blob()?);
+    let mut info = Vec::new();
+    while info.len() < 32 && r.next_is_i32().unwrap_or(false) {
+        info.push(r.read_i32()?);
+    }
+    Ok((addr, id, key, info))
+}
+
+fn username(session: &BdSession) -> &str {
+    session.authentication().map_or("?", |a| a.username.as_str())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn finds_games_of_the_same_playlist() {
+        let tdm_host = [12, 0, 0, 0, 1, 1, 504, 0, 139, 2, 1, 17, 0];
+        let hc_ffa_host = [8, 0, 0, 0, 1, 4, 504, 0, 139, 2, 4, 17, 0];
+        let tdm_search = [2, 50, 1, 1, 139, 2, 504, 1, 0];
+        assert!(compatible(&tdm_host, &tdm_search));
+        assert!(!compatible(&hc_ffa_host, &tdm_search));
+        assert!(!compatible(&tdm_host, &[2, 50, 1, 1, 139, 2, 505, 1, 0])); // other playlist version
+        assert!(!compatible(&[], &tdm_search));
+    }
+
+    #[test]
+    fn reply_reads_back() {
+        let mut data = Vec::new();
+        {
+            let mut w = BdWriter::new(&mut data);
+            w.set_mode(StreamMode::BitMode);
+            w.set_type_checked(true);
+            w.write_type_checked_bit().unwrap();
+            w.write_u8(3).unwrap();
+            w.write_str("playlists.patch3").unwrap();
+            w.write_blob(b"version 1\n").unwrap();
+            w.write_i32(-5).unwrap();
+        }
+        let mut r = BdReader::new(data);
+        r.set_mode(StreamMode::BitMode);
+        r.read_type_checked_bit().unwrap();
+        assert_eq!(r.read_u8().unwrap(), 3);
+        assert_eq!(r.read_str().unwrap(), "playlists.patch3");
+        assert_eq!(r.read_blob().unwrap(), b"version 1\n");
+        assert!(r.next_is_i32().unwrap());
+        assert_eq!(r.read_i32().unwrap(), -5);
+    }
+}
