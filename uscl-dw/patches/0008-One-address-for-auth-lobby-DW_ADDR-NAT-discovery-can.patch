+++ b/dw-server/src/mux.rs
@@ -0,0 +1,46 @@
+//! One TCP address for both the auth and the lobby server (`DW_ADDR`), so players behind the session tunnel only
+//! need 127.0.0.1. A connection is lobby once it's authenticated, or when its message starts with service 7
+//! (the lobby's own login service); clients only ever send auth *requests*, which are even numbers, so 7 never
+//! means auth.
+use bitdemon::auth::auth_server::AuthServer;
+use bitdemon::lobby::LobbyServer;
+use bitdemon::messaging::bd_message::BdMessage;
+use bitdemon::networking::bd_session::BdSession;
+use bitdemon::networking::bd_socket::BdMessageHandler;
+use std::error::Error;
+use std::sync::Arc;
+
+const LOBBY_LOGIN_SERVICE: u8 = 7;
+
+pub fn is_lobby(authenticated: bool, first_byte: Option<u8>) -> bool {
+    authenticated || first_byte == Some(LOBBY_LOGIN_SERVICE)
+}
+
+pub struct Mux {
+    pub auth: Arc<AuthServer>,
+    pub lobby: Arc<LobbyServer>,
+}
+
+impl BdMessageHandler for Mux {
+    fn handle_message(&self, session: &mut BdSession, message: BdMessage) -> Result<(), Box<dyn Error>> {
+        let first = message.reader.remaining_data().first().copied();
+        if is_lobby(session.authentication().is_some(), first) {
+            self.lobby.handle_message(session, message)
+        } else {
+            self.auth.handle_message(session, message)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::is_lobby;
+
+    #[test]
+    fn routes_by_first_message() {
+        assert!(is_lobby(false, Some(7))); // lobby login (LSG)
+        assert!(!is_lobby(false, Some(0x12))); // Ps3ForMmpRequest
+        assert!(!is_lobby(false, Some(0x1c))); // SteamForMmpRequest
+        assert!(is_lobby(true, Some(0x12))); // anything after the lobby login
+    }
+}
