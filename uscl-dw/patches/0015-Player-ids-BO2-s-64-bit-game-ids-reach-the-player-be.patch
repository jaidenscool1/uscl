+//! Black Ops II (PS3) names players by a 64-bit id of its own (stable per player, not the one in the PSN ticket),
+//! while the login gives each player the ticket's user id (with RPCN, a small account number). Profiles, stats and
+//! files asked for by game id must reach the player behind it, so we learn each player's game id from the first
+//! listing of their own files (every login does one) and keep it.
+use bitdemon::networking::bd_session::BdSession;
+use log::info;
+use rusqlite::Connection;
+use std::cell::RefCell;
+use std::fs::create_dir_all;
+
+thread_local! {
+    static PLAYER_ID_DB: RefCell<Connection> = RefCell::new(initialized_db());
+}
+
+fn initialized_db() -> Connection {
+    create_dir_all("db").expect("to be able to create dir");
+    let conn = Connection::open("db/player_id.db").expect("expected db connection to be able to open");
+    conn.execute(
+        "CREATE TABLE IF NOT EXISTS game_id (game_id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL UNIQUE)",
+        (),
+    )
+    .expect("Initialization to succeed");
+    conn
+}
+
+/// Ticket user ids (RPCN account numbers) are small; game ids use all 64 bits (SQLite keeps them as i64).
+fn is_game_id(id: u64) -> bool {
+    id > u64::from(u32::MAX)
+}
+
+/// Our user id for `id`: a known game id becomes its player's user id; anything else stays as it is.
+pub fn resolve(id: u64) -> u64 {
+    if !is_game_id(id) {
+        return id;
+    }
+    PLAYER_ID_DB
+        .with_borrow(|db| db.query_row("SELECT user_id FROM game_id WHERE game_id = ?1", [id as i64], |row| row.get::<_, i64>(0)))
+        .map(|user_id| user_id as u64)
+        .unwrap_or(id)
+}
+
+/// The session's player lists files by `id`. A game id nobody has yet, from a player who has none yet, is theirs
+/// (a listing of someone else's files comes after their own, so it can't take it).
+pub fn learn_own(session: &BdSession, id: u64) -> u64 {
+    let auth = session.authentication().unwrap();
+    if is_game_id(id) && resolve(id) == id {
+        let added = PLAYER_ID_DB.with_borrow(|db| {
+            db.execute("INSERT OR IGNORE INTO game_id (game_id, user_id) VALUES (?1, ?2)", (id as i64, auth.user_id as i64))
+        });
+        if added == Ok(1) {
+            info!("{} (user {}) is game id {id}", auth.username, auth.user_id);
+        }
+    }
+    resolve(id)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::is_game_id;
+
+    #[test]
+    fn game_ids_are_the_large_ones() {
+        assert!(!is_game_id(2));
+        assert!(is_game_id(15258544499090971638)); // Pete_Hegseth's in the 2026-10-27 two-PC test
+        assert!(is_game_id(1610465076020602188));
+    }
+}
