From 0555a8d3c31fd1ab05d200d033dff6ffc1a00d40 Mon Sep 17 00:00:00 2001
From: HempFiend <17104973+jaidenscool1@users.noreply.github.com>
Date: Fri, 23 Oct 2026 15:32:00 -0700
Subject: [PATCH 04/14] Twitter and Facebook answered by a shared logging stub
 (with Teams)

Black Ops II calls both after login; "not available" may stall its online menus.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dw-server/src/lobby/mod.rs                   | 10 +++---
 libbitdemon/src/lobby/mod.rs                 |  2 +-
 libbitdemon/src/lobby/{teams => stub}/mod.rs | 33 +++++++++-----------
 3 files changed, 22 insertions(+), 23 deletions(-)
 rename libbitdemon/src/lobby/{teams => stub}/mod.rs (50%)

diff --git a/dw-server/src/lobby/mod.rs b/dw-server/src/lobby/mod.rs
index 387b026..d39e231 100644
--- a/dw-server/src/lobby/mod.rs
+++ b/dw-server/src/lobby/mod.rs
@@ -14,8 +14,8 @@ use crate::lobby::rich_presence::create_rich_presence_handler;
 use crate::lobby::storage::create_storage_handler;
 use axum::Router;
 use bitdemon::lobby::LobbyServiceId::{
-    Anticheat, BandwidthTest, Counter, Dml, EventLog, Group, KeyArchive, League, Profile,
-    RichPresence, Stats, Storage, Teams, TitleUtilities, Twitch, VoteRank, Youtube,
+    Anticheat, BandwidthTest, Counter, Dml, EventLog, Facebook, Group, KeyArchive, League, Profile,
+    RichPresence, Stats, Storage, Teams, TitleUtilities, Twitch, Twitter, VoteRank, Youtube,
 };
 use bitdemon::lobby::anti_cheat::AntiCheatHandler;
 use bitdemon::lobby::bandwidth::BandwidthHandler;
@@ -24,7 +24,7 @@ use bitdemon::lobby::event_log::EventLogHandler;
 use bitdemon::lobby::key_archive::KeyArchiveHandler;
 use bitdemon::lobby::league::LeagueHandler;
 use bitdemon::lobby::stats::StatsHandler;
-use bitdemon::lobby::teams::TeamsHandler;
+use bitdemon::lobby::stub::StubHandler;
 use bitdemon::lobby::title_utilities::TitleUtilitiesHandler;
 use bitdemon::lobby::twitch::TwitchHandler;
 use bitdemon::lobby::vote_rank::VoteRankHandler;
@@ -55,7 +55,9 @@ pub fn configure_lobby_server(
     configurer.direct_config(Profile, create_profile_handler());
     configurer.direct_config(RichPresence, create_rich_presence_handler(session_manager));
     configurer.direct_config(Stats, Arc::new(StatsHandler::new()));
-    configurer.direct_config(Teams, Arc::new(TeamsHandler::new()));
+    configurer.direct_config(Teams, Arc::new(StubHandler::new("Teams")));
+    configurer.direct_config(Twitter, Arc::new(StubHandler::new("Twitter")));
+    configurer.direct_config(Facebook, Arc::new(StubHandler::new("Facebook")));
     configurer.direct_config(Storage, create_storage_handler());
     configurer.direct_config(TitleUtilities, Arc::new(TitleUtilitiesHandler::new()));
     configurer.direct_config(Twitch, Arc::new(TwitchHandler::new()));
diff --git a/libbitdemon/src/lobby/mod.rs b/libbitdemon/src/lobby/mod.rs
index d3a246a..e4927ff 100644
--- a/libbitdemon/src/lobby/mod.rs
+++ b/libbitdemon/src/lobby/mod.rs
@@ -13,7 +13,7 @@ mod response;
 pub mod rich_presence;
 pub mod stats;
 pub mod storage;
-pub mod teams;
+pub mod stub;
 pub mod title_utilities;
 pub mod twitch;
 pub mod vote_rank;
diff --git a/libbitdemon/src/lobby/teams/mod.rs b/libbitdemon/src/lobby/stub/mod.rs
similarity index 50%
rename from libbitdemon/src/lobby/teams/mod.rs
rename to libbitdemon/src/lobby/stub/mod.rs
index 8b2a28d..5542815 100644
--- a/libbitdemon/src/lobby/teams/mod.rs
+++ b/libbitdemon/src/lobby/stub/mod.rs
@@ -1,6 +1,6 @@
-//! bdTeams (service 3): clans.
-//! shortcut: answers every task with "no error, no rows" (a player in no clan) and logs the request, so
-//! the real tasks can be worked out from what games send; store teams once their format is known.
+//! Services a title calls but doesn't need answered with data: Teams (clans), Twitter, Facebook.
+//! shortcut: every task gets "no error, no rows" and the request is logged; implement a service properly once a
+//! game needs real answers from it.
 use crate::lobby::LobbyHandler;
 use crate::lobby::response::task_reply::TaskReply;
 use crate::messaging::BdErrorCode;
@@ -10,16 +10,17 @@ use crate::networking::bd_session::BdSession;
 use log::info;
 use std::error::Error;
 
-#[derive(Default)]
-pub struct TeamsHandler {}
+pub struct StubHandler {
+    name: &'static str,
+}
 
-impl TeamsHandler {
-    pub fn new() -> TeamsHandler {
-        TeamsHandler {}
+impl StubHandler {
+    pub fn new(name: &'static str) -> StubHandler {
+        StubHandler { name }
     }
 }
 
-impl LobbyHandler for TeamsHandler {
+impl LobbyHandler for StubHandler {
     fn handle_message(
         &self,
         _session: &mut BdSession,
@@ -27,15 +28,11 @@ impl LobbyHandler for TeamsHandler {
     ) -> Result<BdResponse, Box<dyn Error>> {
         let task_id = message.reader.read_u8()?;
         let data = message.reader.remaining_data();
-        info!(
-            "Teams task {task_id} ({} bytes): {}",
-            data.len(),
-            hex(&data[..data.len().min(256)])
-        );
+        let hex: String = data[..data.len().min(256)]
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect();
+        info!("{} task {task_id} ({} bytes): {hex}", self.name, data.len());
         TaskReply::with_only_error_code(BdErrorCode::NoError, task_id).to_response()
     }
 }
-
-fn hex(data: &[u8]) -> String {
-    data.iter().map(|b| format!("{b:02x}")).collect()
-}
