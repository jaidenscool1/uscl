diff --git a/dw-server/src/auth3.rs b/dw-server/src/auth3.rs
new file mode 100644
index 0000000..45616d1
--- /dev/null
+++ b/dw-server/src/auth3.rs
@@ -0,0 +1,150 @@
+//! USCL: Demonware's HTTPS sign-in ("auth3"), used by the PS4 Black Ops II port (title 2430).
+//!
+//! The game POSTs JSON to https://auth3.prod.demonware.net/auth/: auth_task 46, iv_seed, title_id and extra_data,
+//! whose token's id_token is the player (USCL's shadPS4 fork sends "uscl:<online id>:<account id>"). The reply
+//! (bdHTTPAuthService-ps4 handleReply) must carry auth_task 47, code 700, the iv_seed, a 128-byte client ticket
+//! (plain bdAuthTicket: magic, user id, name, session key) and a 128-byte server ticket the lobby accepts (the
+//! same signed proof the PS3 sign-in hands out), both base64.
+//! Off unless DW_AUTH3_ADDR is set (e.g. 127.0.0.1:443); the certificate is made at start (USCL's shadPS4 fork
+//! trusts the hosts it redirects to itself).
+
+use axum::extract::State;
+use axum::routing::post;
+use axum::{Json, Router};
+use base64::Engine;
+use bitdemon::auth::auth_proof::ClientOpaqueAuthProof;
+use bitdemon::auth::key_store::InMemoryKeyStore;
+use bitdemon::auth::result::auth_ticket::{AuthTicket, BdAuthTicketType};
+use bitdemon::domain::title::Title;
+use bitdemon::messaging::bd_serialization::BdSerialize;
+use bitdemon::messaging::bd_writer::BdWriter;
+use chrono::Utc;
+use log::{info, warn};
+use num_traits::FromPrimitive;
+use serde_json::{json, Value};
+use std::sync::Arc;
+
+const TICKET_LEN: usize = 128;
+const TICKET_SECONDS: i64 = 60 * 60 * 24;
+const AUTH_OK: &str = "700";
+
+/// "uscl:<online id>:<account id>" from the request's extra_data (a JSON string holding a JSON string token).
+pub fn player(extra_data: &str) -> Option<(String, u64)> {
+    let extra: Value = serde_json::from_str(extra_data).ok()?;
+    let token: Value = serde_json::from_str(extra.get("token")?.as_str()?).ok()?;
+    let mut parts = token.get("id_token")?.as_str()?.strip_prefix("uscl:")?.rsplitn(2, ':');
+    let account = parts.next()?.parse().ok()?;
+    let name = parts.next()?.to_string();
+    (!name.is_empty() && name.len() <= 16).then_some((name, account))
+}
+
+fn number(v: &Value, key: &str) -> Option<u64> {
+    match v.get(key)? {
+        Value::String(s) => s.parse().ok(),
+        n => n.as_u64(),
+    }
+}
+
+async fn auth(State(key_store): State<Arc<InMemoryKeyStore>>, Json(req): Json<Value>) -> Json<Value> {
+    let fail = |code: &str| Json(json!({ "auth_task": "47", "code": code }));
+    let (Some(46), Some(iv_seed), Some(title_id)) = (number(&req, "auth_task"), number(&req, "iv_seed"), number(&req, "title_id")) else {
+        warn!("auth3: unexpected request {req}");
+        return fail("701");
+    };
+    let Some(title) = Title::from_u64(title_id) else {
+        warn!("auth3: unknown title {title_id}");
+        return fail("701");
+    };
+    let Some((name, user_id)) = req.get("extra_data").and_then(Value::as_str).and_then(player) else {
+        warn!("auth3: no USCL player in the token");
+        return fail("701");
+    };
+
+    let now = Utc::now().timestamp();
+    let expires = now + TICKET_SECONDS;
+    let ticket = AuthTicket {
+        ticket_type: BdAuthTicketType::UserToService,
+        title,
+        time_issued: (now % u32::MAX as i64) as u32,
+        time_expires: (expires % u32::MAX as i64) as u32,
+        license_id: 1234,
+        user_id,
+        username: name.clone(),
+        session_key: rand::random(),
+    };
+    let mut client = Vec::new();
+    if let Err(e) = ticket.serialize(&mut BdWriter::new(&mut client)) {
+        warn!("auth3: ticket for {name}: {e}");
+        return fail("701");
+    }
+    client.resize(TICKET_LEN, 0);
+    let server = ClientOpaqueAuthProof {
+        title,
+        time_expires: expires,
+        license_id: ticket.license_id,
+        user_id,
+        session_key: ticket.session_key,
+        username: name.clone(),
+    }
+    .serialize(key_store.as_ref());
+
+    info!("auth3: signed in {name} ({user_id}) for {title:?}");
+    let b64 = base64::engine::general_purpose::STANDARD;
+    Json(json!({
+        "auth_task": "47",
+        "code": AUTH_OK,
+        "iv_seed": iv_seed.to_string(),
+        "client_ticket": b64.encode(&client),
+        "server_ticket": b64.encode(server),
+    }))
+}
+
+pub async fn serve(key_store: Arc<InMemoryKeyStore>) {
+    let Ok(addr) = std::env::var("DW_AUTH3_ADDR") else {
+        return;
+    };
+    let cert = rcgen::generate_simple_self_signed(vec!["auth3.prod.demonware.net".into()]).expect("auth3 certificate");
+    let tls = axum_server::tls_rustls::RustlsConfig::from_pem(
+        cert.cert.pem().into_bytes(),
+        cert.signing_key.serialize_pem().into_bytes(),
+    )
+    .await
+    .expect("auth3 TLS setup");
+    let app = Router::new().route("/auth/", post(auth)).with_state(key_store);
+    info!("auth3 (HTTPS sign-in) on {addr}");
+    let addr: std::net::SocketAddr = addr.parse().expect("DW_AUTH3_ADDR: host:port");
+    if let Err(e) = axum_server::bind_rustls(addr, tls).serve(app.into_make_service()).await {
+        warn!("auth3 stopped: {e}");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reads_the_uscl_player() {
+        let extra = r#"{"version": "17", "token": "{\"scope\": \"openid,openid:duid\", \"id_token\": \"uscl:test_player:7\"}", "extended_data": true}"#;
+        assert_eq!(player(extra), Some(("test_player".into(), 7)));
+        let placeholder = r#"{"version": "17", "token": "{\"scope\": \"openid\", \"id_token\": \"TOKEN\"}"}"#;
+        assert_eq!(player(placeholder), None);
+    }
+
+    #[test]
+    fn client_ticket_is_128_bytes_with_the_magic() {
+        let ticket = AuthTicket {
+            ticket_type: BdAuthTicketType::UserToService,
+            title: Title::T6Ps4,
+            time_issued: 1,
+            time_expires: 2,
+            license_id: 3,
+            user_id: 4,
+            username: "p".into(),
+            session_key: [9; 24],
+        };
+        let mut buf = Vec::new();
+        ticket.serialize(&mut BdWriter::new(&mut buf)).unwrap();
+        assert!(buf.len() <= TICKET_LEN);
+        assert_eq!(buf[..4], 0xefbdaddeu32.to_le_bytes());
+    }
+}
