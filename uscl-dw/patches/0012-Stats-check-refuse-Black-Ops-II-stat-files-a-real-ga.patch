+//! Refuses Black Ops II stat files a real game can't produce, so modded rank/prestige/XP never get saved.
+//!
+//! `mpstatsCompressed` is raw deflate of: 48 bytes of header (u32 checksum, u32 BE layout version, ...) then the
+//! buffer described by `ddl_mp/stats.ddl` (version 244 in 1.19, read from game memory). Values are little
+//! endian. `playerstatslist` starts at bit 64 and holds 383 `intstat_s { u32 statvalue; u16 challengevalue }`
+//! (48 bits each) indexed by `globalstats_e`.
+
+use flate2::read::DeflateDecoder;
+use std::io::Read;
+
+pub const MP_STATS_FILE: &str = "mpstatsCompressed";
+const HEADER: usize = 48;
+const SIZE: usize = 50972;
+const LAYOUT_VERSION: u32 = 244;
+
+// globalstats_e
+const PLEVEL: usize = 326;
+const RANK: usize = 329;
+const RANKXP: usize = 330;
+
+const MAX_PLEVEL: u32 = 16; // prestige master + the extra BO2 added in a title update
+const MAX_RANK: u32 = 54; // level 55
+const MAX_RANKXP: u32 = 1_262_500; // level 55's XP
+// shortcut: generous ceiling for one upload (a long match with double XP stays well under it); tighten with real
+// match data
+const MAX_XP_PER_UPLOAD: u32 = 150_000;
+
+#[derive(Debug, PartialEq)]
+struct Rank {
+    plevel: u32,
+    rank: u32,
+    rankxp: u32,
+}
+
+fn read(file: &[u8]) -> Result<Rank, String> {
+    let mut data = Vec::new();
+    DeflateDecoder::new(file).take(SIZE as u64 + 1).read_to_end(&mut data).map_err(|_| "not a stats file")?;
+    if data.len() != SIZE || u32::from_be_bytes(data[4..8].try_into().unwrap()) != LAYOUT_VERSION {
+        return Err(format!("unexpected stats layout ({} bytes)", data.len()));
+    }
+    let stat = |i: usize| {
+        let at = HEADER + (64 + 48 * i) / 8;
+        u32::from_le_bytes(data[at..at + 4].try_into().unwrap())
+    };
+    Ok(Rank { plevel: stat(PLEVEL), rank: stat(RANK), rankxp: stat(RANKXP) })
+}
+
+/// Err(reason) when `new` (replacing `old`, if there was one) isn't something the game could have written.
+pub fn check(old: Option<&[u8]>, new: &[u8]) -> Result<(), String> {
+    let n = read(new)?;
+    if n.plevel > MAX_PLEVEL || n.rank > MAX_RANK || n.rankxp > MAX_RANKXP {
+        return Err(format!("prestige {} rank {} xp {} is past the maximum", n.plevel, n.rank, n.rankxp));
+    }
+    // an unreadable old file (e.g. from before this check) can't vouch for anything: judge from zero
+    let o = old.and_then(|o| read(o).ok()).unwrap_or(Rank { plevel: 0, rank: 0, rankxp: 0 });
+    if n.plevel > o.plevel + 1 {
+        return Err(format!("prestige {} -> {} in one match", o.plevel, n.plevel));
+    }
+    // prestiging resets XP; otherwise XP only grows, by at most one match's worth
+    let gained = if n.plevel > o.plevel { n.rankxp } else { n.rankxp.saturating_sub(o.rankxp) };
+    if gained > MAX_XP_PER_UPLOAD {
+        return Err(format!("{gained} XP in one match"));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use flate2::write::DeflateEncoder;
+    use flate2::Compression;
+    use std::io::Write;
+
+    fn file(plevel: u32, rank: u32, rankxp: u32) -> Vec<u8> {
+        let mut data = vec![0u8; SIZE];
+        data[4..8].copy_from_slice(&LAYOUT_VERSION.to_be_bytes());
+        for (i, v) in [(PLEVEL, plevel), (RANK, rank), (RANKXP, rankxp)] {
+            let at = HEADER + (64 + 48 * i) / 8;
+            data[at..at + 4].copy_from_slice(&v.to_le_bytes());
+        }
+        let mut enc = DeflateEncoder::new(Vec::new(), Compression::default());
+        enc.write_all(&data).unwrap();
+        enc.finish().unwrap()
+    }
+
+    #[test]
+    fn reads_rank() {
+        assert_eq!(read(&file(2, 30, 400_000)).unwrap(), Rank { plevel: 2, rank: 30, rankxp: 400_000 });
+        assert!(read(b"junk").is_err());
+    }
+
+    #[test]
+    fn normal_progress_passes() {
+        assert!(check(None, &file(0, 0, 100)).is_ok());
+        assert!(check(Some(&file(0, 3, 9_000)), &file(0, 4, 14_000)).is_ok());
+        // prestiging: rank and XP start over
+        assert!(check(Some(&file(0, 54, 1_262_500)), &file(1, 0, 2_000)).is_ok());
+    }
+
+    #[test]
+    fn impossible_stats_fail() {
+        assert!(check(None, &file(15, 54, 1_262_500)).is_err()); // a fresh account at max
+        assert!(check(Some(&file(0, 3, 9_000)), &file(0, 54, 1_262_500)).is_err()); // a level jump
+        assert!(check(Some(&file(1, 10, 50_000)), &file(5, 10, 50_000)).is_err()); // prestige jump
+        assert!(check(None, &file(0, 99, 0)).is_err()); // past the maximum
+        assert!(check(None, b"not deflate").is_err());
+    }
+}
