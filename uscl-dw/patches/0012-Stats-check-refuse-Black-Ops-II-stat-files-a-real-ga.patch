+/// Stat files are checked against the player's previous one; impossible ones are refused (and logged for the host).
+fn check_upload(session: &BdSession, filename: &str, old: Option<Vec<u8>>, new: &[u8]) -> Result<(), StorageServiceError> {
+    if filename != stats_check::MP_STATS_FILE {
+        return Ok(());
+    }
+    stats_check::check(old.as_deref(), new).map_err(|reason| {
+        let name = &session.authentication().unwrap().username;
+        warn!("anticheat: {name} sent impossible stats ({reason}); the upload was refused");
+        StorageServiceError::PermissionDeniedError
+    })
+}
