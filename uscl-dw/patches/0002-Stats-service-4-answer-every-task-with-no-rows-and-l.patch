     }
 
+    /// The unread rest of the message, without consuming it (for logging unknown requests).
+    pub fn remaining_data(&self) -> &[u8] {
+        &self.cursor.get_ref()[(self.cursor.position() as usize).min(self.cursor.get_ref().len())..]
+    }
+
     pub fn remaining_bytes(&self) -> Result<usize, Box<dyn Error>> {
         ensure!(
             self.mode == StreamMode::ByteMode,
