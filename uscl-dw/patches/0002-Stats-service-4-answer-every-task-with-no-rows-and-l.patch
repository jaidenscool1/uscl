+//! bdStats (service 4): player stats / leaderboards.
+//! shortcut: answers every task with "no error, no rows" (a new player has no stats) and logs the request, so
+//! the real tasks can be worked out from what games send; store and return stats once their format is known.
+use crate::lobby::LobbyHandler;
+use crate::lobby::response::task_reply::TaskReply;
+use crate::messaging::BdErrorCode;
+use crate::messaging::bd_message::BdMessage;
+use crate::messaging::bd_response::{BdResponse, ResponseCreator};
+use crate::networking::bd_session::BdSession;
+use log::info;
+use std::error::Error;
+
+#[derive(Default)]
+pub struct StatsHandler {}
+
+impl StatsHandler {
+    pub fn new() -> StatsHandler {
+        StatsHandler {}
+    }
+}
+
+impl LobbyHandler for StatsHandler {
+    fn handle_message(
+        &self,
+        _session: &mut BdSession,
+        mut message: BdMessage,
+    ) -> Result<BdResponse, Box<dyn Error>> {
+        let task_id = message.reader.read_u8()?;
+        let data = message.reader.remaining_data();
+        info!(
+            "Stats task {task_id} ({} bytes): {}",
+            data.len(),
+            hex(&data[..data.len().min(256)])
+        );
+        TaskReply::with_only_error_code(BdErrorCode::NoError, task_id).to_response()
+    }
+}
+
+fn hex(data: &[u8]) -> String {
+    data.iter().map(|b| format!("{b:02x}")).collect()
+}
