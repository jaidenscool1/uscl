+impl PushSource for AntiCheatHandler {
+    fn pushes(&self, session: &BdSession) -> Vec<BdResponse> {
+        let (Some(_), Some(auth)) = (&self.trusted_user, session.authentication()) else {
+            return Vec::new();
+        };
+        let mut state = self.state.lock().unwrap();
+        let since = *state.first_seen.entry(session.id).or_insert_with(Instant::now);
+        if since.elapsed() < SETTLE {
+            return Vec::new();
+        }
+        if state.round.started.is_none_or(|t| t.elapsed() > self.interval) {
+            let number = state.round.number + 1;
+            let challenges = (0..CHALLENGES_PER_ROUND).map(|i| Challenge::random(number << 8 | i)).collect();
+            state.round = Round { number, challenges, started: Some(Instant::now()), ..Round::default() };
+        }
+        if state.sent.get(&session.id) == Some(&state.round.number) {
+            return Vec::new();
+        }
+        let number = state.round.number;
+        state.sent.insert(session.id, number);
+        info!("Anticheat round {} sent to {}", state.round.number, auth.username);
+        debug!("Anticheat challenges: {:x?}", state.round.challenges);
+        match challenge_push(ps3_user_id(&auth.username), &state.round.challenges) {
+            Ok(push) => vec![push],
+            Err(e) => {
+                warn!("Couldn't build the anticheat push: {e}");
+                Vec::new()
+            }
+        }
+    }
+
+    fn blocked(&self, session: &BdSession) -> bool {
+        session.authentication().is_some_and(|a| self.state.lock().unwrap().blocked.contains(&a.user_id))
+    }
+}
