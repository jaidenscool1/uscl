+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn challenge_blob_layout() {
+        let c = Challenge { id: 1, key: 0x1122334455667788, start: 0x10, end: -0x20 };
+        let b = c.blob();
+        assert_eq!(b.len(), 26);
+        assert_eq!(&b[..8], &0x1122334455667788u64.to_be_bytes());
+        assert_eq!(&b[8..16], &0x10i64.to_be_bytes());
+        assert_eq!(&b[16..24], &(-0x20i64).to_be_bytes());
+        assert_eq!(&b[24..], &[0, 0]);
+    }
+
+    #[test]
+    fn crc_is_reflected_without_final_xor() {
+        // with key 0xffffffff the game's CRC is the standard CRC-32 before its final xor
+        let c = Challenge { id: 0, key: 0xffffffff, start: 0, end: 9 };
+        assert_eq!(code_crc(b"123456789", &c) as u32, !0xcbf43926u32);
+        let shorter = Challenge { end: 4, ..c.clone() };
+        assert_ne!(code_crc(b"123456789", &shorter), code_crc(b"123456789", &c));
+    }
+
+    #[test]
+    fn ps3_user_ids() {
+        // Tiger("") = 3293ac630c13f024...; the id is its first 8 bytes, little endian
+        assert_eq!(ps3_user_id(""), u64::from_le_bytes([0x32, 0x93, 0xac, 0x63, 0x0c, 0x13, 0xf0, 0x24]));
+        assert_eq!(ps3_user_id("USCLtest"), ps3_user_id("uscltest"));
+    }
+
+    #[test]
+    fn verdicts() {
+        let reference = HashMap::from([(1, 10), (2, 20)]);
+        assert_eq!(verdict(&reference, &HashMap::from([(1, 10), (2, 20)])), Some(true));
+        assert_eq!(verdict(&reference, &HashMap::from([(1, 10), (2, 21)])), Some(false));
+        assert_eq!(verdict(&reference, &HashMap::from([(3, 30)])), None);
+    }
+
+    #[test]
+    fn host_answers_decide() {
+        let ac = AntiCheatHandler::with_challenges("host".into(), Duration::from_secs(300));
+        ac.state.lock().unwrap().round.challenges = vec![Challenge::random(1), Challenge::random(2)];
+        // players answering before the host wait for the host's answers
+        let (mp, launcher) = (vec![1, 0, 0, 0, 7, 1], vec![1, 0, 0, 0, 7, 0]);
+        ac.report(7, "cheater", mp.clone(), vec![(1, 5), (2, 6)]);
+        ac.report(8, "honest", mp.clone(), vec![(1, 1), (2, 2)]);
+        // still in the launcher: different code, so different answers, never compared with multiplayer
+        ac.report(10, "in menus", launcher.clone(), vec![(1, 40), (2, 41)]);
+        assert!(ac.state.lock().unwrap().blocked.is_empty());
+        ac.report(1, "host", mp.clone(), vec![(1, 1), (2, 2)]);
+        // and players answering after it are judged straight away
+        ac.report(9, "late cheater", mp, vec![(1, 1), (2, 3)]);
+        let s = ac.state.lock().unwrap();
+        assert!(s.blocked.contains(&7) && !s.blocked.contains(&8) && s.blocked.contains(&9));
+        assert!(!s.blocked.contains(&10) && s.round.pending.contains_key(&10));
     }
 }
