+/// What the game computes for a type 1 challenge over `code` (the module's bytes from its start).
+pub fn code_crc(code: &[u8], c: &Challenge) -> i64 {
+    let start = (c.start.max(0) as usize).min(code.len());
+    let end = (c.end.max(0) as usize).min(code.len()).max(start);
+    let mut crc = c.key as u32;
+    for &b in &code[start..end] {
+        crc ^= b as u32;
+        for _ in 0..8 {
+            crc = if crc & 1 != 0 { (crc >> 1) ^ 0xedb88320 } else { crc >> 1 };
         }
     }
+    crc as i64
+}
