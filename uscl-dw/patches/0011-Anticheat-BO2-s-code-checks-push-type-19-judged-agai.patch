+impl LobbyHandler for AntiCheatHandler {
+    fn handle_message(&self, session: &mut BdSession, mut message: BdMessage) -> Result<BdResponse, Box<dyn Error>> {
+        let task_id_value = message.reader.read_u8()?;
+        let Some(task_id) = AntiCheatTaskId::from_u8(task_id_value) else {
+            warn!("Client called unknown task {task_id_value}");
+            return TaskReply::with_only_error_code(NoError, task_id_value).to_response();
+        };
+
+        match task_id {
+            AntiCheatTaskId::ReportConsoleDetails => Self::report_console_details(&mut message.reader),
+            AntiCheatTaskId::AnswerChallenges => {
+                let (answers, build) = read_answers(&mut message.reader)?;
+                if let Some(auth) = session.authentication() {
+                    debug!("Anticheat answers from {} (build {build:02x?}): {answers:x?}", auth.username);
+                    self.report(auth.user_id, &auth.username, build, answers);
+                }
+                TaskReply::with_only_error_code(NoError, task_id).to_response()
+            }
+            AntiCheatTaskId::ReportConsoleId => {
+                warn!("Client called unimplemented task {task_id:?}");
+                TaskReply::with_only_error_code(NoError, task_id).to_response()
+            }
+        }
+    }
+}
