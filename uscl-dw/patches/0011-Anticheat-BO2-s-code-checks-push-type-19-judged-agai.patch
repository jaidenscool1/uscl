+/// The id a PS3 title knows its player by (`0081e378` in BO2 1.19): Tiger hash of the lowercased online ID, its
+/// first 8 bytes read little endian. A push for any other id hits a log line that crashes the game.
+pub fn ps3_user_id(online_id: &str) -> u64 {
+    use tiger::{Digest, Tiger};
+    let hash: [u8; 24] = Tiger::digest(online_id.to_ascii_lowercase().as_bytes()).into();
+    u64::from_le_bytes(hash[..8].try_into().unwrap())
+}
+
+pub fn challenge_push(user_id: u64, challenges: &[Challenge]) -> Result<BdResponse, Box<dyn Error>> {
+    let mut data = Vec::new();
+    {
+        let mut writer = BdWriter::new(&mut data);
+        writer.set_type_checked(false);
+        writer.set_mode(StreamMode::ByteMode);
+        writer.write_u8(BdMessageType::LobbyServicePushMessage.to_u8().unwrap())?;
+        writer.set_type_checked(true);
+        writer.write_u32(PUSH_CHALLENGES)?;
+        writer.write_u64(user_id)?;
+        writer.write_str("")?;
+        writer.write_u16(challenges.len() as u16)?;
+        for c in challenges {
+            writer.write_u16(CHALLENGE_CODE_CRC)?;
+            writer.write_u64(c.id)?;
+            writer.write_u16(1)?;
+            writer.write_blob(&c.blob())?;
+        }
+    }
+    Ok(BdResponse::encrypted_if_available(data))
+}
