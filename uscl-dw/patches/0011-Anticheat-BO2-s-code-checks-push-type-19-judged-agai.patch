+/// Some(true) when every answer the reference also has matches it; None when there's nothing to compare.
+fn verdict(reference: &HashMap<u64, i64>, answers: &HashMap<u64, i64>) -> Option<bool> {
+    let shared: Vec<_> = answers.iter().filter(|(id, _)| reference.contains_key(id)).collect();
+    if shared.is_empty() {
+        return None;
+    }
+    Some(shared.iter().all(|(id, a)| reference[id] == **a))
+}
