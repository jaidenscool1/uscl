+/// The answers and the build they came from.
+pub fn read_answers(reader: &mut BdReader) -> Result<(Vec<(u64, i64)>, Vec<u8>), Box<dyn Error>> {
+    let count = reader.read_u16()?;
+    let mut answers = Vec::with_capacity(count as usize);
+    for _ in 0..count {
+        let id = reader.read_u64()?;
+        answers.push((id, reader.read_i64()?));
+    }
+    let info = reader.read_blob().unwrap_or_default();
+    Ok((answers, info.into_iter().take(6).collect()))
+}
