+/// Home copies of players who never logged in here get a user id below the game ids and far above RPCN's account
+/// numbers; their first login moves the rows to their real one (progress::seen).
+const PLACEHOLDER_BASE: u64 = 0xFFF0_0000;
+
+pub fn user_of(online_id: &str) -> Option<u64> {
+    PLAYER_ID_DB
+        // -1: bound to a Steam account before their user id here was known
+        .with_borrow(|db| db.query_row("SELECT user_id FROM player WHERE online_id = ?1 AND user_id >= 0", [online_id], |r| r.get::<_, i64>(0)))
+        .ok()
+        .map(|id| id as u64)
+}
+
+pub fn set_user(online_id: &str, user_id: u64) {
+    PLAYER_ID_DB.with_borrow(|db| {
+        db.execute(
+            "INSERT INTO player (online_id, user_id) VALUES (?1, ?2) ON CONFLICT(online_id) DO UPDATE SET user_id = ?2",
+            (online_id, user_id as i64),
+        )
+        .expect("player to be recorded");
+    });
+}
+
+/// `online_id`'s user id here, or a placeholder for a player who never logged in to this server.
+pub fn user_or_placeholder(online_id: &str) -> u64 {
+    user_of(online_id).unwrap_or_else(|| {
+        let n: i64 = PLAYER_ID_DB
+            .with_borrow(|db| db.query_row("SELECT count(*) FROM player WHERE user_id >= ?1", [PLACEHOLDER_BASE as i64], |r| r.get(0)))
+            .unwrap_or(0);
+        let id = PLACEHOLDER_BASE + n as u64;
+        set_user(online_id, id);
+        id
+    })
+}
+
+/// A Steam account carries one online id: the first bundle binds them, a bundle for it from another account is refused.
+pub fn bind_steam(online_id: &str, steam_id: u64) -> Result<(), String> {
+    PLAYER_ID_DB.with_borrow(|db| {
+        let bound: Option<i64> = db
+            .query_row("SELECT steam_id FROM player WHERE online_id = ?1", [online_id], |r| r.get(0))
+            .ok()
+            .flatten();
+        match bound {
+            Some(s) if s as u64 != steam_id => Err(format!("{online_id} belongs to another Steam account")),
+            _ => {
+                db.execute(
+                    "INSERT INTO player (online_id, user_id, steam_id) VALUES (?1, -1, ?2)
+                     ON CONFLICT(online_id) DO UPDATE SET steam_id = ?2",
+                    (online_id, steam_id as i64),
+                )
+                .map(|_| ())
+                .map_err(|e| e.to_string())
+            }
+        }
+    })
+}
+
+pub fn game_id_of(user_id: u64) -> Option<u64> {
+    PLAYER_ID_DB
+        .with_borrow(|db| db.query_row("SELECT game_id FROM game_id WHERE user_id = ?1", [user_id as i64], |r| r.get::<_, i64>(0)))
+        .ok()
+        .map(|id| id as u64)
+}
+
+/// `game_id` is `user_id`'s (from a bundle, or a player's user id changed).
+pub fn set_game_id(game_id: u64, user_id: u64) {
+    PLAYER_ID_DB.with_borrow(|db| {
+        db.execute("DELETE FROM game_id WHERE game_id = ?1 OR user_id = ?2", (game_id as i64, user_id as i64))
+            .and_then(|_| db.execute("INSERT INTO game_id (game_id, user_id) VALUES (?1, ?2)", (game_id as i64, user_id as i64)))
+            .expect("game id to be recorded");
+    });
+}
+
+pub fn set_pending(online_id: &str, bundle: &str) {
+    PLAYER_ID_DB.with_borrow(|db| {
+        db.execute("INSERT OR REPLACE INTO pending (online_id, bundle) VALUES (?1, ?2)", (online_id, bundle))
+            .expect("pending bundle to be stored");
+    });
+}
+
+pub fn take_pending(online_id: &str) -> Option<String> {
+    PLAYER_ID_DB.with_borrow(|db| {
+        let bundle = db.query_row("SELECT bundle FROM pending WHERE online_id = ?1", [online_id], |r| r.get(0)).ok();
+        if bundle.is_some() {
+            let _ = db.execute("DELETE FROM pending WHERE online_id = ?1", [online_id]);
+        }
+        bundle
+    })
+}
