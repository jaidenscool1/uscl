+    use super::*;
+
+    #[test]
+    fn hex_round_trip() {
+        assert_eq!(unhex(&hex(&[0, 1, 0xfe, 0xff])).unwrap(), vec![0, 1, 0xfe, 0xff]);
+        assert!(unhex("abc").is_err());
+        assert!(unhex("zz").is_err());
+    }
+
+    #[test]
+    fn bundle_json_round_trip() {
+        let b = Bundle {
+            online_id: "Pete_Hegseth".into(),
+            game_id: Some(15258544499090971638),
+            files: vec![File { title: 18396, filename: "mpClassSets".into(), visibility: 0, created: 1, modified: 2, data: "00ff".into() }],
+            profiles: vec![Profile { title: 18396, profile_type: 1, created: 1, modified: 2, data: "07".into() }],
+            streams: vec![Stream { title: 18396, filename: "emblem".into(), created: 1, modified: 2, category: 3, slot: 0, metadata: None, data: Some("01".into()), tags: vec![(1, 2)] }],
+        };
+        assert_eq!(serde_json::from_str::<Bundle>(&serde_json::to_string(&b).unwrap()).unwrap(), b);
+    }
+}
