--- /dev/null
+++ b/dw-server/src/lobby/progress.rs
@@ -0,0 +1,400 @@
+//! A player's progress as one bundle, so it travels with them (USCL PLAN.md "Progress travels with the player"):
+//! their own PC's uscl-dw is home, the host's gets the bundle when they join and gives it back. Files (stats,
+//! classes, backups), profiles and file-share streams (emblems), keyed by online id: the user id is an RPCN account
+//! number and differs on every host.
+use crate::lobby::content_streaming::db::CONTENT_STREAMING_DB;
+use crate::lobby::player_id;
+use crate::lobby::profile::db::PROFILE_DB;
+use crate::lobby::storage::db::STORAGE_DB;
+use crate::lobby::storage::stats_check;
+use bitdemon::networking::bd_session::BdSession;
+use log::{info, warn};
+use serde::{Deserialize, Serialize};
+use std::cell::RefCell;
+use std::collections::HashSet;
+
+#[derive(Serialize, Deserialize, Default, Debug, PartialEq)]
+pub struct Bundle {
+    pub online_id: String,
+    pub game_id: Option<u64>,
+    pub files: Vec<File>,
+    pub profiles: Vec<Profile>,
+    pub streams: Vec<Stream>,
+}
+
+#[derive(Serialize, Deserialize, Debug, PartialEq)]
+pub struct File {
+    pub title: u32,
+    pub filename: String,
+    pub visibility: u8,
+    pub created: i64,
+    pub modified: i64,
+    pub data: String, // hex
+}
+
+#[derive(Serialize, Deserialize, Debug, PartialEq)]
+pub struct Profile {
+    pub title: u32,
+    pub profile_type: u8,
+    pub created: i64,
+    pub modified: i64,
+    pub data: String,
+}
+
+#[derive(Serialize, Deserialize, Debug, PartialEq)]
+pub struct Stream {
+    pub title: u32,
+    pub filename: String,
+    pub created: i64,
+    pub modified: i64,
+    pub category: i64,
+    pub slot: i64,
+    pub metadata: Option<String>,
+    pub data: Option<String>,
+    pub tags: Vec<(i64, i64)>,
+}
+
+fn hex(data: &[u8]) -> String {
+    data.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn unhex(text: &str) -> Result<Vec<u8>, String> {
+    if text.len() % 2 != 0 {
+        return Err("odd hex length".into());
+    }
+    (0..text.len()).step_by(2).map(|i| u8::from_str_radix(&text[i..i + 2], 16).map_err(|e| e.to_string())).collect()
+}
+
+/// Everything of `user_id`'s on this server.
+pub fn export(online_id: &str, user_id: u64) -> Bundle {
+    let owner = user_id as i64;
+    let files = STORAGE_DB.with_borrow(|db| {
+        let mut stmt = db
+            .prepare("SELECT title, filename, visibility, created_at, modified_at, data FROM user_file WHERE owner_id = ?1")
+            .expect("query to prepare");
+        stmt.query_map([owner], |r| {
+            Ok(File { title: r.get(0)?, filename: r.get(1)?, visibility: r.get(2)?, created: r.get(3)?, modified: r.get(4)?, data: hex(&r.get::<_, Vec<u8>>(5)?) })
+        })
+        .and_then(|rows| rows.collect())
+        .unwrap_or_default()
+    });
+    let profiles = PROFILE_DB.with_borrow(|db| {
+        let mut stmt = db
+            .prepare("SELECT title, profile_type, created_at, modified_at, data FROM user_profile WHERE owner_id = ?1")
+            .expect("query to prepare");
+        stmt.query_map([owner], |r| {
+            Ok(Profile { title: r.get(0)?, profile_type: r.get(1)?, created: r.get(2)?, modified: r.get(3)?, data: hex(&r.get::<_, Vec<u8>>(4)?) })
+        })
+        .and_then(|rows| rows.collect())
+        .unwrap_or_default()
+    });
+    let streams = CONTENT_STREAMING_DB.with_borrow(|db| {
+        let mut stmt = db
+            .prepare("SELECT id, title, filename, created_at, modified_at, category, slot, metadata, data FROM user_stream WHERE owner_id = ?1")
+            .expect("query to prepare");
+        let rows: Vec<(i64, Stream)> = stmt
+            .query_map([owner], |r| {
+                Ok((
+                    r.get(0)?,
+                    Stream {
+                        title: r.get(1)?,
+                        filename: r.get(2)?,
+                        created: r.get(3)?,
+                        modified: r.get(4)?,
+                        category: r.get(5)?,
+                        slot: r.get(6)?,
+                        metadata: r.get::<_, Option<Vec<u8>>>(7)?.map(|m| hex(&m)),
+                        data: r.get::<_, Option<Vec<u8>>>(8)?.map(|d| hex(&d)),
+                        tags: Vec::new(),
+                    },
+                ))
+            })
+            .and_then(|rows| rows.collect())
+            .unwrap_or_default();
+        let mut tag_stmt = db
+            .prepare("SELECT primary_tag, secondary_tag FROM user_stream_tag WHERE stream_id = ?1")
+            .expect("query to prepare");
+        rows.into_iter()
+            .map(|(id, mut s)| {
+                s.tags = tag_stmt.query_map([id], |r| Ok((r.get(0)?, r.get(1)?))).and_then(|t| t.collect()).unwrap_or_default();
+                s
+            })
+            .collect()
+    });
+    Bundle { online_id: online_id.to_string(), game_id: player_id::game_id_of(user_id), files, profiles, streams }
+}
+
+/// Takes `bundle` as `user_id`'s: per item the newer copy wins, and a stats file must pass the stats check's bounds.
+/// Returns how many items were taken.
+pub fn import(bundle: &Bundle, user_id: u64) -> Result<usize, String> {
+    let owner = user_id as i64;
+    let mut taken = 0;
+    for f in &bundle.files {
+        let data = unhex(&f.data)?;
+        let ours: Option<(i64, i64, Vec<u8>)> = STORAGE_DB.with_borrow(|db| {
+            db.query_row(
+                "SELECT id, modified_at, data FROM user_file WHERE owner_id = ?1 AND title = ?2 AND filename = ?3",
+                (owner, f.title, f.filename.as_str()),
+                |r| Ok((r.get(0)?, r.get(1)?, r.get(2)?)),
+            )
+            .ok()
+        });
+        if ours.as_ref().is_some_and(|o| o.1 >= f.modified) {
+            continue;
+        }
+        // bounds only (no impossible rank, prestige or XP): a carried copy may be many matches ahead of ours (played
+        // on other hosts), so the one-match jump check of uploads doesn't apply
+        if f.filename == stats_check::MP_STATS_FILE {
+            if let Err(reason) = stats_check::check(None, &data) {
+                warn!("anticheat: {}'s carried stats refused ({reason}); the copy here stays", bundle.online_id);
+                continue;
+            }
+        }
+        STORAGE_DB.with_borrow(|db| match &ours {
+            Some(o) => db.execute(
+                "UPDATE user_file SET modified_at = ?2, visibility = ?3, data = ?4 WHERE id = ?1",
+                (o.0, f.modified, f.visibility, data),
+            ),
+            None => db.execute(
+                "INSERT INTO user_file (filename, title, created_at, modified_at, visibility, owner_id, data)
+                 VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)",
+                (f.filename.as_str(), f.title, f.created, f.modified, f.visibility, owner, data),
+            ),
+        })
+        .map_err(|e| e.to_string())?;
+        taken += 1;
+    }
+    for p in &bundle.profiles {
+        let data = unhex(&p.data)?;
+        let ours: Option<(i64, i64)> = PROFILE_DB.with_borrow(|db| {
+            db.query_row(
+                "SELECT id, modified_at FROM user_profile WHERE owner_id = ?1 AND title = ?2 AND profile_type = ?3",
+                (owner, p.title, p.profile_type),
+                |r| Ok((r.get(0)?, r.get(1)?)),
+            )
+            .ok()
+        });
+        if ours.is_some_and(|o| o.1 >= p.modified) {
+            continue;
+        }
+        PROFILE_DB.with_borrow(|db| match ours {
+            Some(o) => db.execute("UPDATE user_profile SET modified_at = ?2, data = ?3 WHERE id = ?1", (o.0, p.modified, data)),
+            None => db.execute(
+                "INSERT INTO user_profile (title, owner_id, profile_type, created_at, modified_at, data) VALUES (?1, ?2, ?3, ?4, ?5, ?6)",
+                (p.title, owner, p.profile_type, p.created, p.modified, data),
+            ),
+        })
+        .map_err(|e| e.to_string())?;
+        taken += 1;
+    }
+    for s in &bundle.streams {
+        let metadata = s.metadata.as_deref().map(unhex).transpose()?;
+        let data = s.data.as_deref().map(unhex).transpose()?;
+        let taken_stream = CONTENT_STREAMING_DB.with_borrow(|db| -> Result<bool, String> {
+            let ours: Option<(i64, i64)> = db
+                .query_row(
+                    "SELECT id, modified_at FROM user_stream WHERE owner_id = ?1 AND title = ?2 AND slot = ?3",
+                    (owner, s.title, s.slot),
+                    |r| Ok((r.get(0)?, r.get(1)?)),
+                )
+                .ok();
+            if ours.is_some_and(|o| o.1 >= s.modified) {
+                return Ok(false);
+            }
+            if let Some(o) = ours {
+                db.execute("DELETE FROM user_stream_tag WHERE stream_id = ?1", [o.0]).map_err(|e| e.to_string())?;
+                db.execute("DELETE FROM user_stream WHERE id = ?1", [o.0]).map_err(|e| e.to_string())?;
+            }
+            db.execute(
+                "INSERT INTO user_stream (filename, title, created_at, modified_at, owner_id, metadata, category, slot, data)
+                 VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)",
+                (s.filename.as_str(), s.title, s.created, s.modified, owner, metadata, s.category, s.slot, data),
+            )
+            .map_err(|e| e.to_string())?;
+            let id = db.last_insert_rowid();
+            for (primary, secondary) in &s.tags {
+                db.execute(
+                    "INSERT INTO user_stream_tag (stream_id, primary_tag, secondary_tag) VALUES (?1, ?2, ?3)",
+                    (id, primary, secondary),
+                )
+                .map_err(|e| e.to_string())?;
+            }
+            Ok(true)
+        })?;
+        taken += usize::from(taken_stream);
+    }
+    if let Some(game_id) = bundle.game_id {
+        player_id::set_game_id(game_id, user_id);
+    }
+    Ok(taken)
+}
+
+/// A player's rows move to a new user id (their RPCN account number here changed, or a home placeholder got a
+/// real one).
+fn move_rows(from: u64, to: u64) {
+    let (from, to) = (from as i64, to as i64);
+    STORAGE_DB.with_borrow(|db| db.execute("UPDATE user_file SET owner_id = ?2 WHERE owner_id = ?1", (from, to))).ok();
+    PROFILE_DB.with_borrow(|db| db.execute("UPDATE user_profile SET owner_id = ?2 WHERE owner_id = ?1", (from, to))).ok();
+    CONTENT_STREAMING_DB.with_borrow(|db| db.execute("UPDATE user_stream SET owner_id = ?2 WHERE owner_id = ?1", (from, to))).ok();
+    if let Some(game_id) = player_id::game_id_of(from as u64) {
+        player_id::set_game_id(game_id, to as u64);
+    }
+}
+
+/// A bundle arrived from the host's bridge (the player is joining): taken now if we know the player's user id
+/// here, else kept until their first login (`seen`).
+pub fn receive(bundle_json: &str, steam_id: u64) -> Result<&'static str, String> {
+    let bundle: Bundle = serde_json::from_str(bundle_json).map_err(|e| e.to_string())?;
+    player_id::bind_steam(&bundle.online_id, steam_id)?;
+    match player_id::user_of(&bundle.online_id) {
+        Some(user_id) => {
+            let taken = import(&bundle, user_id)?;
+            info!("progress: took {taken} items of {}'s carried progress", bundle.online_id);
+            Ok("applied")
+        }
+        None => {
+            player_id::set_pending(&bundle.online_id, bundle_json);
+            info!("progress: {}'s carried progress waits for their login", bundle.online_id);
+            Ok("pending")
+        }
+    }
+}
+
+/// `dw-server --export <online id>` prints this server's copy of a player's progress (empty if it has none);
+/// `dw-server --import` takes a bundle from stdin into it (the player's own PC, after a session elsewhere). `None`:
+/// neither, start the servers.
+pub fn cli(args: &[String]) -> Option<i32> {
+    match args.get(1).map(String::as_str) {
+        Some("--export") => {
+            let Some(online_id) = args.get(2) else {
+                eprintln!("usage: dw-server --export <online id>");
+                return Some(2);
+            };
+            let bundle = match player_id::user_of(online_id) {
+                Some(user_id) => export(online_id, user_id),
+                None => Bundle { online_id: online_id.clone(), ..Default::default() },
+            };
+            println!("{}", serde_json::to_string(&bundle).expect("bundle to serialize"));
+            Some(0)
+        }
+        Some("--import") => {
+            let mut json = String::new();
+            let result = std::io::Read::read_to_string(&mut std::io::stdin(), &mut json)
+                .map_err(|e| e.to_string())
+                .and_then(|_| serde_json::from_str::<Bundle>(&json).map_err(|e| e.to_string()))
+                .and_then(|bundle| import(&bundle, player_id::user_or_placeholder(&bundle.online_id)).map(|n| (bundle.online_id, n)));
+            match result {
+                Ok((online_id, taken)) => {
+                    eprintln!("took {taken} items of {online_id}'s progress");
+                    Some(0)
+                }
+                Err(e) => {
+                    eprintln!("import failed: {e}");
+                    Some(1)
+                }
+            }
+        }
+        _ => None,
+    }
+}
+
+/// The host's bridge hands in members' bundles here, with the Steam id the Steam session authenticated
+/// (`POST /progress`, header `x-uscl-steam-id`), and fetches their updated copies (`GET /progress/<online id>`).
+/// Local only (DW_ADMIN_ADDR, default 127.0.0.1:3180): bridges don't forward this port, so a member can't hand in
+/// someone else's progress.
+pub async fn serve_admin() {
+    use axum::Router;
+    use axum::routing::{get, post};
+    let addr = std::env::var("DW_ADMIN_ADDR").unwrap_or_else(|_| "127.0.0.1:3180".into());
+    let app = Router::new().route("/progress", post(post_progress)).route("/progress/{online_id}", get(get_progress));
+    match tokio::net::TcpListener::bind(&addr).await {
+        Ok(listener) => {
+            info!("progress: admin on {addr}");
+            if let Err(e) = axum::serve(listener, app).await {
+                warn!("progress: admin stopped: {e}");
+            }
+        }
+        Err(e) => warn!("progress: can't open admin on {addr}: {e} (carried progress is off)"),
+    }
+}
+
+async fn post_progress(headers: axum::http::HeaderMap, body: String) -> (axum::http::StatusCode, String) {
+    use axum::http::StatusCode;
+    let Some(steam_id) = headers.get("x-uscl-steam-id").and_then(|v| v.to_str().ok()).and_then(|v| v.parse::<u64>().ok()) else {
+        return (StatusCode::BAD_REQUEST, "x-uscl-steam-id missing".into());
+    };
+    match tokio::task::spawn_blocking(move || receive(&body, steam_id)).await {
+        Ok(Ok(state)) => (StatusCode::OK, state.into()),
+        Ok(Err(e)) => {
+            warn!("progress: bundle refused: {e}");
+            (StatusCode::FORBIDDEN, e)
+        }
+        Err(e) => (StatusCode::INTERNAL_SERVER_ERROR, e.to_string()),
+    }
+}
+
+async fn get_progress(axum::extract::Path(online_id): axum::extract::Path<String>) -> (axum::http::StatusCode, String) {
+    use axum::http::StatusCode;
+    let found = tokio::task::spawn_blocking(move || {
+        player_id::user_of(&online_id).map(|user_id| serde_json::to_string(&export(&online_id, user_id)).expect("bundle to serialize"))
+    })
+    .await;
+    match found {
+        Ok(Some(json)) => (StatusCode::OK, json),
+        Ok(None) => (StatusCode::NOT_FOUND, String::new()),
+        Err(e) => (StatusCode::INTERNAL_SERVER_ERROR, e.to_string()),
+    }
+}
+
+thread_local! {
+    static SEEN: RefCell<HashSet<(u64, String)>> = RefCell::new(HashSet::new());
+}
+
+/// Every service a login reaches first calls this: remembers who the player is here, moves their rows if their user
+/// id changed, and takes a bundle that waited for them, all before their game reads anything.
+pub fn seen(session: &BdSession) {
+    let Some(auth) = session.authentication() else { return };
+    let key = (auth.user_id, auth.username.clone());
+    if SEEN.with_borrow(|s| s.contains(&key)) {
+        return;
+    }
+    match player_id::user_of(&auth.username) {
+        Some(old) if old != auth.user_id => {
+            info!("progress: {} is user {} here now (was {old})", auth.username, auth.user_id);
+            move_rows(old, auth.user_id);
+        }
+        _ => {}
+    }
+    player_id::set_user(&auth.username, auth.user_id);
+    if let Some(json) = player_id::take_pending(&auth.username) {
+        match serde_json::from_str::<Bundle>(&json).map_err(|e| e.to_string()).and_then(|b| import(&b, auth.user_id)) {
+            Ok(taken) => info!("progress: took {taken} items of {}'s carried progress at login", auth.username),
+            Err(e) => warn!("progress: {}'s carried progress couldn't be taken: {e}", auth.username),
+        }
+    }
+    SEEN.with_borrow_mut(|s| s.insert(key));
+}
+
+#[cfg(test)]
