+//! PS3 login (`Ps3ForMmpRequest`), as Black Ops II 1.19 (T6Ps3) does it.
+//!
+//! The game makes a random 24-byte key and sends it as the cookie of its PSN ticket request, so the ticket it
+//! passes here carries the key. The reply ticket is 3DES-encrypted with that key; the session key inside it is ours.
+//! Tickets come from RPCN (Sony's ticket 2.1 layout), whose cookie sits where a real PSN ticket's does.
+use crate::auth::auth_handler::{AuthHandler, AuthMessageType};
+use crate::auth::auth_proof::ClientOpaqueAuthProof;
+use crate::auth::key_store::ThreadSafeBackendPrivateKeyStorage;
+use crate::auth::response::AuthResponse;
+use crate::auth::result::auth_ticket::{AuthTicket, BdAuthTicketType};
+use crate::crypto::{encrypt_buffer_in_place, generate_iv_from_seed, generate_iv_seed};
+use crate::domain::title::Title;
+use crate::messaging::bd_message::BdMessage;
+use crate::messaging::bd_serialization::BdSerialize;
+use crate::messaging::bd_writer::BdWriter;
+use crate::messaging::{BdErrorCode, StreamMode};
+use crate::networking::bd_session::BdSession;
+use chrono::Utc;
+use log::info;
+use num_traits::FromPrimitive;
+use snafu::{OptionExt, Snafu, ensure};
+use std::error::Error;
+use std::sync::Arc;
+
+const TICKET_ISSUE_LENGTH: i64 = 5 * 60 * 1000;
+/// BO2 decrypts exactly this many ticket bytes (0x4c0 bits).
+const ENCRYPTED_TICKET_LEN: usize = 152;
+const MAX_NP_TICKET_LEN: usize = 1024;
+
+#[derive(Debug, Snafu)]
+enum Ps3AuthError {
+    #[snafu(display("The title id is unknown (value={title_id})"))]
+    UnknownTitle { title_id: u32 },
+    #[snafu(display("The NP ticket is too long (len={len} max={MAX_NP_TICKET_LEN})"))]
+    TicketTooLong { len: usize },
+    #[snafu(display("The NP ticket is malformed"))]
+    BadTicket,
+    #[snafu(display("The NP ticket has no 24-byte cookie (the client's key)"))]
+    NoCookie,
+}
+
+/// What the server needs from a PSN/RPCN ticket.
+#[derive(Debug, PartialEq)]
+pub struct NpTicket {
+    pub user_id: u64,
+    pub online_id: String,
+    pub cookie: Option<[u8; 24]>,
+}
+
+/// One typed field: (type id, data).
+fn np_fields(mut data: &[u8]) -> Option<Vec<(u16, &[u8])>> {
+    let mut out = Vec::new();
+    while !data.is_empty() {
+        let (head, rest) = data.split_at_checked(4)?;
+        let id = u16::from_be_bytes([head[0], head[1]]);
+        let len = u16::from_be_bytes([head[2], head[3]]) as usize;
+        let (value, rest) = rest.split_at_checked(len)?;
+        out.push((id, value));
+        data = rest;
+    }
+    Some(out)
+}
+
+/// Sony ticket 2.x: [u32 version][u32 size][user blob 0x3000][signature blob 0x3002]. The user blob's fields are
+/// serial, issuer, issued, expires, user id, online id, region, domain, service id, status, then the cookie if any.
+pub fn parse_np_ticket(ticket: &[u8]) -> Option<NpTicket> {
+    let body = ticket.get(8..)?;
+    let (blob_id, user) = *np_fields(body)?.first()?;
+    if blob_id != 0x3000 {
+        return None;
+    }
+    let fields = np_fields(user)?;
+    let user_id = u64::from_be_bytes(fields.get(4).filter(|f| f.0 == 2)?.1.try_into().ok()?);
+    let online_id = fields.get(5).filter(|f| f.0 == 4)?.1;
+    let online_id = String::from_utf8_lossy(online_id.split(|b| *b == 0).next()?).into_owned();
+    let cookie = fields.get(10).filter(|f| f.0 == 8).and_then(|f| f.1.try_into().ok());
+    Some(NpTicket { user_id, online_id, cookie })
+}
+
+pub struct Ps3AuthHandler {
+    key_store: Arc<ThreadSafeBackendPrivateKeyStorage>,
+}
+
+impl Ps3AuthHandler {
+    pub fn new(key_store: Arc<ThreadSafeBackendPrivateKeyStorage>) -> Self {
+        Ps3AuthHandler { key_store }
+    }
+}
+
+struct Ps3AuthResponse {
+    ticket: AuthTicket,
+    client_key: [u8; 24],
+    serialized_proof_data: [u8; 128],
+}
+
+impl AuthResponse for Ps3AuthResponse {
+    fn message_type(&self) -> AuthMessageType {
+        AuthMessageType::Ps3ForMmpReply
+    }
+
+    fn error_code(&self) -> BdErrorCode {
+        BdErrorCode::AuthNoError
+    }
+
+    fn write_auth_data(&self, writer: &mut BdWriter) -> Result<(), Box<dyn Error>> {
+        let seed = generate_iv_seed();
+        writer.write_u32(seed)?;
+
+        let mut ticket_buf = Vec::new();
+        {
+            let mut ticket_writer = BdWriter::new(&mut ticket_buf);
+            self.ticket.serialize(&mut ticket_writer)?;
+        }
+        ticket_buf.resize(ENCRYPTED_TICKET_LEN, 0);
+        encrypt_buffer_in_place(&mut ticket_buf, &self.client_key, &generate_iv_from_seed(seed));
+        writer.write_bytes(ticket_buf.as_slice())?;
+
+        writer.write_bytes(&self.serialized_proof_data)?;
+        Ok(())
+    }
+}
+
+impl AuthHandler for Ps3AuthHandler {
+    fn handle_message(
+        &self,
+        _session: &mut BdSession,
+        mut message: BdMessage,
+    ) -> Result<Box<dyn AuthResponse>, Box<dyn Error>> {
+        message.reader.set_mode(StreamMode::BitMode);
+        message.reader.read_type_checked_bit()?;
+
+        let iv_seed = message.reader.read_u32()?;
+        let title_id = message.reader.read_u32()?;
+        let title = Title::from_u32(title_id).with_context(|| UnknownTitleSnafu { title_id })?;
+        let len = message.reader.read_u32()? as usize;
+        ensure!(len <= MAX_NP_TICKET_LEN, TicketTooLongSnafu { len });
+        let mut np_ticket = vec![0u8; len];
+        message.reader.read_bytes(&mut np_ticket)?;
+        // shortcut: the optional 8-byte key proof after the ticket isn't checked; check it, and the RPCN ticket
+        // signature, before this faces strangers
+        let np = parse_np_ticket(&np_ticket).context(BadTicketSnafu)?;
+        let client_key = np.cookie.context(NoCookieSnafu)?;
+
+        info!(
+            "Trying to auth with PS3 iv_seed={iv_seed:x} title={title:?} user_id={} online_id={}",
+            np.user_id, np.online_id
+        );
+
+        let now = Utc::now();
+        let issued = (now.timestamp() % (u32::MAX as i64)) as u32;
+        let expires_i64 = now.timestamp() + TICKET_ISSUE_LENGTH;
+        let expires = (expires_i64 % (u32::MAX as i64)) as u32;
+
+        let ticket = AuthTicket {
+            ticket_type: BdAuthTicketType::UserToService,
+            title,
+            time_issued: issued,
+            time_expires: expires,
+            license_id: 1234u64,
+            user_id: np.user_id,
+            username: np.online_id,
+            session_key: rand::random(),
+        };
+
+        let proof = ClientOpaqueAuthProof {
+            title: ticket.title,
+            time_expires: expires_i64,
+            license_id: ticket.license_id,
+            user_id: ticket.user_id,
+            session_key: ticket.session_key,
+            username: String::from(&ticket.username),
+        };
+        let serialized_proof_data = proof.serialize(self.key_store.as_ref());
+
+        Ok(Box::new(Ps3AuthResponse { ticket, client_key, serialized_proof_data }))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Same layout RPCN's Ticket::generate_blob produces.
+    fn rpcn_ticket(cookie: &[u8]) -> Vec<u8> {
+        fn field(id: u16, data: &[u8]) -> Vec<u8> {
+            let mut f = id.to_be_bytes().to_vec();
+            f.extend((data.len() as u16).to_be_bytes());
+            f.extend(data);
+            f
+        }
+        let mut online = b"uscltest".to_vec();
+        online.resize(0x20, 0);
+        let mut user = Vec::new();
+        user.extend(field(8, &[b'1'; 0x14]));
+        user.extend(field(1, &0x100u32.to_be_bytes()));
+        user.extend(field(7, &1u64.to_be_bytes()));
+        user.extend(field(7, &2u64.to_be_bytes()));
+        user.extend(field(2, &42u64.to_be_bytes()));
+        user.extend(field(4, &online));
+        user.extend(field(8, b"br\0\0"));
+        user.extend(field(4, b"un\0\0"));
+        user.extend(field(8, &[0; 0x18]));
+        user.extend(field(1, &0u32.to_be_bytes()));
+        if !cookie.is_empty() {
+            user.extend(field(8, cookie));
+        }
+        user.extend(field(0, &[]));
+        user.extend(field(0, &[]));
+        let mut body = field(0x3000, &user);
+        body.extend(field(0x3002, &[0; 8]));
+        let mut t = 0x21010000u32.to_be_bytes().to_vec();
+        t.extend((body.len() as u32).to_be_bytes());
+        t.extend(body);
+        t
+    }
+
+    #[test]
+    fn reads_rpcn_ticket() {
+        let t = parse_np_ticket(&rpcn_ticket(&[7; 24])).unwrap();
+        assert_eq!(t, NpTicket { user_id: 42, online_id: "uscltest".into(), cookie: Some([7; 24]) });
+        assert_eq!(parse_np_ticket(&rpcn_ticket(&[])).unwrap().cookie, None);
+        let good = rpcn_ticket(&[7; 24]);
+        assert_eq!(parse_np_ticket(&good[..good.len() - 30]), None);
+        assert_eq!(parse_np_ticket(&[]), None);
+    }
+}
