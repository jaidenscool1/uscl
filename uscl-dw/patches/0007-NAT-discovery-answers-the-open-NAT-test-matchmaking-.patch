 impl MatchmakingHandler {
-    pub fn new() -> MatchmakingHandler {
-        MatchmakingHandler::default()
+    pub fn new(session_manager: Arc<SessionManager>) -> Arc<MatchmakingHandler> {
+        let handler = Arc::new(MatchmakingHandler::default());
+        let weak = Arc::downgrade(&handler);
+        session_manager.on_session_unregistered(move |connection| {
+            if let Some(handler) = weak.upgrade() {
+                let mut sessions = handler.sessions.lock().unwrap();
+                let before = sessions.len();
+                sessions.retain(|s| s.connection != connection.id);
+                if sessions.len() != before {
+                    info!("Matchmaking: closed {} session(s) of a disconnected host", before - sessions.len());
+                }
+            }
+        });
+        handler
     }
 }
 
