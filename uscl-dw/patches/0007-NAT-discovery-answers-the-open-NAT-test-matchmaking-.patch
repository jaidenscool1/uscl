diff --git a/dw-server/src/stun.rs b/dw-server/src/stun.rs
index 1819c0b..40a4d1b 100644
--- a/dw-server/src/stun.rs
+++ b/dw-server/src/stun.rs
@@ -3,10 +3,11 @@
 //! little-endian.
 //!   1e 02 00            -> 1f 02 00 <sender addr>
 //!   14 02 00 <mode>     -> 15 02 00 <sender addr> <second server addr>
-//! The client also asks the second server, which answers the same way; replying to everything makes the NAT
-//! look open, which is right on a LAN or inside the session tunnel.
+//! Mode 3 asks for the reply from the second server's IP on another port; a NAT that lets it through is
+//! "open". We send it, so titles see an open NAT, which is right on a LAN or inside the session tunnel.
 use log::info;
 use std::net::{SocketAddr, SocketAddrV4};
+use std::sync::Arc;
 use tokio::net::UdpSocket;
 
 fn addr_bytes(addr: SocketAddrV4) -> [u8; 6] {
@@ -25,20 +26,33 @@ pub fn reply(request: &[u8], sender: SocketAddrV4, second_server: SocketAddrV4)
     }
 }
 
-async fn serve(socket: UdpSocket, second_server: SocketAddrV4) {
+/// Which server socket answers (index into [primary, primary port+1, alt, alt port+1]). Read from the client
+/// (t6mp 0x00802f50): mode 3 is answered from the second server's IP on another port and means "open" when it
+/// arrives; mode 2 goes to the second server and only compares the mapped address (moderate / strict).
+fn responder(received_on: usize, request: &[u8]) -> usize {
+    match request {
+        [0x14, 0x02, 0x00, 0x03, ..] => ((received_on & !1) + 2) % 4 + 1,
+        _ => received_on,
+    }
+}
+
+async fn serve(sockets: Arc<Vec<UdpSocket>>, index: usize, second_server: SocketAddrV4) {
     let mut buf = [0u8; 1500];
     loop {
-        let Ok((len, SocketAddr::V4(sender))) = socket.recv_from(&mut buf).await else {
+        let Ok((len, SocketAddr::V4(sender))) = sockets[index].recv_from(&mut buf).await else {
             continue;
         };
         if let Some(answer) = reply(&buf[..len], sender, second_server) {
-            let _ = socket.send_to(&answer, sender).await;
+            let out = responder(index, &buf[..len]);
+            info!("stun {:02x?} from {sender}, answered from {:?}", &buf[..len.min(4)], sockets[out].local_addr());
+            let _ = sockets[out].send_to(&answer, sender).await;
         }
     }
 }
 
-/// Starts the NAT discovery server if DW_STUN_ADDR is set (DW_STUN_ALT_ADDR: the second server, default the
-/// same address).
+/// Starts the NAT discovery server if DW_STUN_ADDR is set. DW_STUN_ALT_ADDR is the second server (another IP);
+/// both also listen on port + 1, so the "reply from another IP / port" tests succeed and titles see an open
+/// NAT, which is what a LAN or the session tunnel is.
 pub async fn start() {
     let Ok(primary) = std::env::var("DW_STUN_ADDR") else {
         return;
@@ -47,18 +61,25 @@ pub async fn start() {
     let (Ok(primary_addr), Ok(alt_addr)) = (primary.parse::<SocketAddrV4>(), alt.parse::<SocketAddrV4>()) else {
         panic!("DW_STUN_ADDR / DW_STUN_ALT_ADDR must be IPv4 addr:port");
     };
-    for addr in if primary_addr == alt_addr { vec![primary_addr] } else { vec![primary_addr, alt_addr] } {
-        let socket = UdpSocket::bind(addr)
-            .await
-            .unwrap_or_else(|e| panic!("Failed to open NAT discovery socket on {addr}: {e}"));
+    let next_port = |a: SocketAddrV4| SocketAddrV4::new(*a.ip(), a.port() + 1);
+    let mut sockets = Vec::new();
+    for addr in [primary_addr, next_port(primary_addr), alt_addr, next_port(alt_addr)] {
+        sockets.push(
+            UdpSocket::bind(addr)
+                .await
+                .unwrap_or_else(|e| panic!("Failed to open NAT discovery socket on {addr}: {e}")),
+        );
         info!("NAT discovery (stun) on udp {addr}");
-        tokio::spawn(serve(socket, alt_addr));
+    }
+    let sockets = Arc::new(sockets);
+    for index in 0..4 {
+        tokio::spawn(serve(sockets.clone(), index, alt_addr));
     }
 }
 
 #[cfg(test)]
 mod tests {
-    use super::reply;
+    use super::{reply, responder};
     use std::net::{Ipv4Addr, SocketAddrV4};
 
     #[test]
@@ -72,5 +93,9 @@ mod tests {
             [0x15, 2, 0, 4, 0x2b, 0xf5, 0x66, 0x04, 0x0c, 0xb9, 0x22, 0x6b, 0x81, 0x02, 0x0c]
         );
         assert!(reply(&[0x0e, 0x02, 0x00], me, second).is_none());
+        // sockets: 0 primary, 1 primary port+1, 2 alt, 3 alt port+1
+        assert_eq!(responder(0, &[0x14, 2, 0, 0]), 0);
+        assert_eq!(responder(0, &[0x14, 2, 0, 3]), 3);
+        assert_eq!(responder(2, &[0x14, 2, 0, 2]), 2);
     }
 }
