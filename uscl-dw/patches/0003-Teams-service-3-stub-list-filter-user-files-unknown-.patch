+
+/// The owner's files (or, for anyone else, the public ones) whose name starts with `prefix`, oldest first.
+fn query_files(
+    session: &BdSession,
+    owner_id: u64,
+    min_date_time: i64,
+    offset: usize,
+    count: usize,
+    prefix: &str,
+) -> Result<ResultSlice<StorageFileInfo>, StorageServiceError> {
+    let auth = session.authentication().unwrap();
+    let (title, is_owner) = (auth.title, auth.user_id == owner_id);
+
+    let files: rusqlite::Result<Vec<StorageFileInfo>> = STORAGE_DB.with_borrow(|db| {
+        let mut stmt = db.prepare(
+            "SELECT u.id, u.filename, length(u.data), u.created_at, u.modified_at, u.visibility
+                 FROM user_file u
+                 WHERE u.owner_id = ?1 AND u.title = ?2 AND u.modified_at >= ?3
+                   AND substr(u.filename, 1, length(?4)) = ?4 AND (?5 OR u.visibility = ?6)
+                 ORDER BY u.id LIMIT ?7 OFFSET ?8",
+        )?;
+        stmt.query_map(
+            (
+                owner_id,
+                from_title(title),
+                min_date_time,
+                prefix,
+                is_owner,
+                from_file_visibility(FileVisibility::VisiblePublic),
+                count as i64,
+                offset as i64,
+            ),
+            |row| {
+                Ok(StorageFileInfo {
+                    id: row.get(0)?,
+                    filename: row.get(1)?,
+                    title,
+                    file_size: row.get(2)?,
+                    created: row.get(3)?,
+                    modified: row.get(4)?,
+                    visibility: to_file_visibility(row.get(5)?),
+                    owner_id,
+                })
+            },
+        )?
+        .collect()
+    });
+
+    let files = files.map_err(|e| {
+        warn!("Listing files failed: {e}");
+        StorageServiceError::StorageFileNotFoundError
+    })?;
+    Ok(ResultSlice::new(files, offset))
+}
