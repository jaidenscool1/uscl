+// USCL: the wireless link goes through uscl-bridge on this PC (127.0.0.1:7064), which carries it over Steam.
+// "host": this player's session; "join": the session uscl-bridge joined; "off": back to local. Main thread.
+static std::mutex usclLinkMutex;     // the join thread holds it while it uses the LAN object
+static int usclLinkGen = 0;          // a newer call stops the older join thread
+
+void usclStartLink(const std::string& role)
+{
+    std::lock_guard<std::mutex> lock(usclLinkMutex);
+    int gen = ++usclLinkGen;
+    if (role == "off")
+    {
+        setMPInterface(MPInterface_Local);
+        return;
+    }
+    setMPInterface(MPInterface_LAN);   // a new LAN object: the old session ends
+    LAN& lan = (LAN&)MPInterface::Get();
+    lan.LoopbackOnly = true;
+    std::string player = Config::GetGlobalTable().GetString("LAN.PlayerName");
+    if (player.empty()) player = "USCL";
+    if (role == "host")
+    {
+        if (!lan.StartHost(player.c_str(), 16))
+            Log(LogLevel::Error, "USCL: can't host the link on 127.0.0.1:7064\n");
+        return;
+    }
+    // the host may come up later: keep trying (StartClient waits up to 5 s each time)
+    std::thread([gen, player]() {
+        for (;;)
+        {
+            {
+                std::lock_guard<std::mutex> lock(usclLinkMutex);
+                if (gen != usclLinkGen) return;
+                if (((LAN&)MPInterface::Get()).StartClient(player.c_str(), "127.0.0.1"))
+                {
+                    Log(LogLevel::Info, "USCL: link joined\n");
+                    return;
+                }
+            }
+            std::this_thread::sleep_for(std::chrono::seconds(2));
+        }
+    }).detach();
+}
+
 void setMPInterface(MPInterfaceType type)
 {
     // switch to the requested MP interface
