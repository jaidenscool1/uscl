+		let bind_addr_ipv4 = format!("{}:{port}", self.host_ipv4.clone());
 		self.socket = Some({
 			let sock_res = UdpServer::try_to_bind_ipv6(&bind_addr_ipv6);
 			if let Err(e) = sock_res {
