From 87cd0628dad8c2b19419e3810383d120aa8f022c Mon Sep 17 00:00:00 2001
From: HempFiend <17104973+jaidenscool1@users.noreply.github.com>
Date: Fri, 27 Nov 2026 03:28:40 -0700
Subject: [PATCH] shader: buffers by descriptor on NVIDIA (no bounds branch per
 dword)

The buffer table variant reads every buffer by device address: robustBufferAccess2 cannot
apply, so each dword of a scalar or vector buffer load gets its own bounds compare, branch and
64-bit address math (Marvel's Wolverine's top pixel shader: 139 such loads, 229 branches).
With robustBufferAccess2 the descriptor variant loads without them (0 and 86).

On NVIDIA with robustBufferAccess2 programs now take the descriptor variant; other GPUs keep
the table (not measured). KYTY_BUFFER_TABLE=0/1 picks either for A/B and is part of the
precompile origin.

Wolverine's first fight, RTX 4060, 1664x936, 4 runs each: GPU work 47.7 -> 42.7 ms a frame
(a skinning dispatch 2.6 -> 0.8 ms, the top pixel pass 5.2 -> 4.5 ms); the command processor
thread +3 %, so fps 15.1 -> 15.4 (it now paces the frame). Screens match.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../renderer/pipeline/shaderPrecompile.cpp     |  4 ++--
 .../presentation/window/vulkanWindow.cpp       | 11 +++++++++++
 .../ir/passes/ResourceMaterialization.cpp      | 18 +++++++++++++++++-
 .../ir/passes/ResourceMaterialization.h        |  4 ++++
 4 files changed, 34 insertions(+), 3 deletions(-)

diff --git a/src/graphics/host_gpu/renderer/pipeline/shaderPrecompile.cpp b/src/graphics/host_gpu/renderer/pipeline/shaderPrecompile.cpp
index 574556ba..9a88d251 100644
--- a/src/graphics/host_gpu/renderer/pipeline/shaderPrecompile.cpp
+++ b/src/graphics/host_gpu/renderer/pipeline/shaderPrecompile.cpp
@@ -531,7 +531,7 @@ uint64_t Origin() {
 		// KYTY_UPSTREAM_PATHS and KYTY_LEAN_PATHS (common/upstreamPaths.h) pick between upstream's and lean's code,
 		// some of it in the recompiler.
 		for (const char* name: {"KYTY_GPL", "KYTY_IMAGE_HEAP", "KYTY_IMAGE_FORMS", "KYTY_NULL_IMAGE_DIMS",
-		                         "KYTY_UPSTREAM_PATHS", "KYTY_LEAN_PATHS", "KYTY76_LDS_SYNC"}) {
+		                         "KYTY_UPSTREAM_PATHS", "KYTY_LEAN_PATHS", "KYTY76_LDS_SYNC", "KYTY_BUFFER_TABLE"}) {
 			const char* value = std::getenv(name);
 			text += fmt::format("|{}={}", name, value != nullptr ? value : "");
 		}
@@ -622,7 +622,7 @@ bool MigrateBufferTable(Journal& journal) {
 	// Old stage key -> its key in this run's variant, for the stages that moved.
 	std::unordered_map<uint64_t, uint64_t> keys;
 	for (auto& record: journal.stages) {
-		const bool want = !record.specialization.buffers.empty();
+		const bool want = !record.specialization.buffers.empty() && ShaderRecompiler::IR::BufferTableEnabled();
 		if (record.specialization.buffer_table == want) continue;
 		const auto key                    = record.Key();
 		record.specialization.buffer_table = want;
diff --git a/src/graphics/presentation/window/vulkanWindow.cpp b/src/graphics/presentation/window/vulkanWindow.cpp
index fb486780..ffbb6d83 100644
--- a/src/graphics/presentation/window/vulkanWindow.cpp
+++ b/src/graphics/presentation/window/vulkanWindow.cpp
@@ -22,6 +22,7 @@
 #include "graphics/presentation/window.h"
 #include "graphics/presentation/window/windowInternal.h"
 #include "graphics/shader/recompiler/backend/spirv/SpirvEmitter.h"
+#include "graphics/shader/recompiler/ir/passes/ResourceMaterialization.h"
 #include "kernel/memory.h"
 #include "libs/controller.h"
 #include "loader/systemContent.h"
@@ -528,6 +529,14 @@ static void EnablePageableMemory(GraphicContext& graphics, const std::vector<con
 	info.pNext              = &features.pageable;
 }
 
+// Buffers by descriptor on NVIDIA: with robustBufferAccess2 a read needs no bounds branch, where the buffer table reads
+// every dword by address behind a branch of its own. Marvel's Wolverine's fight on an RTX 4060: ~5 ms less GPU work a
+// frame of ~48 (a skinning dispatch 2.6 -> 0.8 ms). Other GPUs keep the table (not measured). KYTY_BUFFER_TABLE=0/1 overrides.
+static void SetBufferTableDefault(const GraphicContext& graphics) {
+	ShaderRecompiler::IR::SetBufferTableDefault(
+	    !(graphics.physical_device_properties.vendorID == 0x10deu && graphics.robust_buffer_access2));
+}
+
 static vk::Device VulkanCreateDevice(GraphicContext& graphics, vk::SurfaceKHR surface,
 	                                 const std::vector<const char*>& device_extensions) {
 	const auto physical_device = graphics.physical_device;
@@ -923,6 +932,7 @@ static vk::Device VulkanCreateDevice(GraphicContext& graphics, vk::SurfaceKHR su
 #endif
 	robustness2.robustBufferAccess2 = supported_robustness2.robustBufferAccess2;
 	graphics.robust_buffer_access2  = robustness2.robustBufferAccess2 == VK_TRUE;
+	SetBufferTableDefault(graphics);
 	robustness2.robustImageAccess2  = supported_robustness2.robustImageAccess2;
 	robustness2.nullDescriptor      = VK_TRUE;
 
@@ -1320,6 +1330,7 @@ static vk::Device VulkanCreateDeviceChains(GraphicContext& graphics, vk::Surface
 	robustness2.robustImageAccess2  = supported_robustness2.robustImageAccess2;
 	robustness2.nullDescriptor      = VK_TRUE;
 	graphics.robust_buffer_access2  = robustness2.robustBufferAccess2 == VK_TRUE;
+	SetBufferTableDefault(graphics);
 
 	auto features13                 = WindowContext::RequiredVulkan13Features();
 	features13.robustImageAccess    = supported13.robustImageAccess;
diff --git a/src/graphics/shader/recompiler/ir/passes/ResourceMaterialization.cpp b/src/graphics/shader/recompiler/ir/passes/ResourceMaterialization.cpp
index 9401adb2..343d7966 100644
--- a/src/graphics/shader/recompiler/ir/passes/ResourceMaterialization.cpp
+++ b/src/graphics/shader/recompiler/ir/passes/ResourceMaterialization.cpp
@@ -8,6 +8,7 @@
 #include "graphics/shader/recompiler/ir/passes/ImageForms.h"
 #include "graphics/shader/shaderBindings.h"
 
+#include <atomic>
 #include <cstdlib>
 #include <algorithm>
 #include <array>
@@ -2861,8 +2862,23 @@ static bool MaterializeResourcesImpl(const ResourcePlan& program, const SrtRunti
                                      ResourceSnapshot& snapshot, ResourceSpecialization& specialization,
                                      const std::vector<uint32_t>* walked);
 
+static std::atomic<bool> g_buffer_table_default {true};
+
+void SetBufferTableDefault(bool enabled) {
+	g_buffer_table_default.store(enabled, std::memory_order_relaxed);
+}
+
+bool BufferTableEnabled() {
+	// KYTY_BUFFER_TABLE=0/1 picks the variant for A/B; unset, the device's default (SetBufferTableDefault).
+	static const int forced = [] {
+		const char* v = std::getenv("KYTY_BUFFER_TABLE");
+		return v == nullptr || v[0] == '\0' ? -1 : (v[0] != '0' ? 1 : 0);
+	}();
+	return forced >= 0 ? forced != 0 : g_buffer_table_default.load(std::memory_order_relaxed);
+}
+
 bool BufferTableWanted(const ResourcePlan& program) {
-	return !program.info.buffers.empty();
+	return !program.info.buffers.empty() && BufferTableEnabled();
 }
 
 bool MaterializeResources(const ResourcePlan& program, const SrtRuntime& runtime,
diff --git a/src/graphics/shader/recompiler/ir/passes/ResourceMaterialization.h b/src/graphics/shader/recompiler/ir/passes/ResourceMaterialization.h
index f4316233..fb4ed998 100644
--- a/src/graphics/shader/recompiler/ir/passes/ResourceMaterialization.h
+++ b/src/graphics/shader/recompiler/ir/passes/ResourceMaterialization.h
@@ -76,6 +76,10 @@ bool MaterializeResources(const ResourcePlan& program, const SrtRuntime& runtime
                           const std::vector<uint32_t>* walked = nullptr);
 // Whether a program takes the buffer table variant: it has storage buffers.
 bool BufferTableWanted(const ResourcePlan& program);
+// Whether programs with buffers take the buffer table variant: the device's default (set once at start, before any
+// program is materialized), or KYTY_BUFFER_TABLE=0/1.
+bool BufferTableEnabled();
+void SetBufferTableDefault(bool enabled);
 // Tests: this thread computes a per-lane store's ranges with the per-lane interpreter (the reference) instead of the
 // fast path. Both give the same ranges from the same reads.
 void SetLaneWriteRangesReference(bool on);
