+// A full card pages device-local memory of lower priority out to system memory instead of failing an allocation:
+// sparse buffer pages may live in video memory only (Marvel's Wolverine's geometry pool on 8 GB exited on one).
+// Prepends the two features to `info` when the device has them; KYTY_NO_PAGEABLE=1 leaves them off (A/B).
+struct PageableMemoryFeatures {
+	vk::PhysicalDevicePageableDeviceLocalMemoryFeaturesEXT pageable {};
+	vk::PhysicalDeviceMemoryPriorityFeaturesEXT            priority {};
+};
+static void EnablePageableMemory(GraphicContext& graphics, const std::vector<const char*>& device_extensions,
+                                 vk::DeviceCreateInfo& info, PageableMemoryFeatures& features) {
+	if (!HasExtension(device_extensions, VK_EXT_MEMORY_PRIORITY_EXTENSION_NAME) ||
+	    !HasExtension(device_extensions, VK_EXT_PAGEABLE_DEVICE_LOCAL_MEMORY_EXTENSION_NAME)) {
+		return;
+	}
+	vk::PhysicalDeviceFeatures2 query {};
+	features.pageable.pNext = &features.priority;
+	query.pNext             = &features.pageable;
+	graphics.physical_device.getFeatures2(&query);
