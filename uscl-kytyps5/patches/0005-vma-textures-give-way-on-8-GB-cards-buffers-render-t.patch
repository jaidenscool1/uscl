-uint32_t GraphicContext::RoomTypes(uint32_t types, uint64_t size) const {
+namespace {
+
+// The largest device-local heap; UINT32_MAX on none.
+uint32_t MainVideoHeap(const vk::PhysicalDeviceMemoryProperties& memory) {
+	uint32_t main_heap = UINT32_MAX;
+	for (uint32_t heap = 0; heap < memory.memoryHeapCount; heap++) {
+		if ((memory.memoryHeaps[heap].flags & vk::MemoryHeapFlagBits::eDeviceLocal) &&
+		    (main_heap == UINT32_MAX || memory.memoryHeaps[heap].size > memory.memoryHeaps[main_heap].size)) {
+			main_heap = heap;
+		}
+	}
+	return main_heap;
+}
+
+// Under 10 GiB of video memory (8 GB cards): the textures' and the GPU-written resources' rooms, and the priority pool.
+bool SmallCard(const vk::PhysicalDeviceMemoryProperties& memory) {
+	const uint32_t main_heap = MainVideoHeap(memory);
+	return main_heap != UINT32_MAX && memory.memoryHeaps[main_heap].size < (10ull << 30u);
+}
+
+} // namespace
+
+VmaPool GraphicContext::PriorityPool() {
+	if (!pageable_memory_enabled || !SmallCard(physical_device_memory_properties)) return nullptr;
+	std::lock_guard lock(priority_pool_mutex);
+	if (priority_pool != nullptr) return priority_pool;
+	const auto&    memory    = physical_device_memory_properties;
+	const uint32_t main_heap = MainVideoHeap(memory);
+	for (uint32_t type = 0; type < memory.memoryTypeCount && main_heap != UINT32_MAX; type++) {
+		const auto flags = memory.memoryTypes[type].propertyFlags;
+		if (memory.memoryTypes[type].heapIndex == main_heap && (flags & vk::MemoryPropertyFlagBits::eDeviceLocal) &&
+		    !(flags & vk::MemoryPropertyFlagBits::eHostVisible)) {
+			VmaPoolCreateInfo pool {};
+			pool.memoryTypeIndex = type;
+			pool.priority        = 1.0f;
+			(void)vmaCreatePool(allocator, &pool, &priority_pool);
+			break;
+		}
+	}
+	return priority_pool;
+}
+
+uint64_t GraphicContext::Room(bool gpu_written) const {
+	static const uint64_t room_env = [] { // debug: KYTY_VRAM_ROOM_MB overrides both rooms (1428: the old budget / 5)
+		const char* v = std::getenv("KYTY_VRAM_ROOM_MB");
+		return v != nullptr ? std::strtoull(v, nullptr, 10) << 20u : 0;
+	}();
+	// On 8 GB Marvel's Wolverine's sparse buffer pages (video memory only, never unmapped) reach ~2 GB of its 2.9 GB pool
+	// in the first fight. One room of a fifth (1.4 GiB) for everything sent 2.4 GB to system memory (5-9 fps); a 256 MiB
+	// room ran out under the next sparse page (exit; now paged out instead, pageable_memory_enabled), and a 248 MiB
+	// buffer a compute pass reads and writes every frame landing in system memory alone cost 17 -> 5 fps. The textures
+	// (sampled through the game's image heap, which the texture cache cannot free) give way first.
+	if (!SmallCard(physical_device_memory_properties)) return RoomBytes;
+	static const uint64_t texture_env = [] { // debug: KYTY_TEXTURE_ROOM_MB overrides the texture room
+		const char* v = std::getenv("KYTY_TEXTURE_ROOM_MB");
+		return v != nullptr ? std::strtoull(v, nullptr, 10) << 20u : 0;
+	}();
+	return room_env != 0 ? room_env : gpu_written ? GpuRoomBytes : texture_env != 0 ? texture_env : TextureRoomBytes;
+}
