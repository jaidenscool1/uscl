Subject: [PATCH 1/8] Include standard and fmt declarations explicitly for
 current toolchains

---
 src/common/dynamic_library.cpp | 1 +
 src/common/settings_setting.h  | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/common/dynamic_library.cpp b/src/common/dynamic_library.cpp
index 566fbed..374663b 100644
--- a/src/common/dynamic_library.cpp
+++ b/src/common/dynamic_library.cpp
@@ -7,6 +7,7 @@
 #include <fmt/ranges.h>
 
 #include "common/dynamic_library.h"
+#include <cstring>
 
 #ifdef _WIN32
 #include <windows.h>
diff --git a/src/common/settings_setting.h b/src/common/settings_setting.h
index 076acee..f01a66c 100644
--- a/src/common/settings_setting.h
+++ b/src/common/settings_setting.h
@@ -13,7 +13,7 @@
 #include <string>
 #include <typeindex>
 #include <typeinfo>
-#include <fmt/core.h>
+#include <fmt/format.h>
 #include "common/common_types.h"
 #include "common/settings_common.h"
 #include "common/settings_enums.h"
