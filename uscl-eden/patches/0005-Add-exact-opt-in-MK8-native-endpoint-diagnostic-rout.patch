diff --git a/src/core/hle/service/sockets/uscl_native_route.h b/src/core/hle/service/sockets/uscl_native_route.h
new file mode 100644
index 0000000..3740bcf
--- /dev/null
+++ b/src/core/hle/service/sockets/uscl_native_route.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+namespace Service::Sockets {
+
+// Diagnostic only: this is the unresolved NSD name observed in MK8D 4.0.1.
+// Keep the allowlist exact. This does not supply authentication or NEX services.
+constexpr std::string_view UsclNativeDiagnosticRoute(std::string_view host,
+                                                    std::uint64_t program_id, bool enabled) {
+    if (enabled && program_id == 0x0100152000022000ULL) {
+        // .p. is the Pia relay host; a joiner resolves it before connecting and aborts if it fails.
+        if (host == "g2b309e01-%.s.n.srv.nintendo.net" ||
+            host == "g2b309e01-%.p.srv.nintendo.net" ||
+            host == "nncs1-%.n.n.srv.nintendo.net") {
+            return "127.0.0.1";
+        }
+        if (host == "nncs2-%.n.n.srv.nintendo.net") {
+            return "127.0.0.2";
+        }
+    }
+    return host;
+}
+
+} // namespace Service::Sockets
