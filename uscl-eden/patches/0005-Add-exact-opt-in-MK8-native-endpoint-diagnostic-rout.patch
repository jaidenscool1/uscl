-static std::string ResolveImpl(const std::string& fqdn_in) {
+static std::string ResolveImpl(const std::string& fqdn_in, Core::System& system) {
+    const char* option = std::getenv("USCL_MK8_NATIVE_DIAGNOSTIC");
+    const bool enabled = option && std::string_view{option} == "1";
+    const auto routed = UsclNativeDiagnosticRoute(
+        fqdn_in, system.GetApplicationProcessProgramID(), enabled);
+    if (routed != fqdn_in) {
+        LOG_WARNING(Service, "USCL MK8 native diagnostic route selected; native play unsupported");
+        return std::string{routed};
