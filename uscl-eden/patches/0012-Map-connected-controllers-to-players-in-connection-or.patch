+std::vector<Common::ParamPackage> SDLDriver::GetPadsInConnectionOrder() {
+    const auto devices = GetInputDevices();
+    // Joy-Cons that form a pair are listed again as one "Nintendo Dual Joy-Con" device
+    std::set<std::pair<std::string, std::string>> paired;
+    for (const auto& device : devices) {
+        if (device.Has("guid2")) {
+            paired.emplace(device.Get("guid", ""), device.Get("port", ""));
+            paired.emplace(device.Get("guid2", ""), device.Get("port", ""));
+        }
+    }
+    std::vector<std::pair<SDL_JoystickID, Common::ParamPackage>> pads;
+    for (const auto& device : devices) {
+        if (!device.Has("guid2") && paired.contains({device.Get("guid", ""), device.Get("port", "")})) {
+            continue;
+        }
+        const auto joystick = GetSDLJoystickByGUID(device.Get("guid", ""), device.Get("port", 0));
+        // steering wheels, flight sticks etc. have no game controller mapping: not a player's pad
+        if (!joystick || !joystick->GetSDLGameController()) {
+            continue;
+        }
+        // instance ids count up as devices connect
+        pads.emplace_back(SDL_JoystickInstanceID(joystick->GetSDLJoystick()), device);
+    }
+    std::sort(pads.begin(), pads.end(), [](const auto& a, const auto& b) { return a.first < b.first; });
+    std::vector<Common::ParamPackage> out;
+    for (auto& pad : pads) {
+        out.push_back(std::move(pad.second));
+    }
+    return out;
+}
