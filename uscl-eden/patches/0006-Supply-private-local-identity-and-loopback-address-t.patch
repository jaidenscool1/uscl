diff --git a/src/core/hle/service/acc/uscl_native_identity.h b/src/core/hle/service/acc/uscl_native_identity.h
new file mode 100644
index 0000000..44dd2dc
--- /dev/null
+++ b/src/core/hle/service/acc/uscl_native_identity.h
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <array>
+#include <charconv>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace Service::Account {
+
+struct UsclNativeIdentity {
+    std::uint64_t id;
+    std::string token;
+};
+
+inline bool UsclNativeIdentityEnabled(std::uint64_t program_id) {
+    const char* enabled = std::getenv("USCL_MK8_NATIVE_DIAGNOSTIC");
+    return program_id == 0x0100152000022000ULL && enabled && std::string_view{enabled} == "1";
+}
+
+inline std::optional<UsclNativeIdentity> ParseUsclNativeIdentity(std::string_view data) {
+    constexpr std::string_view prefix = "USCL_NATIVE_ID_V1\n";
+    if (!data.starts_with(prefix) || data.size() > 128) {
+        return std::nullopt;
+    }
+    data.remove_prefix(prefix.size());
+    const auto end_id = data.find('\n');
+    if (end_id == std::string_view::npos || end_id == 0 || end_id > 20) {
+        return std::nullopt;
+    }
+    std::uint64_t id{};
+    const auto parsed = std::from_chars(data.data(), data.data() + end_id, id);
+    if (parsed.ec != std::errc{} || parsed.ptr != data.data() + end_id || id == 0) {
+        return std::nullopt;
+    }
+    data.remove_prefix(end_id + 1);
+    if (data.size() != 65 || data.back() != '\n') {
+        return std::nullopt;
+    }
+    data.remove_suffix(1);
+    for (const auto ch : data) {
+        if (!((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f'))) {
+            return std::nullopt;
+        }
+    }
+    return UsclNativeIdentity{id, std::string{data}};
+}
+
+inline std::optional<UsclNativeIdentity> ReadUsclNativeIdentity(std::uint64_t program_id) {
+    if (!UsclNativeIdentityEnabled(program_id)) {
+        return std::nullopt;
+    }
+    const char* path = std::getenv("USCL_MK8_NATIVE_CREDENTIAL_FILE");
+    if (!path || !*path) {
+        return std::nullopt;
+    }
+    std::ifstream file(path, std::ios::binary);
+    if (!file) {
+        return std::nullopt;
+    }
+    std::array<char, 129> bytes{};
+    file.read(bytes.data(), bytes.size());
+    const auto size = static_cast<std::size_t>(file.gcount());
+    if (file.bad() || size > 128) {
+        return std::nullopt;
+    }
+    return ParseUsclNativeIdentity(std::string_view{bytes.data(), size});
+}
+
+} // namespace Service::Account
