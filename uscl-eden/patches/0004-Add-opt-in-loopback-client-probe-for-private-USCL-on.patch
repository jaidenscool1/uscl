+#include "uscl_online_client.h"
 #include "startup_checks.h"
 
 #if YUZU_ROOM
@@ -75,6 +80,20 @@ static Qt::HighDpiScaleFactorRoundingPolicy GetHighDpiRoundingPolicy() {
 }
 
 int main(int argc, char* argv[]) {
+    // Explicit developer probe: no graphics, profile loading, guest services or
+    // Nintendo endpoints. Use QCoreApplication so it also works without a display.
+    for (int i = 1; i < argc; ++i) {
+        if (std::strcmp(argv[i], "--uscl-online-probe") != 0) continue;
+        const auto endpoint = i + 1 < argc ? QString::fromLocal8Bit(argv[i + 1]) : QString{};
+        QCoreApplication app(argc, argv);
+        const USCL::Online::Client client(endpoint);
+        const auto response = client.Probe();
+        const auto output = QJsonDocument(response).toJson(QJsonDocument::Compact);
+        std::fwrite(output.constData(), 1, output.size(), stdout);
+        std::fputc('\n', stdout);
+        return response.value(QStringLiteral("ok")).toBool() ? EXIT_SUCCESS : EXIT_FAILURE;
+    }
+
 #if YUZU_ROOM
     bool launch_room = false;
     for (int i = 1; i < argc; i++) {
diff --git a/src/yuzu/uscl_online_client.cpp b/src/yuzu/uscl_online_client.cpp
new file mode 100644
index 0000000..5b14111
--- /dev/null
+++ b/src/yuzu/uscl_online_client.cpp
@@ -0,0 +1,64 @@
+// SPDX-FileCopyrightText: Copyright 2026 USCL contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "uscl_online_client.h"
+
+#include <QElapsedTimer>
+#include <QJsonDocument>
+#include <QJsonParseError>
+#include <QRegularExpression>
+#include <QTcpSocket>
+
+namespace USCL::Online {
+namespace {
+QJsonObject Error(const char* code) {
+    return {{QStringLiteral("ok"), false}, {QStringLiteral("error"), QString::fromLatin1(code)}};
+}
+constexpr qsizetype MaxFrame = 16 * 1024;
+constexpr int Timeout = 3000;
+} // namespace
+
+Client::Client(const QString& endpoint) {
+    const auto match = QRegularExpression(QStringLiteral("^127\\.0\\.0\\.1:([0-9]{1,5})$")).match(endpoint);
+    const auto value = match.captured(1).toUInt();
+    if (match.hasMatch() && value > 0 && value <= 65535) port = static_cast<quint16>(value);
+}
+
+QJsonObject Client::Call(const QJsonObject& request) const {
+    if (!port) return Error("invalid_loopback_endpoint");
+    const auto frame = QJsonDocument(request).toJson(QJsonDocument::Compact) + '\n';
+    if (frame.size() > MaxFrame) return Error("request_too_large");
+    QElapsedTimer deadline;
+    deadline.start();
+    const auto remaining = [&] { return qMax(0, Timeout - static_cast<int>(deadline.elapsed())); };
+    QTcpSocket socket;
+    socket.connectToHost(QStringLiteral("127.0.0.1"), port);
+    if (!socket.waitForConnected(remaining())) return Error("backend_unavailable");
+    if (socket.write(frame) != frame.size()) return Error("backend_write_failed");
+    while (socket.bytesToWrite() > 0) {
+        if (remaining() <= 0 || !socket.waitForBytesWritten(remaining())) return Error("backend_timeout");
+    }
+    socket.setReadBufferSize(MaxFrame + 1);
+    QByteArray response;
+    while (!response.contains('\n')) {
+        response += socket.readAll();
+        if (response.size() > MaxFrame) return Error("response_too_large");
+        if (response.contains('\n')) break;
+        if (remaining() <= 0 || !socket.waitForReadyRead(remaining())) return Error("backend_incomplete_response");
+    }
+    if (response.indexOf('\n') != response.size() - 1) return Error("invalid_backend_response");
+    QJsonParseError parse_error;
+    const auto document = QJsonDocument::fromJson(response, &parse_error);
+    if (parse_error.error != QJsonParseError::NoError || !document.isObject() ||
+        !document.object().value(QStringLiteral("ok")).isBool()) return Error("invalid_backend_response");
+    return document.object();
+}
+
+QJsonObject Client::Probe() const {
+    auto response = Call({{QStringLiteral("op"), QStringLiteral("hello")}, {QStringLiteral("protocol"), 1}});
+    if (!response.value(QStringLiteral("ok")).toBool()) return response;
+    const auto result = response.value(QStringLiteral("result")).toObject();
+    if (result.value(QStringLiteral("service")) != QStringLiteral("uscl-switch-online") || result.value(QStringLiteral("protocol")).toInt() != 1 ||
+        !result.value(QStringLiteral("native_online_play")).isBool()) return Error("incompatible_backend");
+    return response;
+}
+} // namespace USCL::Online
diff --git a/src/yuzu/uscl_online_client.h b/src/yuzu/uscl_online_client.h
new file mode 100644
index 0000000..4b4a539
--- /dev/null
+++ b/src/yuzu/uscl_online_client.h
@@ -0,0 +1,22 @@
+// SPDX-FileCopyrightText: Copyright 2026 USCL contributors
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <QJsonObject>
+#include <QString>
+
+namespace USCL::Online {
+
+// Transport for USCL's private protocol. This is not a Nintendo account client
+// or a guest-game protocol adapter. Connections are restricted to loopback.
+class Client {
+public:
+    explicit Client(const QString& endpoint);
+    QJsonObject Call(const QJsonObject& request) const;
+    QJsonObject Probe() const;
+
+private:
+    quint16 port{};
+};
+
+} // namespace USCL::Online
