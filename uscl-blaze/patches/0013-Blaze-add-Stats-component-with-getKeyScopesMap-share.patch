diff --git a/Skate Custom Server/Blaze/Routers/StatsRouter.cs b/Skate Custom Server/Blaze/Routers/StatsRouter.cs
new file mode 100644
index 0000000..b844d7b
--- /dev/null
+++ b/Skate Custom Server/Blaze/Routers/StatsRouter.cs	
@@ -0,0 +1,27 @@
+using Blaze.Components.Stats;
+using Servers;
+using Servers.Blaze.Models;
+using Blaze.MessageLists;
+
+namespace Blaze
+{
+    public static class StatsComponentRouter
+    {
+        public static async Task Handle(User user, byte[] receivedPacket)
+        {
+            StatsMessage statsMessage = (StatsMessage)TdfUtils.GetCommandFromPacket(receivedPacket);
+
+            switch (statsMessage)
+            {
+                case StatsMessage.getKeyScopesMap:
+                    await GetKeyScopesMap.HandleRequest(user, receivedPacket);
+                    break;
+                default:
+                    // Other Stats commands (getStatGroup, getStatsByGroupAsync, …) aren't needed yet; an empty
+                    // success reads as "no stats" rather than stopping the client.
+                    await ServerUtils.SendEmptyResponse(user, receivedPacket);
+                    break;
+            }
+        }
+    }
+}
