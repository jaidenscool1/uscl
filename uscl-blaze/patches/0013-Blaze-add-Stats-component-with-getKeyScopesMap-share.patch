diff --git a/Skate Custom Server/Blaze/Components/Stats/Handlers/GetKeyScopesMap.cs b/Skate Custom Server/Blaze/Components/Stats/Handlers/GetKeyScopesMap.cs
new file mode 100644
index 0000000..037d483
--- /dev/null
+++ b/Skate Custom Server/Blaze/Components/Stats/Handlers/GetKeyScopesMap.cs	
@@ -0,0 +1,20 @@
+using Blaze.Components.Stats.Models;
+using Servers.Blaze.Models;
+
+namespace Blaze.Components.Stats
+{
+    public class GetKeyScopesMap
+    {
+        public static async Task HandleRequest(User user, byte[] packetBytes)
+        {
+            // Empty map is fine — the client only needs the KSIT field to exist so its Stats manager can read it.
+            var responseModel = new KeyScopes
+            {
+                KeyScopeItemsMap = new Dictionary<string, KeyScopeItem>()
+            };
+
+            BlazeMessage response = BlazeMessage.CreateResponseFromModel(packetBytes, responseModel);
+            await user.Stream.WriteAsync(response.Serialize());
+        }
+    }
+}
diff --git a/Skate Custom Server/Blaze/Components/Stats/Models/KeyScopes.cs b/Skate Custom Server/Blaze/Components/Stats/Models/KeyScopes.cs
new file mode 100644
index 0000000..b9da53b
--- /dev/null
+++ b/Skate Custom Server/Blaze/Components/Stats/Models/KeyScopes.cs	
@@ -0,0 +1,21 @@
+using Blaze.Tdf.Attributes;
+
+namespace Blaze.Components.Stats.Models
+{
+    // Blaze::Stats::KeyScopes — response to Stats::getKeyScopesMap (7/15). The EA Sports client's Stats manager
+    // dereferences the KSIT map unconditionally, so the field MUST be present even when empty; a generic empty
+    // reply (no KSIT) is what crashed NHL 15's main PPU thread during "Retrieving data from server". Shape from
+    // the real BlazeSDK (ZamboniDevelopment Blaze3SDK/Blaze/Stats). Shared across EA Sports titles.
+    public struct KeyScopes
+    {
+        [TdfMember("KSIT")]
+        public Dictionary<string, KeyScopeItem> KeyScopeItemsMap;
+    }
+
+    public struct KeyScopeItem
+    {
+        [TdfMember("AGKY")] public long AggregateKeyValue;
+        [TdfMember("ENAG")] public uint EnableAggregation;
+        [TdfMember("KSVL")] public Dictionary<long, long> KeyScopeValues;
+    }
+}
