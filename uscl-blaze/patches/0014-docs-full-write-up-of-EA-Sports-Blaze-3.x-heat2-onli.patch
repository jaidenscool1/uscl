+#!/usr/bin/env python3
+# Plaintext tap: listen on LPORT, forward to BPORT, dump both directions as framed Blaze packets.
+import socket, sys, threading
+LPORT, BHOST, BPORT = int(sys.argv[1]), sys.argv[2], int(sys.argv[3])
+OUT = open(sys.argv[4], 'ab', buffering=0) if len(sys.argv) > 4 else None
+
+def dump(tag, data):
+    line = f"\n--- {tag} {len(data)} bytes ---\n{data.hex()}\n".encode()
+    if OUT: OUT.write(line)
+
+def pump(src, dst, tag):
+    try:
+        buf = b''
+        while True:
+            d = src.recv(4096)
+            if not d: break
+            dst.sendall(d)
+            buf += d
+            # frame by Blaze 12-byte header (u16 bodylen BE at offset 0)
+            while len(buf) >= 12:
+                blen = (buf[0]<<8)|buf[1]
+                if len(buf) < 12+blen: break
+                dump(tag, buf[:12+blen]); buf = buf[12+blen:]
+    except OSError: pass
+    finally:
+        try: dst.shutdown(socket.SHUT_WR)
+        except OSError: pass
+
+def handle(c):
+    try: b = socket.create_connection((BHOST, BPORT))
+    except OSError: c.close(); return
+    threading.Thread(target=pump, args=(c, b, 'C>S'), daemon=True).start()
+    pump(b, c, 'S>C'); c.close(); b.close()
+
+srv = socket.socket(); srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+srv.bind(('0.0.0.0', LPORT)); srv.listen(8)
+print(f"tap on 0.0.0.0:{LPORT} -> {BHOST}:{BPORT}", flush=True)
+while True:
+    c,_ = srv.accept(); threading.Thread(target=handle, args=(c,), daemon=True).start()
