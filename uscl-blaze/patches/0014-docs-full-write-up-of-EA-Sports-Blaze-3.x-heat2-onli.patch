+#!/usr/bin/env python3
+# Decode captured Blaze heat2 packets (C>S blocks of hex) to confirm the real request flow + CFIDs Madden sends.
+import sys, re
+
+def tag_decode(b):  # inverse of Blaze EncodeTdfTag: 3 bytes -> 4-char tag
+    v = (b[0] << 16) | (b[1] << 8) | b[2]
+    out = []
+    for shift in (18, 12, 6, 0):
+        c = (v >> shift) & 0x3F
+        out.append(chr(c + 0x20) if c else ' ')
+    return ''.join(out).rstrip()
+
+def varint(p, i):
+    b = p[i]; i += 1
+    if not (b & 0x80): return b, i
+    v = b & 0x3F; shift = 6
+    while True:
+        b = p[i]; i += 1
+        v |= (b & 0x7F) << shift; shift += 7
+        if not (b & 0x80): break
+    return v, i
+
+def read_value(p, i, t):
+    if t == 0:  # int
+        v, i = varint(p, i); return v, i
+    if t == 1:  # string
+        n, i = varint(p, i); s = p[i:i+max(0,n-1)].decode('latin1'); return s, i+n
+    if t == 2:  # blob
+        n, i = varint(p, i); return p[i:i+n].hex(), i+n
+    if t == 3:  # struct
+        d = {}
+        while p[i] != 0:
+            tag, val, i = read_field(p, i); d[tag] = val
+        return d, i+1
+    if t == 4:  # list
+        et = p[i]; i += 1; n, i = varint(p, i); items=[]
+        for _ in range(n):
+            v, i = read_value(p, i, et); items.append(v)
+        return items, i
+    if t == 5:  # map
+        kt = p[i]; vt = p[i+1]; i += 2; n, i = varint(p, i); m={}
+        for _ in range(n):
+            k, i = read_value(p, i, kt); v, i = read_value(p, i, vt); m[k]=v
+        return m, i
+    if t == 6:  # union
+        sel = p[i]; i += 1
+        if sel == 0x7F: return None, i
+        tag, val, i = read_field(p, i); return {'sel':sel, tag:val}, i
+    raise ValueError(f"type {t}")
+
+def read_field(p, i):
+    tag = tag_decode(p[i:i+3]); i += 3
+    t = p[i]; i += 1
+    val, i = read_value(p, i, t)
+    return tag, val, i
+
+def read_fields(p):
+    i = 0x0C; end = 0x0C + ((p[0]<<8)|p[1]); out={}
+    while i < end and p[i] != 0:
+        tag, val, i = read_field(p, i); out[tag]=val
+    return out
+
+COMP={5:'Redirector',9:'Util',1:'Auth',30:'UserSessions',7:'AssocLists',4:'GameManager',25:'GameReporting',11:'Clubs'}
+for path in sys.argv[1:]:
+    print(f"\n===== {path} =====")
+    txt = open(path).read()
+    blocks = re.split(r'---\s*C>S\s+\d+\s+bytes\s*---', txt)
+    for blk in blocks:
+        hx = ''.join(blk.split())
+        if len(hx) < 24: continue
+        try: p = bytes.fromhex(hx)
+        except ValueError: continue
+        comp = (p[2]<<8)|p[3]; cmd=(p[4]<<8)|p[5]
+        try: fields = read_fields(p)
+        except Exception as e: fields = f"<decode err: {e}>"
+        label = f"{COMP.get(comp,comp)}/{cmd}"
+        extra = ""
+        if comp==9 and cmd==1 and isinstance(fields,dict): extra = f"  CFID={fields.get('CFID')!r}"
+        print(f"  [{label}] fields={list(fields.keys()) if isinstance(fields,dict) else fields}{extra}")
