+#!/usr/bin/env python3
+# Targeted PPC64 (big-endian) analysis of a decrypted PS3 EBOOT.elf.
+import sys, struct
+from capstone import Cs, CS_ARCH_PPC, CS_MODE_64, CS_MODE_BIG_ENDIAN
+
+elf = sys.argv[1]
+data = open(elf, 'rb').read()
+
+SEG_VADDR, SEG_FOFF, SEG_SIZE = 0x10000, 0x0, 0x21144e8
+def v2f(v): return v - SEG_VADDR + SEG_FOFF
+def f2v(f): return f - SEG_FOFF + SEG_VADDR
+code = data[SEG_FOFF:SEG_FOFF+SEG_SIZE]
+
+md = Cs(CS_ARCH_PPC, CS_MODE_64 | CS_MODE_BIG_ENDIAN)
+
+def disas(vaddr, count):
+    off = v2f(vaddr)
+    for ins in md.disasm(code[off:off+count*4], vaddr):
+        print(f"  0x{ins.address:08x}: {ins.mnemonic:8} {ins.op_str}")
+
+def find_lis_ori(hi, lo):
+    hits = []
+    for i in range(0, len(code)-8, 4):
+        w0 = struct.unpack('>I', code[i:i+4])[0]
+        if (w0 >> 26) == 15 and (w0 & 0xFFFF) == hi:
+            for j in range(i+4, min(i+28, len(code)-4), 4):
+                w1 = struct.unpack('>I', code[j:j+4])[0]
+                if (w1 >> 26) == 24 and (w1 & 0xFFFF) == lo:
+                    hits.append(f2v(i)); break
+    return hits
+
+mode = sys.argv[2]
+if mode == 'disas':
+    disas(int(sys.argv[3], 16), int(sys.argv[4]))
+elif mode == 'xref':
+    val = int(sys.argv[3], 16)
+    hi, lo = (val >> 16) & 0xFFFF, val & 0xFFFF
+    hits = find_lis_ori(hi, lo)
+    tag = bytes([(val>>24)&0xff,(val>>16)&0xff,(val>>8)&0xff,val&0xff])
+    print(f"xrefs building 0x{val:08x} ({tag!r}): {len(hits)}")
+    for h in hits[:30]:
+        print(f"-- site 0x{h:08x} --"); disas(h, 12)
