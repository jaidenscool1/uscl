             user.IsAuthenticated = true;
             ServerGlobals.Users[sessionDetails.BlazeId] = user;
 
-            // Blaze 3.x (NHL/Madden): the SDK's login call doesn't complete until the server pushes the local
-            // user's own session data, so the client waits ~12s then logs out instead of sending postAuth. Push
-            // the session notifications now (heat2 only; heat1/NBA Jam drive these via postAuth instead).
+            // Blaze 3.x (NHL/Madden): the SDK's login call blocks until the server pushes the local user's own
+            // session as UserSessions NotifyUserAdded (2). Without it the client sits at "connecting to the EA
+            // servers", pings, then logs out. Send it now using the session data/identity built just above (heat2
+            // only; heat1/NBA Jam drive this via postAuth).
             if (user.IsHeat2)
             {
-                await ServerUtils.SendNotificationToUser(user, user.UserIdentification,
-                    BlazeComponent.UserSessions, (ushort)UserSessionNotification.UserAdded);
-                await ServerUtils.SendNotificationToUser(user,
-                    new NotifyExtendedDataUpdated { ExtendedData = user.ExtendedData, BlazeId = user.UserIdentification.BlazeId },
-                    BlazeComponent.UserSessions, (ushort)UserSessionNotification.UserSessionExtendedDataUpdate);
+                await ServerUtils.SendNotificationToUser(user, new NotifyUserAdded
