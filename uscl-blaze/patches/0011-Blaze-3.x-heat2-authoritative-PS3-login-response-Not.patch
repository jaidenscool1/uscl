diff --git a/Skate Custom Server/Blaze/Components/UserSessions/Notifications/NotifyUserAdded.cs b/Skate Custom Server/Blaze/Components/UserSessions/Notifications/NotifyUserAdded.cs
new file mode 100644
index 0000000..243b4ae
--- /dev/null
+++ b/Skate Custom Server/Blaze/Components/UserSessions/Notifications/NotifyUserAdded.cs	
@@ -0,0 +1,18 @@
+using Blaze.Tdf.Attributes;
+using Blaze.Components.UserSessions.Models;
+
+namespace Blaze.Components.UserSessions.Notifications
+{
+    // UserSessions NotifyUserAdded (Id 2). The real Blaze 3.x SDK's login call blocks until the server pushes the
+    // local user's own session as this notification; without it NHL 15 / Madden 25 sit at "connecting to the EA
+    // servers", ping, then log out. Shape is authoritative (ZamboniDevelopment/BlazeSDK): two top-level members,
+    // DATA (the user's extended session data) and USER (their identification) — not USER nested inside DATA.
+    public struct NotifyUserAdded
+    {
+        [TdfMember("DATA")]
+        public UserSessionExtendedData ExtendedData;
+
+        [TdfMember("USER")]
+        public UserIdentification UserInfo;
+    }
+}
diff --git a/Skate Custom Server/Program.cs b/Skate Custom Server/Program.cs
index 4b4199e..d4a7964 100644
--- a/Skate Custom Server/Program.cs	
+++ b/Skate Custom Server/Program.cs	
@@ -51,8 +51,10 @@ ServerGlobals.PingPeriodSecs = 15;
 var httpServer = new HttpServer(ServerGlobals.HttpServerPort);
 httpServer.Start();
 
-// Main Blaze server
-var blazeServer = new BlazeServer(ServerGlobals.ServerPort);
+// Main Blaze server. USCL diag: listen on an internal port when USCL_BLAZE_LISTEN is set, so a plaintext tap can
+// sit on the advertised ServerPort (42100, what getServerInstance returns) and dump the session both ways.
+ushort listenPort = ushort.TryParse(Environment.GetEnvironmentVariable("USCL_BLAZE_LISTEN"), out var lp) ? lp : ServerGlobals.ServerPort;
+var blazeServer = new BlazeServer(listenPort);
 blazeServer.Start();
 
 // Wait for Ctrl+C
