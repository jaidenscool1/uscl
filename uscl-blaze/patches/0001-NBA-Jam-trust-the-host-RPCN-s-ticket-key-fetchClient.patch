diff --git a/Skate Custom Server/Blaze/Components/Util/Handlers/FetchClientConfigHandler.cs b/Skate Custom Server/Blaze/Components/Util/Handlers/FetchClientConfigHandler.cs
new file mode 100644
index 0000000..16436f1
--- /dev/null
+++ b/Skate Custom Server/Blaze/Components/Util/Handlers/FetchClientConfigHandler.cs	
@@ -0,0 +1,43 @@
+using Blaze.Components.Util.Commands;
+using Blaze.Tdf.Attributes;
+using Servers;
+using Servers.Blaze.Models;
+
+namespace Blaze.Components.Util.Handlers
+{
+    public struct FetchClientConfigRequest
+    {
+        [TdfMember("CFID")]
+        public string ConfigId;
+    }
+
+    // USCL: NBA Jam asks for client config sections before PS3 login (Skate 3 never does).
+    // Sections come from clientconfig/<CFID>.txt next to the server (key=value per line); a missing file is an
+    // empty section, which is what the game gets from a server that has nothing to say about it.
+    public class FetchClientConfigHandler
+    {
+        public static async Task HandleRequest(User user, byte[] packetBytes)
+        {
+            var request = BlazeMessage.CreateModelFromRequest<FetchClientConfigRequest>(packetBytes);
+            string id = request.ConfigId ?? "";
+            var fields = new Dictionary<string, string>();
+
+            // the id is the client's: keep it to a file name inside clientconfig/
+            if (id.Length > 0 && id.All(c => char.IsLetterOrDigit(c) || c == '_' || c == '-' || c == '.') && !id.Contains(".."))
+            {
+                string path = Path.Combine(ServerGlobals.BaseDirectory, "clientconfig", id + ".txt");
+                if (File.Exists(path))
+                    foreach (string line in File.ReadAllLines(path))
+                    {
+                        int eq = line.IndexOf('=');
+                        if (eq > 0 && !line.StartsWith('#'))
+                            fields[line[..eq].Trim()] = line[(eq + 1)..].Trim();
+                    }
+            }
+            ServerLogger.Log($"[Blaze] fetchClientConfig CFID={id} -> {fields.Count} fields");
+
+            BlazeMessage response = BlazeMessage.CreateResponseFromModel(packetBytes, new FetchConfigResponse { ConfigFields = fields });
+            await user.Stream.WriteAsync(response.Serialize());
+        }
+    }
+}
