+        // USCL: the host's own RPCN (settings.json HostTicketKey), same curve and digest as official RPCN
+        private class HostSigningKey : ITicketSigningKey
+        {
+            public HostSigningKey(string uncompressedHex)
+            {
+                string hex = uncompressedHex.StartsWith("04") ? uncompressedHex[2..] : uncompressedHex;
+                PublicKeyX = hex[..(hex.Length / 2)];
+                PublicKeyY = hex[(hex.Length / 2)..];
+            }
+            public string HashAlgorithm => "SHA-224";
+            public string CurveTable => "secp224k1";
+            public TicketSignatureMessageType MessageType => TicketSignatureMessageType.Body;
+            public string PublicKeyX { get; }
+            public string PublicKeyY { get; }
+        }
