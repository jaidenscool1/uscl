From 89f48ceee8ec7da1d90699b9bff6813348a78510 Mon Sep 17 00:00:00 2001
From: HempFiend <17104973+jaidenscool1@users.noreply.github.com>
Date: Thu, 12 Nov 2026 23:43:09 -0700
Subject: [PATCH] Blaze 3.x: serve OSDKSettings (2249) groups so NHL 15 gets
 past its ticker

Component 0x08C9 is Blaze::OSDKSettings (fetchSettings = 1, fetchSettingsGroups = 2), not
OsdkTicker2. NHL 15 builds its settings groups from fetchSettingsGroups and later looks them up
by name with no null check: the empty reply left O_SG_TCKR missing and crashed the main PPU
thread at 0x008b1aec.

Serve the five groups the game names (O_SG_NRAD/QMSG/SYSS/TCKR/USER) with the TDF tags read from
the EBOOT's member tables, the ticker's integer settings (O_TKfriend/O_TKsport/O_TKfilter) and
O_SG_USER's views (MUPSET/INV/UGEN/UACCT). NHL now runs on to Stats 15, Util 12, Stats 3 and
Authentication 30, then stops at 0x7a2840 on the user settings (O_SPAMEA, ...), which still need
their per-setting types; see docs/EA-Sports-Blaze3-heat2.md section 6.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../Components/OSDKSettings/OSDKSettings.cs   | 73 +++++++++++++++++
 .../Servers/Blaze/BlazeServer.cs              |  5 ++
 docs/EA-Sports-Blaze3-heat2.md                | 82 +++++++++++--------
 3 files changed, 125 insertions(+), 35 deletions(-)
 create mode 100644 Skate Custom Server/Blaze/Components/OSDKSettings/OSDKSettings.cs

diff --git a/Skate Custom Server/Blaze/Components/OSDKSettings/OSDKSettings.cs b/Skate Custom Server/Blaze/Components/OSDKSettings/OSDKSettings.cs
new file mode 100644
index 0000000..b38090b
--- /dev/null
+++ b/Skate Custom Server/Blaze/Components/OSDKSettings/OSDKSettings.cs	
@@ -0,0 +1,73 @@
+using Blaze.Tdf.Attributes;
+using Servers;
+using Servers.Blaze.Models;
+
+namespace Blaze.Components.OSDKSettings
+{
+    // Blaze::OSDKSettings (component 0x08C9 = 2249) on Blaze 3.x EA Sports titles: fetchSettings = 1,
+    // fetchSettingsGroups = 2. Tags read from NHL 15's EBOOT TDF member tables (0x1b54134..0x1b54280):
+    // SettingString {DEF, HLAB, ID, LABL, LOCF, TOGG}, SettingInteger {DEF, HLAB, ID, LABL, LOCF, MPVL, TOGG},
+    // SettingViewData {DEFS, HLAB, ID, TOGG, VAL}, SettingView {ID, LVDS}, SettingGroup {ID, LSET list<string>,
+    // LVWS list<SettingView>}, FetchSettingsResponse {LSIN, LSST}, FetchSettingsGroupsResponse {LGRP}.
+    // The client looks groups, views and settings up by name and dereferences the result without a null check,
+    // so everything it asks for must exist (docs/EA-Sports-Blaze3-heat2.md section 6).
+    public struct SettingInteger
+    {
+        [TdfMember("DEF")] public int Default;
+        [TdfMember("ID")] public string Id;
+    }
+
+    public struct FetchSettingsResponse
+    {
+        [TdfMember("LSIN")] public List<SettingInteger> IntegerSettingList;
+    }
+
+    public struct SettingView
+    {
+        [TdfMember("ID")] public string Id;
+    }
+
+    public struct SettingGroup
+    {
+        [TdfMember("ID")] public string Id;
+        [TdfMember("LSET")] public List<string> SettingList;
+        [TdfMember("LVWS")] public List<SettingView> ViewList;
+    }
+
+    public struct FetchSettingsGroupsResponse
+    {
+        [TdfMember("LGRP")] public List<SettingGroup> SettingGroupList;
+    }
+
+    public static class OSDKSettingsHandler
+    {
+        // NHL 15's ticker update (PPU 0x8b1aa0) reads group O_SG_TCKR, then its setting O_TKfilter; these three are
+        // named together in the EBOOT (0x1b5d0fc..). 0 = ticker filters off.
+        static readonly string[] TickerSettings = { "O_TKfriend", "O_TKsport", "O_TKfilter" };
+        // Views the game opens on O_SG_USER (name table 0x227616c..0x2276178; PPU 0x7a27e0 opens UACCT).
+        // shortcut: the user settings these views hold (O_SPAMEA, O_EGstat, O_GM, ... at 0x2276104..) are not
+        // served yet: each has a fixed type (O_GM is an integer with 3 possible values, O_EGstat/O_JS crash the
+        // client as integers) that still has to be read from the EBOOT; until then NHL stops at PPU 0x7a2840.
+        static readonly string[] UserViews = { "MUPSET", "INV", "UGEN", "UACCT" };
+        // The five groups NHL 15 names in its EBOOT (O_SG_*)
+        static readonly string[] Groups = { "O_SG_NRAD", "O_SG_QMSG", "O_SG_SYSS", "O_SG_TCKR", "O_SG_USER" };
+
+        static SettingGroup Group(string id) => new()
+        {
+            Id = id,
+            SettingList = id == "O_SG_TCKR" ? TickerSettings.ToList() : new(),
+            ViewList = id == "O_SG_USER" ? UserViews.Select(v => new SettingView { Id = v }).ToList() : new()
+        };
+
+        public static async Task Handle(User user, byte[] packetBytes, ushort command)
+        {
+            object response = command == 2
+                ? new FetchSettingsGroupsResponse { SettingGroupList = Groups.Select(Group).ToList() }
+                : new FetchSettingsResponse
+                {
+                    IntegerSettingList = TickerSettings.Select(s => new SettingInteger { Id = s, Default = 0 }).ToList()
+                };
+            await user.Stream.WriteAsync(BlazeMessage.CreateResponseFromModel(packetBytes, response).Serialize());
+        }
+    }
+}
diff --git a/Skate Custom Server/Servers/Blaze/BlazeServer.cs b/Skate Custom Server/Servers/Blaze/BlazeServer.cs
index 47fc237..a0ba629 100644
--- a/Skate Custom Server/Servers/Blaze/BlazeServer.cs	
+++ b/Skate Custom Server/Servers/Blaze/BlazeServer.cs	
@@ -195,6 +195,11 @@ namespace Servers.Blaze
                 case BlazeComponent.Stats:
                     await StatsComponentRouter.Handle(user, packetBytes);
                     break;
+                case (BlazeComponent)2249 when user.IsHeat2:
+                    // USCL: OSDKSettings on Blaze 3.x (NHL 15, Madden 25). NBA Jam (Blaze 2) keeps the empty success below.
+                    ServerLogger.Log($"[Blaze] OSDKSettings command {command}");
+                    await global::Blaze.Components.OSDKSettings.OSDKSettingsHandler.Handle(user, packetBytes, command);
+                    break;
                 default:
                     // USCL: components Skate 3 never uses (Rooms 21, Messaging 15, NBA Jam's 2249, ...).
                     // An empty success reads as "nothing there" to the client, where an error stops its login.
