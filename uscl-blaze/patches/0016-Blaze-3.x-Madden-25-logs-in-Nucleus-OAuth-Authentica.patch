diff --git a/Skate Custom Server/Blaze/Components/Authentication/Handlers/Authentication2LoginHandler.cs b/Skate Custom Server/Blaze/Components/Authentication/Handlers/Authentication2LoginHandler.cs
new file mode 100644
index 0000000..2f87cd3
--- /dev/null
+++ b/Skate Custom Server/Blaze/Components/Authentication/Handlers/Authentication2LoginHandler.cs	
@@ -0,0 +1,48 @@
+using System.Collections.Concurrent;
+using System.Security.Cryptography;
+using Blaze.Tdf.Attributes;
+using Servers;
+using Servers.Blaze.Models;
+
+namespace Blaze.Components.Authentication
+{
+    // Madden 25 (BlazeSDK 13.3) logs in through EA's Nucleus OAuth: HTTP GET <nucleusConnect>/connect/auth with the PSN
+    // ticket in a psn_ticket header, answered with a 302 to redirect_uri?code=<code>; then Authentication2 (35) login
+    // (10) {AUTH = code, EXTB, EXTI}. The code stands in for the ticket; the login itself is the PS3 one.
+    public static class NucleusAuth
+    {
+        static readonly ConcurrentDictionary<string, byte[]> Codes = new();
+
+        // shortcut: unused codes never expire, the store is cleared past 1000; add a TTL if many players share a server
+        public static string IssueCode(byte[] ticket)
+        {
+            if (Codes.Count > 1000) Codes.Clear();
+            string code = Convert.ToHexString(RandomNumberGenerator.GetBytes(16));
+            Codes[code] = ticket;
+            return code;
+        }
+
+        public static byte[]? TakeTicket(string? code) => code != null && Codes.TryRemove(code, out var t) ? t : null;
+    }
+
+    public struct Authentication2LoginRequest
+    {
+        [TdfMember("AUTH")] public string AuthCode;
+    }
+
+    public static class Authentication2LoginHandler
+    {
+        public static async Task HandleRequest(User user, byte[] packetBytes)
+        {
+            var request = BlazeMessage.CreateModelFromRequest<Authentication2LoginRequest>(packetBytes);
+            byte[]? ticket = NucleusAuth.TakeTicket(request.AuthCode);
+            if (ticket == null)
+            {
+                ServerLogger.Log("[Blaze] Authentication2 login: unknown auth code");
+                await ServerUtils.SendError(user, packetBytes, ServerUtils.ErrorCode.AUTH_ERR_INVALID_PS3_TICKET);
+                return;
+            }
+            await Ps3LoginHandler.Login(user, packetBytes, ticket);
+        }
+    }
+}
