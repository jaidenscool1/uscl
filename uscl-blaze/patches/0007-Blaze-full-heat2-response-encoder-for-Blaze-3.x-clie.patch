         {
-            var payload = new List<byte>(256);
-            foreach (var field in Fields)
-                payload.AddRange(field.Serialize());
+            List<byte> payload;
+            if (Blaze.Tdf.Heat2Writer.Mode.Value)
+            {
+                payload = new List<byte>(Blaze.Tdf.Heat2Writer.SerializeFields(Fields));
+            }
