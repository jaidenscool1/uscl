             packet.AddRange(TdfUtils.SwapEndianess((ushort)payload.Count));
diff --git a/Skate Custom Server/Blaze/Tdf/Heat2Writer.cs b/Skate Custom Server/Blaze/Tdf/Heat2Writer.cs
index a7e2e22..44194b4 100644
--- a/Skate Custom Server/Blaze/Tdf/Heat2Writer.cs	
+++ b/Skate Custom Server/Blaze/Tdf/Heat2Writer.cs	
@@ -1,4 +1,7 @@
+using System;
 using System.Collections.Generic;
+using System.Text;
+using Blaze.Tdf.Types;
 
 namespace Blaze.Tdf
 {
@@ -13,6 +16,10 @@ namespace Blaze.Tdf
     {
         public const byte INT = 0x00, STRING = 0x01, STRUCT = 0x03, UNION = 0x06;
 
+        // Set per request-dispatch from the connection's User.IsHeat2; read by BlazeMessage.Serialize so a Blaze 3.x
+        // connection's responses are heat2 without threading a flag through every handler.
+        public static readonly System.Threading.AsyncLocal<bool> Mode = new();
+
         public static void VarInt(List<byte> o, ulong v)
         {
             if (v < 0x40) { o.Add((byte)v); return; }
@@ -41,5 +48,106 @@ namespace Blaze.Tdf
         }
 
         public static void EndStruct(List<byte> o) => o.Add(0x00);
+
+        // ---- Full model serializer: turn the TdfField model (built with heat1 TdfType) into heat2 bytes. ----
+        // Used to re-encode whole responses for Blaze 3.x clients; mirrors the heat1 path in BlazeMessage/TdfCodec.
+
+        public const byte BLOB = 0x02, LIST = 0x04, MAP = 0x05, FLOAT = 0x0A;
+
+        // heat1 TdfType -> heat2 type code
+        public static byte Heat2Type(TdfType t) => t switch
+        {
+            TdfType.Struct => STRUCT,
+            TdfType.String => STRING,
+            TdfType.Blob => BLOB,
+            TdfType.Array => LIST,
+            TdfType.Map => MAP,
+            TdfType.Union => UNION,
+            _ => INT, // all int widths collapse to one heat2 varint int
+        };
+
+        public static byte[] SerializeFields(IEnumerable<TdfField> fields)
+        {
+            var o = new List<byte>(128);
+            foreach (var f in fields) WriteField(o, f.Tag, f.Type, f.Value);
+            return o.ToArray();
+        }
+
+        static void WriteField(List<byte> o, string tag, TdfType type, object value)
+        {
+            o.AddRange(TdfUtils.EncodeTdfTag(tag));
+            o.Add(Heat2Type(type));
+            WriteValue(o, type, value);
+        }
+
+        static void VarIntSigned(List<byte> o, object value)
+        {
+            if (value is bool b) { VarInt(o, b ? 1UL : 0UL); return; }
+            long lv = Convert.ToInt64(value);
+            VarInt(o, unchecked((ulong)lv)); // non-negative in practice; two's-complement otherwise, matching Blaze
+        }
+
+        static void WriteString(List<byte> o, string s)
+        {
+            var bytes = Encoding.Latin1.GetBytes(s ?? string.Empty);
+            VarInt(o, (ulong)(bytes.Length + 1)); // length includes the NUL terminator
+            o.AddRange(bytes);
+            o.Add(0x00);
+        }
+
+        // Write just a value (no tag), given its heat1 type. For struct: fields + 0x00 terminator.
+        static void WriteValue(List<byte> o, TdfType type, object value)
+        {
+            switch (type)
+            {
+                case TdfType.Struct:
+                    foreach (var f in ((TdfStruct)value).Fields) WriteField(o, f.Tag, f.Type, f.Value);
+                    o.Add(0x00);
+                    break;
+                case TdfType.String:
+                    WriteString(o, (string)value);
+                    break;
+                case TdfType.Blob:
+                    var blob = (byte[])value ?? Array.Empty<byte>();
+                    VarInt(o, (ulong)blob.Length); o.AddRange(blob);
+                    break;
+                case TdfType.Array:
+                    WriteList(o, (TdfArray)value);
+                    break;
+                case TdfType.Map:
+                    WriteMap(o, (TdfDictionary)value);
+                    break;
+                case TdfType.Union:
+                    var u = (TdfUnion)value;
+                    o.Add(u.SelectedUnionValue);
+                    if (u.SelectedUnionValue != 0x7F && u.Field != null)
+                        WriteField(o, "VALU", u.Field.Type, u.Field.Value);
+                    break;
+                default: // any int width
+                    VarIntSigned(o, value);
+                    break;
+            }
+        }
+
+        static void WriteList(List<byte> o, TdfArray a)
+        {
+            o.Add(Heat2Type(a.ArrayType));
+            VarInt(o, (ulong)a.Items.Count);
+            foreach (var item in a.Items) WriteValue(o, a.ArrayType, item);
+        }
+
+        static void WriteMap(List<byte> o, TdfDictionary d)
+        {
+            o.Add(Heat2Type(d.KeyType));
+            o.Add(Heat2Type(d.ValueType));
+            int count = d?.Map?.Count ?? 0;
+            VarInt(o, (ulong)count);
+            if (count == 0) return;
+            foreach (var kv in d.Map)
+            {
+                WriteValue(o, d.KeyType, kv.Key);
+                WriteValue(o, d.ValueType, kv.Value);
+            }
+        }
     }
 }
