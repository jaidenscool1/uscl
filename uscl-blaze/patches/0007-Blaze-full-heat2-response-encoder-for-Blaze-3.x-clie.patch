diff --git a/Skate Custom Server/Blaze/Components/Util/Handlers/PreAuthHandler.cs b/Skate Custom Server/Blaze/Components/Util/Handlers/PreAuthHandler.cs
index 735ae58..c02ae28 100644
--- a/Skate Custom Server/Blaze/Components/Util/Handlers/PreAuthHandler.cs	
+++ b/Skate Custom Server/Blaze/Components/Util/Handlers/PreAuthHandler.cs	
@@ -7,44 +7,67 @@ namespace Blaze.Components.Util.Handlers
 {
     public static class PreAuthHandler
     {
-        // preAuth response is pretty much same so cache it instead of rebuilding always
-        private static byte[] _cachedBytes;
+        // preAuth response is pretty much the same, so cache the heat1 bytes (NBA Jam / Skate 3).
+        private static readonly byte[] _cachedBytes;
 
         static PreAuthHandler()
         {
-            Dictionary<string, string> config = new Dictionary<string, string>
+            _cachedBytes = BuildMessage(new byte[] { 0, 0, 0, 9, 0, 7, 0, 0, 0, 0, 0, 0 }).Serialize();
+        }
+
+        private static BlazeMessage BuildMessage(byte[] packetBytes)
+        {
+            var config = new Dictionary<string, string>
             {
                 { "pingPeriodInMs", (ServerGlobals.PingPeriodSecs * 1000).ToString() },
                 { "voipHeadsetUpdateRate", "1000" }
             };
-
-            BlazeMessage response = BlazeMessage.CreateResponseFromModel(
-                new byte[] { 0, 0, 0, 9, 0, 7, 0, 0, 0, 0, 0, 0 },
+            return BlazeMessage.CreateResponseFromModel(
+                packetBytes,
                 new PreAuthResponse
                 {
                     ComponentIds = new List<ushort> { 1, 4, 7, 8, 9, 11, 12, 15, 25, 30720, 30722, 30723 },
-                    Config =
-                    {
-                        ConfigFields = config
-                    },
-                    QosSettings =
-                    {
-                        NumLatencyProbes = 0,
-                        PingSiteInfoByAliasMap = new Dictionary<string, QosPingSiteInfo> {  }
-                    },
+                    Config = { ConfigFields = config },
+                    QosSettings = { NumLatencyProbes = 0, PingSiteInfoByAliasMap = new Dictionary<string, QosPingSiteInfo> { } },
                     ServerVersion = "Custom Blaze 2.11.3.1 Server"
                 });
+        }
 
-            _cachedBytes = response.Serialize();
+        // BSDK tag (8B 39 2B) + ASCII version in the preAuth request; major >= 3 means a heat2 (Blaze 3.x) client.
+        private static readonly byte[] BsdkTag = { 0x8B, 0x39, 0x2B };
+        private static int BsdkMajor(byte[] p)
+        {
+            for (int i = 0; i + 3 < p.Length; i++)
+            {
+                if (p[i] != BsdkTag[0] || p[i + 1] != BsdkTag[1] || p[i + 2] != BsdkTag[2]) continue;
+                int j = i + 3;
+                while (j < p.Length && !(p[j] >= '0' && p[j] <= '9')) j++;
+                int start = j;
+                while (j < p.Length && p[j] >= '0' && p[j] <= '9') j++;
+                if (j > start && int.TryParse(System.Text.Encoding.ASCII.GetString(p, start, j - start), out int m)) return m;
+                return 0;
+            }
+            return 0;
         }
 
         public static async Task HandleRequest(User user, byte[] packetBytes)
         {
-            byte[] response = (byte[])_cachedBytes.Clone();
-            for (int i = 0; i < 2; i++)
-                response[10 + i] = packetBytes[10+i];
+            user.IsHeat2 = BsdkMajor(packetBytes) >= 3;
+            Blaze.Tdf.Heat2Writer.Mode.Value = user.IsHeat2;
+            ServerLogger.Log($"[Blaze] preAuth heat2={user.IsHeat2}");
 
-			await user.Stream.WriteAsync(response);
+            byte[] response;
+            if (user.IsHeat2)
+            {
+                response = BuildMessage(packetBytes).Serialize(); // heat2 via Mode
+            }
+            else
+            {
+                response = (byte[])_cachedBytes.Clone();
+                for (int i = 0; i < 2; i++)
+                    response[10 + i] = packetBytes[10 + i]; // copy the request's message id
+            }
+            await user.Stream.WriteAsync(response);
         }
     }
 }
