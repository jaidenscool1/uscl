diff --git a/Tests/Heat2Test/Program.cs b/Tests/Heat2Test/Program.cs
new file mode 100644
index 0000000..23dacf4
--- /dev/null
+++ b/Tests/Heat2Test/Program.cs
@@ -0,0 +1,108 @@
+// Round-trip self-check for the heat2 request codec: encode a TdfField model with Heat2Writer, frame it like a real
+// Blaze packet, decode it with Heat2Reader, and confirm every field survives. This is the inverse pairing that lets
+// Blaze 3.x clients (Madden 25, NHL 15) have their requests actually read instead of falling back to empty models.
+using Blaze;
+using Blaze.Tdf;
+using Blaze.Tdf.Types;
+
+static class T
+{
+    static int pass, fail;
+    static void Check(bool ok, string name)
+    {
+        Console.WriteLine((ok ? "  PASS " : "  FAIL ") + name);
+        if (ok) pass++; else fail++;
+    }
+
+    // frame fields into a full heat2 packet (12-byte header + body), as the wire carries them
+    static byte[] Frame(List<TdfField> fields)
+    {
+        byte[] body = Heat2Writer.SerializeFields(fields);
+        var pkt = new byte[0x0C + body.Length];
+        pkt[0] = (byte)(body.Length >> 8); pkt[1] = (byte)body.Length;  // u16-BE body length
+        Buffer.BlockCopy(body, 0, pkt, 0x0C, body.Length);
+        return pkt;
+    }
+
+    static int Main()
+    {
+        // --- varint: exact inverse across the byte-length boundaries ---
+        foreach (ulong v in new ulong[] { 0, 1, 0x3F, 0x40, 300, 0x7F, 0x80, 16383, 16384, 1u << 20, uint.MaxValue, ulong.MaxValue })
+        {
+            var o = new List<byte>(); Heat2Writer.VarInt(o, v);
+            int i = 0; ulong got = Heat2Reader.VarInt(o.ToArray(), ref i);
+            Check(got == v && i == o.Count, $"varint {v}");
+        }
+
+        // --- a flat struct of a string + int, exactly fetchClientConfig's shape (CFID) ---
+        {
+            var fields = new List<TdfField> { new("CFID", TdfType.String, "OSDK_CORE") };
+            var back = Heat2Reader.ReadFields(Frame(fields));
+            Check(back.Count == 1 && (string)back[0].Value == "OSDK_CORE" && back[0].Tag == "CFID", "fetchClientConfig CFID string");
+        }
+
+        // --- all reader branches in one message: int, string, blob, nested struct, list, map, union ---
+        {
+            var inner = new TdfStruct();
+            inner.Add("IVAL", TdfType.Int64, 42L);
+            inner.Add("ISTR", TdfType.String, "nested");
+
+            var list = new TdfArray(TdfType.Int64);
+            list.Items.Add(1L); list.Items.Add(2L); list.Items.Add(1000000L);
+
+            var map = new TdfDictionary(TdfType.String, TdfType.Int64);
+            map.Map["a"] = 10L; map.Map["bb"] = 20000L;
+
+            var union = new TdfUnion { SelectedUnionValue = 0x00, Field = new TdfField("VALU", TdfType.String, "u") };
+
+            var fields = new List<TdfField>
+            {
+                new("BINT", TdfType.Int64, 123456L),
+                new("BSTR", TdfType.String, "hello"),
+                new("BLOB", TdfType.Blob, new byte[] { 1, 2, 3, 4, 5 }),
+                new("STRC", TdfType.Struct, inner),
+                new("LIST", TdfType.Array, list),
+                new("AMAP", TdfType.Map, map),
+                new("UNIO", TdfType.Union, union),
+            };
+            var back = Heat2Reader.ReadFields(Frame(fields));
+
+            Check(back.Count == 7, "field count");
+            Check((long)back[0].Value == 123456L, "int");
+            Check((string)back[1].Value == "hello", "string");
+            Check(((byte[])back[2].Value).Length == 5 && ((byte[])back[2].Value)[4] == 5, "blob");
+            var st = (TdfStruct)back[3].Value;
+            Check(st.Fields.Count == 2 && (long)st.Fields[0].Value == 42L && (string)st.Fields[1].Value == "nested", "nested struct");
+            var li = (TdfArray)back[4].Value;
+            Check(li.Items.Count == 3 && (long)li.Items[2] == 1000000L, "list");
+            var mp = (TdfDictionary)back[5].Value;
+            Check(mp.Map.Count == 2 && (long)mp.Map["bb"] == 20000L, "map");
+            var un = (TdfUnion)back[6].Value;
+            Check(un.SelectedUnionValue == 0x00 && (string)un.Field.Value == "u", "union");
+        }
+
+        // --- model binding: the decoded fields map onto a real request struct via reflection, bool from int ---
+        {
+            var fields = new List<TdfField>
+            {
+                new("BVAL", TdfType.Int64, 1L),
+                new("NUM", TdfType.Int64, 7L),
+                new("TXT", TdfType.String, "configname"),
+            };
+            var temp = new TdfStruct();
+            temp.Fields.AddRange(Heat2Reader.ReadFields(Frame(fields)));
+            var m = (Sample)TdfReflection.TdfStructToModel(temp, typeof(Sample));
+            Check(m.Flag && m.Num == 7 && m.Txt == "configname", "reflection model bind (bool/int/string)");
+        }
+
+        Console.WriteLine($"\nheat2 round-trip: {pass} passed, {fail} failed");
+        return fail == 0 ? 0 : 1;
+    }
+
+    class Sample
+    {
+        [Blaze.Tdf.Attributes.TdfMember("BVAL")] public bool Flag;
+        [Blaze.Tdf.Attributes.TdfMember("NUM")] public int Num;
+        [Blaze.Tdf.Attributes.TdfMember("TXT")] public string Txt;
+    }
+}
