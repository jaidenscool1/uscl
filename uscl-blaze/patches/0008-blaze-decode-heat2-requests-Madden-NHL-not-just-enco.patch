From 3e1a2dbbd336b949fc5cced89bc6b75dbc447775 Mon Sep 17 00:00:00 2001
From: HempFiend <17104973+jaidenscool1@users.noreply.github.com>
Date: Sun, 8 Nov 2026 10:31:39 -0700
Subject: [PATCH 08/14] blaze: decode heat2 requests (Madden/NHL), not just
 encode

Blaze 3.x clients send heat2-encoded requests, but only the heat2 writer
existed -- every Madden request fell back to an empty model, so e.g.
fetchClientConfig's CFID always arrived blank (logs: "heat2 request not
parsed ... using default model", CFID= -> 0 fields, x8).

Heat2Reader is the exact structural inverse of Heat2Writer (little-endian
varint, [3-byte tag][1-byte type], struct 0x00 terminator, type codes
0=int/1=string/2=blob/3=struct/4=list/5=map/6=union). CreateModelFromRequest
picks the codec from the connection's heat2 flag; heat1 clients (NBA Jam,
Skate 3) are unchanged.

Tests/Heat2Test: 22 round-trip checks -- varints across every byte-length
boundary, all seven value types, and reflection model binding incl.
bool-from-int. All pass.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 Skate Custom Server/Blaze/Tdf/BlazeMessage.cs |  16 ++-
 Skate Custom Server/Blaze/Tdf/Heat2Reader.cs  | 126 ++++++++++++++++++
 Tests/Heat2Test/Heat2Test.csproj              |  12 ++
 Tests/Heat2Test/Program.cs                    | 108 +++++++++++++++
 4 files changed, 255 insertions(+), 7 deletions(-)
 create mode 100644 Skate Custom Server/Blaze/Tdf/Heat2Reader.cs
 create mode 100644 Tests/Heat2Test/Heat2Test.csproj
 create mode 100644 Tests/Heat2Test/Program.cs

diff --git a/Skate Custom Server/Blaze/Tdf/BlazeMessage.cs b/Skate Custom Server/Blaze/Tdf/BlazeMessage.cs
index 81367c4..1d8b400 100644
--- a/Skate Custom Server/Blaze/Tdf/BlazeMessage.cs	
+++ b/Skate Custom Server/Blaze/Tdf/BlazeMessage.cs	
@@ -440,18 +440,20 @@ namespace Blaze
         {
             try
             {
-                var message = new BlazeMessage(packetBytes);
+                // Blaze 3.x clients (Madden/NHL) send heat2-encoded requests; heat2 connections are flagged on the
+                // dispatch AsyncLocal. Decode with the matching codec so request fields (e.g. fetchClientConfig CFID)
+                // actually arrive. Heat1 clients (NBA Jam/Skate 3) keep the original parser.
                 var temp = new TdfStruct();
-                temp.Fields.AddRange(message.Fields);
+                temp.Fields.AddRange(Blaze.Tdf.Heat2Writer.Mode.Value
+                    ? Blaze.Tdf.Heat2Reader.ReadFields(packetBytes)
+                    : new BlazeMessage(packetBytes).Fields);
                 return (T)TdfReflection.TdfStructToModel(temp, typeof(T));
             }
             catch (Exception e)
             {
-                // USCL: Blaze 3.x clients (Madden/NHL) send heat2-encoded requests the 2.x (heat1) parser can't read.
-                // Rather than throw (which drops the connection and hangs the game mid-handshake), degrade to a default
-                // model so the handler still sends its response; the client tolerates our heat1 responses for the early
-                // handshake commands. Heat1 clients (NBA Jam/Skate 3) parse cleanly and never hit this.
-                Servers.ServerLogger.Log($"[Blaze] heat2 request not parsed as {typeof(T).Name} ({e.GetType().Name}); using default model");
+                // Last-resort: a request we still can't read degrades to a default model rather than throwing (which
+                // would drop the connection and hang the game mid-handshake); the handler then sends an empty response.
+                Servers.ServerLogger.Log($"[Blaze] request not parsed as {typeof(T).Name} ({e.GetType().Name}); using default model");
                 return new T();
             }
         }
diff --git a/Skate Custom Server/Blaze/Tdf/Heat2Reader.cs b/Skate Custom Server/Blaze/Tdf/Heat2Reader.cs
new file mode 100644
index 0000000..045861d
--- /dev/null
+++ b/Skate Custom Server/Blaze/Tdf/Heat2Reader.cs	
@@ -0,0 +1,126 @@
+using System;
+using System.Collections.Generic;
+using System.Text;
+using Blaze.Tdf.Types;
+
+namespace Blaze.Tdf
+{
+    // Inverse of Heat2Writer: decode a Blaze 3.x "heat2" request body into the same TdfField model the heat1
+    // parser (BlazeMessage) produces, so TdfReflection.TdfStructToModel maps it to a request model unchanged.
+    // Before this existed, heat2 clients (Madden 25 = BlazeSDK 13.3, NHL 15) fell back to empty models, so e.g.
+    // fetchClientConfig's CFID always arrived blank. heat2 type codes: 0=int,1=string,2=blob,3=struct,4=list,5=map,6=union.
+    public static class Heat2Reader
+    {
+        // packet is the full framed message: 12-byte header then the heat2 body of length u16-BE at offset 0.
+        public static List<TdfField> ReadFields(byte[] packet)
+        {
+            int bodyLen = (packet[0] << 8) | packet[1];
+            int i = 0x0C, end = Math.Min(0x0C + bodyLen, packet.Length);
+            var fields = new List<TdfField>();
+            while (i < end && packet[i] != 0x00)   // top level has no terminator; a stray 0 just ends the body
+                fields.Add(ReadField(packet, ref i));
+            return fields;
+        }
+
+        static TdfField ReadField(byte[] p, ref int i)
+        {
+            string tag = TdfUtils.DecodeTdfTag(new[] { p[i], p[i + 1], p[i + 2] });
+            i += 3;
+            byte type = p[i++];
+            var (tdfType, value) = ReadValue(p, ref i, type);
+            return new TdfField(tag, tdfType, value);
+        }
+
+        static (TdfType, object) ReadValue(byte[] p, ref int i, byte type) => type switch
+        {
+            Heat2Writer.INT => (TdfType.Int64, (object)(long)VarInt(p, ref i)),
+            Heat2Writer.STRING => (TdfType.String, ReadString(p, ref i)),
+            Heat2Writer.BLOB => (TdfType.Blob, ReadBlob(p, ref i)),
+            Heat2Writer.STRUCT => (TdfType.Struct, ReadStruct(p, ref i)),
+            Heat2Writer.LIST => (TdfType.Array, ReadList(p, ref i)),
+            Heat2Writer.MAP => (TdfType.Map, ReadMap(p, ref i)),
+            Heat2Writer.UNION => (TdfType.Union, ReadUnion(p, ref i)),
+            _ => throw new NotSupportedException($"heat2 type {type}"),
+        };
+
+        // little-endian varint, exact inverse of Heat2Writer.VarInt (first byte carries 6 value bits, rest carry 7)
+        public static ulong VarInt(byte[] p, ref int i)
+        {
+            byte b = p[i++];
+            if ((b & 0x80) == 0) return b;
+            ulong v = (ulong)(b & 0x3F);
+            int shift = 6;
+            do { b = p[i++]; v |= (ulong)(b & 0x7F) << shift; shift += 7; } while ((b & 0x80) != 0);
+            return v;
+        }
+
+        static string ReadString(byte[] p, ref int i)
+        {
+            int len = (int)VarInt(p, ref i);   // length includes the NUL terminator
+            string s = Encoding.Latin1.GetString(p, i, Math.Max(0, len - 1));
+            i += len;
+            return s;
+        }
+
+        static byte[] ReadBlob(byte[] p, ref int i)
+        {
+            int len = (int)VarInt(p, ref i);
+            var b = new byte[len];
+            Buffer.BlockCopy(p, i, b, 0, len);
+            i += len;
+            return b;
+        }
+
+        static TdfStruct ReadStruct(byte[] p, ref int i)
+        {
+            var s = new TdfStruct();
+            while (p[i] != 0x00) s.Fields.Add(ReadField(p, ref i));
+            i++; // struct terminator
+            return s;
+        }
+
+        static TdfArray ReadList(byte[] p, ref int i)
+        {
+            byte elemType = p[i++];
+            int count = (int)VarInt(p, ref i);
+            var a = new TdfArray { ArrayType = Heat2ToTdf(elemType) };
+            for (int n = 0; n < count; n++)
+                a.Items.Add(ReadValue(p, ref i, elemType).Item2);
+            return a;
+        }
+
+        static TdfDictionary ReadMap(byte[] p, ref int i)
+        {
+            byte kt = p[i++], vt = p[i++];
+            int count = (int)VarInt(p, ref i);
+            var d = new TdfDictionary(Heat2ToTdf(kt), Heat2ToTdf(vt)) { Map = new Dictionary<object, object>() };
+            for (int n = 0; n < count; n++)
+            {
+                object k = ReadValue(p, ref i, kt).Item2;
+                object v = ReadValue(p, ref i, vt).Item2;
+                d.Map[k] = v;
+            }
+            return d;
+        }
+
+        static TdfUnion ReadUnion(byte[] p, ref int i)
+        {
+            byte selector = p[i++];
+            var u = new TdfUnion { SelectedUnionValue = selector };
+            if (selector != 0x7F)
+                u.Field = ReadField(p, ref i);   // active member, tagged VALU
+            return u;
+        }
+
+        static TdfType Heat2ToTdf(byte t) => t switch
+        {
+            Heat2Writer.STRING => TdfType.String,
+            Heat2Writer.BLOB => TdfType.Blob,
+            Heat2Writer.STRUCT => TdfType.Struct,
+            Heat2Writer.LIST => TdfType.Array,
+            Heat2Writer.MAP => TdfType.Map,
+            Heat2Writer.UNION => TdfType.Union,
+            _ => TdfType.Int64,
+        };
+    }
+}
