+using System.Collections.Generic;
+
+namespace Blaze.Tdf
+{
+    // Blaze 3.x "heat2" wire encoder, separate from the 2.x "heat1" encoder in TdfUtils/BlazeMessage.
+    // heat2 differs from heat1 in two ways that matter here:
+    //   - a field is [3-byte tag][1-byte type]; the type is a full byte, not the high nibble of a length byte.
+    //   - integers/lengths are a LITTLE-endian varint: first byte = low 6 bits + 0x80 continue, then 7 bits + 0x80.
+    //     (heat1's EncodeVlq is big-endian, so it cannot be reused.)
+    // Type codes (heat2): 0=int, 1=string, 2=blob, 3=struct, 4=list, 5=map, 6=union. A struct ends with 0x00.
+    // Used for Blaze 3.x clients (Madden 25 = BlazeSDK 13.3, NHL 15). See uscl-blaze/ and games/BLUS31178.md.
+    public static class Heat2Writer
+    {
+        public const byte INT = 0x00, STRING = 0x01, STRUCT = 0x03, UNION = 0x06;
+
+        public static void VarInt(List<byte> o, ulong v)
+        {
+            if (v < 0x40) { o.Add((byte)v); return; }
+            o.Add((byte)((v & 0x3F) | 0x80));
+            v >>= 6;
+            while (v >= 0x80) { o.Add((byte)((v & 0x7F) | 0x80)); v >>= 7; }
+            o.Add((byte)v);
+        }
+
+        static void Tag(List<byte> o, string tag) => o.AddRange(TdfUtils.EncodeTdfTag(tag));
+
+        public static void IntField(List<byte> o, string tag, ulong value)
+        {
+            Tag(o, tag); o.Add(INT); VarInt(o, value);
+        }
+
+        // A union whose active member is a struct tagged VALU (the ServerAddress shape: ADDR -> selector -> VALU{..}).
+        public static void BeginUnion(List<byte> o, string tag, byte selector)
+        {
+            Tag(o, tag); o.Add(UNION); o.Add(selector);
+        }
+
+        public static void BeginStruct(List<byte> o, string tag)
+        {
+            Tag(o, tag); o.Add(STRUCT);
+        }
+
+        public static void EndStruct(List<byte> o) => o.Add(0x00);
+    }
+}
