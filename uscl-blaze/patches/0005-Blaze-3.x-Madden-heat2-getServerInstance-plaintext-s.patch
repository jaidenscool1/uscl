+        // Build the getServerInstance response frame with a heat2 body for Blaze 3.x clients.
+        private static byte[] BuildHeat2ServerInstance(byte[] req, uint serverIP, ushort port, bool secure)
+        {
+            var body = new List<byte>(48);
+            Blaze.Tdf.Heat2Writer.BeginUnion(body, "ADDR", 0x00);     // ServerAddress union, case 0 = IpAddress
+            Blaze.Tdf.Heat2Writer.BeginStruct(body, "VALU");
+            Blaze.Tdf.Heat2Writer.IntField(body, "IP", serverIP);
+            Blaze.Tdf.Heat2Writer.IntField(body, "PORT", port);
+            Blaze.Tdf.Heat2Writer.EndStruct(body);                   // close VALU struct
+            Blaze.Tdf.Heat2Writer.IntField(body, "SECU", secure ? 1u : 0u);
+            Blaze.Tdf.Heat2Writer.IntField(body, "XDNS", 0);
 
+            var packet = new List<byte>(0x0C + body.Count);
+            packet.AddRange(TdfUtils.SwapEndianess((ushort)body.Count));
+            packet.AddRange(TdfUtils.SwapEndianess(TdfUtils.GetComponentFromPacket(req)));
+            packet.AddRange(TdfUtils.SwapEndianess(TdfUtils.GetCommandFromPacket(req)));
+            packet.AddRange(TdfUtils.SwapEndianess((ushort)0));      // error
+            packet.Add((byte)BlazeMessageType.Response);
+            packet.Add(0x00);
+            packet.AddRange(TdfUtils.SwapEndianess(TdfUtils.GetMessageIDFromPacket(req)));
+            packet.AddRange(body);
+            return packet.ToArray();
         }
 
