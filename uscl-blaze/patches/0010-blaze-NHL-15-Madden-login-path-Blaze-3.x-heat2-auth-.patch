--- /dev/null
+++ b/Skate Custom Server/Blaze/Components/Authentication/Commands/Blaze3LoginResponse.cs	
@@ -0,0 +1,43 @@
+using Blaze.Tdf.Attributes;
+
+namespace Blaze.Components.Authentication.Commands
+{
+    // Blaze 3.x login response (NHL 15, Madden 25 — BlazeSDK 3.x/heat2). Their SDK needs the 3.x shape, which is
+    // different from the 2.x Ps3LoginResponse NBA Jam/Skate use: a top-level session key (SKEY) + needs-TOS flag
+    // (NTOS), and the SESS group carries 1CON/UID with PDTL.PLAT/STAS. Without these the client treats login as
+    // incomplete and logs straight back out instead of sending postAuth. Field set mirrors a known-good 3.x server
+    // (grid-leak/blaze, Mirror's Edge Catalyst). Numeric "flag" fields are 0.
+    public struct Blaze3LoginResponse
+    {
+        [TdfMember("CNTX")] public uint Context;
+        [TdfMember("ERRC")] public uint ErrorCode;
+        [TdfMember("SKEY")] public string SessionKey;
+        [TdfMember("ANON")] public uint Anonymous;
+        [TdfMember("NTOS")] public uint NeedsTos;
+        [TdfMember("SESS")] public Blaze3SessionInfo Session;
+        [TdfMember("SPAM")] public uint IsSpammable;
+        [TdfMember("UNDR")] public uint IsUnderage;
+    }
+
+    public struct Blaze3SessionInfo
+    {
+        [TdfMember("1CON")] public uint ConnGroupId;
+        [TdfMember("BUID")] public uint BlazeId;
+        [TdfMember("FRST")] public uint IsFirstLogin;
+        [TdfMember("KEY")] public string BlazeToken;
+        [TdfMember("LLOG")] public uint LastLoginTime;
+        [TdfMember("MAIL")] public string Email;
+        [TdfMember("PDTL")] public Blaze3PersonaInfo PersonaDetails;
+        [TdfMember("UID")] public uint UserId;
+    }
+
+    public struct Blaze3PersonaInfo
+    {
+        [TdfMember("DSNM")] public string DisplayName;
+        [TdfMember("LAST")] public uint LastLoginTime;
+        [TdfMember("PID")] public uint PersonaId;
+        [TdfMember("PLAT")] public uint Platform;      // 4 = the generic value the 3.x reference uses
+        [TdfMember("STAS")] public uint Status;
+        [TdfMember("XREF")] public uint ExternalRef;
+    }
+}
