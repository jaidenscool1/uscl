@@ -52,8 +54,13 @@ namespace Blaze.Components.Authentication
 
         private static bool IsTicketValid(Ticket ps3Ticket, byte[] ticketBytes, User user)
         {
+            // USCL: our own RPCN mints these tickets with a short (~20 min) TTL, so a player who idles at the
+            // "connect to EA" menu (or boots well before opening an online mode) arrives with an already-expired
+            // ticket and gets wrongly rejected. Expiry carries no security meaning on a local preservation server,
+            // so we log it and still validate the signature rather than hard-rejecting.
             if (ps3Ticket.ExpiryDate < DateTimeOffset.UtcNow)
-                return false;
+                ServerLogger.Log($"[Blaze] ps3Login: ticket expired {(DateTimeOffset.UtcNow - ps3Ticket.ExpiryDate).TotalMinutes:F0}m ago " +
+                    $"(user {ps3Ticket.Username}) — accepting anyway (local RPCN)");
 
             // RPCN Ticket Verifying
             var verifier = new TicketVerifier(ticketBytes, ps3Ticket, RpcnSigningKey.Instance);
@@ -88,6 +95,10 @@ namespace Blaze.Components.Authentication
 
             Ticket ps3Ticket = Ticket.ReadFromBytes(loginRequest.ps3Ticket);
 
+            // USCL diag: pinpoint heat2 ticket extraction vs signature failure for NHL/Madden (Blaze 3.x)
+            ServerLogger.Log($"[Blaze] ps3Login diag: heat2={user.IsHeat2} ticket={loginRequest.ps3Ticket?.Length ?? -1}B " +
+                $"user={ps3Ticket.Username} issuer={ps3Ticket.IssuerId} expiry={ps3Ticket.ExpiryDate:o} serviceId={ps3Ticket.ServiceId}");
+
             if (UserBanned(ps3Ticket.Username))
                 return;
 
@@ -128,17 +139,35 @@ namespace Blaze.Components.Authentication
 
 			SessionDetails sessionDetails = AuthUtils.CreateNewSessionDetails(ps3Ticket, userData.BlazeId);
 
-            BlazeMessage response = BlazeMessage.CreateResponseFromModel(
-                packetBytes,
-                new Ps3LoginResponse
+            object responseModel = user.IsHeat2
+                ? new Blaze3LoginResponse
+                {
+                    SessionKey = sessionDetails.BlazeToken,
+                    Session = new Blaze3SessionInfo
+                    {
+                        BlazeId = sessionDetails.BlazeId,
+                        BlazeToken = sessionDetails.BlazeToken,
+                        Email = sessionDetails.Email,
+                        UserId = (uint)sessionDetails.UserId,
+                        PersonaDetails = new Blaze3PersonaInfo
+                        {
+                            DisplayName = sessionDetails.PersonaDetails.DisplayName,
+                            PersonaId = (uint)sessionDetails.PersonaDetails.PersonaId,
+                            Platform = 4,
+                            ExternalRef = (uint)sessionDetails.PersonaDetails.ExternalRef
+                        }
+                    }
+                }
+                : new Ps3LoginResponse
                 {
                     IsUnderage = false,
                     IsSpammable = false,
                     SessionDetails = sessionDetails
-                });
+                };
+            BlazeMessage response = BlazeMessage.CreateResponseFromModel(packetBytes, responseModel);
 
             await user.Stream.WriteAsync(response.Serialize());
-            
+
 
             // Store user session details for later use
             user.Session = sessionDetails;
@@ -163,6 +192,18 @@ namespace Blaze.Components.Authentication
 
             user.IsAuthenticated = true;
             ServerGlobals.Users[sessionDetails.BlazeId] = user;
+
+            // Blaze 3.x (NHL/Madden): the SDK's login call doesn't complete until the server pushes the local
+            // user's own session data, so the client waits ~12s then logs out instead of sending postAuth. Push
+            // the session notifications now (heat2 only; heat1/NBA Jam drive these via postAuth instead).
+            if (user.IsHeat2)
+            {
+                await ServerUtils.SendNotificationToUser(user, user.UserIdentification,
+                    BlazeComponent.UserSessions, (ushort)UserSessionNotification.UserAdded);
+                await ServerUtils.SendNotificationToUser(user,
+                    new NotifyExtendedDataUpdated { ExtendedData = user.ExtendedData, BlazeId = user.UserIdentification.BlazeId },
+                    BlazeComponent.UserSessions, (ushort)UserSessionNotification.UserSessionExtendedDataUpdate);
+            }
         }
     }
 }
