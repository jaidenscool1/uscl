+// USCL_HOSTS="name=ip&&*.suffix=ip": names answered without DNS (USCL points game servers such as
+// Demonware at its own on 127.0.0.1), in RPCS3's "IP swap list" format.
+std::optional<u32> HostOverride(const std::string& hostname) {
+    const char* env = std::getenv("USCL_HOSTS");
+    if (env == nullptr) {
+        return std::nullopt;
+    }
+    const std::string list = env;
+    for (size_t pos = 0; pos <= list.size();) {
+        size_t end = list.find("&&", pos);
+        if (end == std::string::npos) {
+            end = list.size();
+        }
+        const std::string entry = list.substr(pos, end - pos);
+        pos = end + 2;
+        const size_t eq = entry.find('=');
+        if (eq == std::string::npos) {
+            continue;
+        }
+        const std::string name = entry.substr(0, eq);
+        const bool match =
+            name.starts_with("*.") ? hostname.ends_with(name.substr(1)) : name == hostname;
+        in_addr ip{};
+        if (match && inet_pton(AF_INET, entry.substr(eq + 1).c_str(), &ip) == 1) {
+            return ip.s_addr;
+        }
+    }
+    return std::nullopt;
+}
