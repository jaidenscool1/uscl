+// C++ function-local static guards (Itanium ABI): the first byte of the guard is set once the object
+// is built. One recursive lock serializes all initializers, like libstdc++'s generic fallback.
+static std::recursive_mutex guard_mutex;
+
+s32 PS4_SYSV_ABI internal___cxa_guard_acquire(u64* guard) {
+    if (*reinterpret_cast<volatile u8*>(guard) != 0) {
+        return 0;
+    }
+    guard_mutex.lock();
+    if (*reinterpret_cast<volatile u8*>(guard) != 0) {
+        guard_mutex.unlock();
+        return 0;
+    }
+    return 1;
+}
+
+void PS4_SYSV_ABI internal___cxa_guard_release(u64* guard) {
+    *reinterpret_cast<volatile u8*>(guard) = 1;
+    guard_mutex.unlock();
+}
+
+void PS4_SYSV_ABI internal___cxa_guard_abort(u64*) {
+    guard_mutex.unlock();
+}
