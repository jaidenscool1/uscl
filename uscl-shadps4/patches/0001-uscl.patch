 }
 
+
+// Heap for modules that import the allocator from libSceLibcInternal (NpToolkit2 sets up its own mspace at
+// startup and gives up on a null one). Each block carries a header with its size and the address malloc gave,
+// so free, realloc and alignment work the same with every host C library. Mspaces share this heap.
+struct HeapHeader {
+    void* raw;
+    size_t size;
+};
+
+static void* HeapAlloc(size_t size, size_t align) {
+    align = std::max<size_t>(align, alignof(std::max_align_t));
+    if ((align & (align - 1)) != 0) {
+        return nullptr;
+    }
+    const size_t extra = sizeof(HeapHeader) + align;
+    if (size > SIZE_MAX - extra) {
+        return nullptr;
+    }
+    void* raw = std::malloc(size + extra);
+    if (!raw) {
+        return nullptr;
+    }
+    const uintptr_t start = reinterpret_cast<uintptr_t>(raw) + sizeof(HeapHeader);
+    const uintptr_t aligned = (start + align - 1) & ~(uintptr_t(align) - 1);
+    auto* header = reinterpret_cast<HeapHeader*>(aligned) - 1;
+    header->raw = raw;
+    header->size = size;
+    return reinterpret_cast<void*>(aligned);
+}
+
+static size_t HeapSize(void* ptr) {
+    return ptr ? (reinterpret_cast<HeapHeader*>(ptr) - 1)->size : 0;
+}
+
+static void HeapFree(void* ptr) {
+    if (ptr) {
+        std::free((reinterpret_cast<HeapHeader*>(ptr) - 1)->raw);
+    }
+}
+
+static void* HeapRealloc(void* ptr, size_t size) {
+    if (!ptr) {
+        return HeapAlloc(size, 0);
+    }
+    if (size == 0) {
+        HeapFree(ptr);
+        return nullptr;
+    }
+    void* moved = HeapAlloc(size, 0);
+    if (moved) {
+        std::memcpy(moved, ptr, std::min(size, HeapSize(ptr)));
+        HeapFree(ptr);
+    }
+    return moved;
+}
+
+static void* HeapCalloc(size_t count, size_t size) {
+    if (size != 0 && count > SIZE_MAX / size) {
+        return nullptr;
+    }
+    void* ptr = HeapAlloc(count * size, 0);
+    if (ptr) {
+        std::memset(ptr, 0, count * size);
+    }
+    return ptr;
+}
+
+void* PS4_SYSV_ABI internal_malloc(size_t size) {
+    return HeapAlloc(size, 0);
+}
+
+void PS4_SYSV_ABI internal_free(void* ptr) {
+    HeapFree(ptr);
+}
+
+void* PS4_SYSV_ABI internal_calloc(size_t count, size_t size) {
+    return HeapCalloc(count, size);
+}
+
+void* PS4_SYSV_ABI internal_realloc(void* ptr, size_t size) {
+    return HeapRealloc(ptr, size);
+}
+
+void* PS4_SYSV_ABI internal_memalign(size_t align, size_t size) {
+    return HeapAlloc(size, align);
+}
+
+s32 PS4_SYSV_ABI internal_posix_memalign(void** out, size_t align, size_t size) {
+    void* ptr = HeapAlloc(size, align);
+    if (!ptr) {
+        return 12; // ENOMEM
+    }
+    *out = ptr;
+    return 0;
+}
+
+size_t PS4_SYSV_ABI internal_malloc_usable_size(void* ptr) {
+    return HeapSize(ptr);
+}
+
+struct Mspace {
+    std::atomic<size_t> in_use{0};
+    std::atomic<size_t> max_in_use{0};
+};
+
+struct MallocManagedSize { // SceLibcMallocManagedSize
+    u16 size;
+    u16 version;
+    u32 reserved;
+    size_t max_system_size;
+    size_t current_system_size;
+    size_t max_inuse_size;
+    size_t current_inuse_size;
+};
+
+static void* MspaceTrack(Mspace* msp, void* ptr) {
+    if (msp && ptr) {
+        const size_t now = msp->in_use += HeapSize(ptr);
+        size_t max = msp->max_in_use;
+        while (now > max && !msp->max_in_use.compare_exchange_weak(max, now)) {
+        }
+    }
+    return ptr;
+}
+
+void* PS4_SYSV_ABI sceLibcMspaceCreate(const char* name, void* base, size_t capacity, u32 flag) {
+    LOG_INFO(Lib_LibcInternal, "name = {}, capacity = {:#x}, flag = {:#x}", name ? name : "", capacity, flag);
+    return new Mspace;
+}
+
+s32 PS4_SYSV_ABI sceLibcMspaceDestroy(Mspace* msp) {
+    delete msp;
+    return 0;
+}
+
+void* PS4_SYSV_ABI sceLibcMspaceMalloc(Mspace* msp, size_t size) {
+    return MspaceTrack(msp, HeapAlloc(size, 0));
+}
+
+void* PS4_SYSV_ABI sceLibcMspaceCalloc(Mspace* msp, size_t count, size_t size) {
+    return MspaceTrack(msp, HeapCalloc(count, size));
+}
+
+void* PS4_SYSV_ABI sceLibcMspaceMemalign(Mspace* msp, size_t align, size_t size) {
+    return MspaceTrack(msp, HeapAlloc(size, align));
+}
+
+s32 PS4_SYSV_ABI sceLibcMspaceFree(Mspace* msp, void* ptr) {
+    if (msp && ptr) {
+        msp->in_use -= HeapSize(ptr);
+    }
+    HeapFree(ptr);
+    return 0;
+}
+
+void* PS4_SYSV_ABI sceLibcMspaceRealloc(Mspace* msp, void* ptr, size_t size) {
+    if (msp && ptr) {
+        msp->in_use -= HeapSize(ptr);
+    }
+    void* moved = HeapRealloc(ptr, size);
+    if (!moved && ptr && size != 0 && msp) {
+        msp->in_use += HeapSize(ptr); // realloc failed, the old block stays
+    }
+    return MspaceTrack(msp, moved);
+}
+
+size_t PS4_SYSV_ABI sceLibcMspaceMallocUsableSize(void* ptr) {
+    return HeapSize(ptr);
+}
+
+s32 PS4_SYSV_ABI sceLibcMspaceMallocStats(Mspace* msp, MallocManagedSize* stats) {
+    if (!msp || !stats) {
+        return -1;
+    }
+    stats->max_system_size = stats->max_inuse_size = msp->max_in_use;
+    stats->current_system_size = stats->current_inuse_size = msp->in_use;
+    return 0;
+}
